{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cianfhoghlaim.ie/schema/tokens.schema.json",
  "title": "Cianfhoghlaim Design Tokens",
  "description": "JSON Schema for the Cianfhoghlaim design token set. Used by the A2UI catalog to validate component props at runtime (R21 + R23). Companion to tokens.css + tokens.ts + baml_src/design_tokens.baml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nations",
    "subjects",
    "competencies",
    "subnations",
    "brand",
    "states",
    "surfaces",
    "buttons",
    "materials",
    "typography",
    "spacing",
    "radius",
    "shadows",
    "motion",
    "z",
    "lineage"
  ],
  "properties": {
    "nations": {
      "type": "object",
      "description": "Celtic nation colours (4 ancient nations)",
      "additionalProperties": false,
      "required": ["irish", "scottish", "welsh", "breton"],
      "properties": {
        "irish":    { "$ref": "#/definitions/HexColor", "description": "Emerald-600 — primary" },
        "scottish": { "$ref": "#/definitions/HexColor", "description": "Blue-600" },
        "welsh":    { "$ref": "#/definitions/HexColor", "description": "Red-600" },
        "breton":   { "$ref": "#/definitions/HexColor", "description": "Purple-600" }
      }
    },
    "subjects": {
      "type": "object",
      "description": "8 NCCA subject realm colours",
      "additionalProperties": false,
      "required": ["mathematics", "applied_mathematics", "chemistry", "geography", "history", "english", "gaeilge", "computer_science"],
      "properties": {
        "mathematics":         { "$ref": "#/definitions/HexColor", "description": "Blue-600" },
        "applied_mathematics": { "$ref": "#/definitions/HexColor", "description": "Violet-600" },
        "chemistry":           { "$ref": "#/definitions/HexColor", "description": "Green-600" },
        "geography":           { "$ref": "#/definitions/HexColor", "description": "Yellow-600" },
        "history":             { "$ref": "#/definitions/HexColor", "description": "Red-700" },
        "english":             { "$ref": "#/definitions/HexColor", "description": "Orange-600" },
        "gaeilge":             { "$ref": "#/definitions/HexColor", "description": "Emerald-600" },
        "computer_science":    { "$ref": "#/definitions/HexColor", "description": "Slate-600" }
      }
    },
    "competencies": {
      "type": "object",
      "description": "5 NCCA Key Competencies (the 5 land-marks)",
      "additionalProperties": false,
      "required": ["communicating", "information", "creative_thinking", "personal_effective", "working_with_others"],
      "properties": {
        "communicating":        { "$ref": "#/definitions/HexColor", "description": "Emerald" },
        "information":          { "$ref": "#/definitions/HexColor", "description": "Blue" },
        "creative_thinking":    { "$ref": "#/definitions/HexColor", "description": "Gold" },
        "personal_effective":   { "$ref": "#/definitions/HexColor", "description": "Warm brown" },
        "working_with_others":  { "$ref": "#/definitions/HexColor", "description": "Red" }
      }
    },
    "subnations": {
      "type": "object",
      "description": "6 British Isles subnation colours (accurate map)",
      "additionalProperties": false,
      "required": ["eire", "northern_ireland", "scotland", "england", "wales", "isle_of_man"],
      "properties": {
        "eire":             { "$ref": "#/definitions/HexColor", "description": "Emerald — Ireland" },
        "northern_ireland": { "$ref": "#/definitions/HexColor", "description": "Blue — NI" },
        "scotland":         { "$ref": "#/definitions/HexColor", "description": "Sky — Scotland" },
        "england":          { "$ref": "#/definitions/HexColor", "description": "Red — St George's Cross" },
        "wales":            { "$ref": "#/definitions/HexColor", "description": "Red-700 — Y Ddraig Goch" },
        "isle_of_man":      { "$ref": "#/definitions/HexColor", "description": "Slate — Triskelion" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary"],
      "properties": {
        "primary":   { "$ref": "#/definitions/HexColor" },
        "secondary": { "$ref": "#/definitions/HexColor" }
      }
    },
    "states": {
      "type": "object",
      "description": "UI states",
      "additionalProperties": false,
      "required": ["success", "warning", "error", "info"],
      "properties": {
        "success": { "$ref": "#/definitions/HexColor" },
        "warning": { "$ref": "#/definitions/HexColor" },
        "error":   { "$ref": "#/definitions/HexColor" },
        "info":    { "$ref": "#/definitions/HexColor" }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "tertiary", "glass"],
      "properties": {
        "primary":   { "$ref": "#/definitions/HexColor" },
        "secondary": { "$ref": "#/definitions/HexColor" },
        "tertiary":  { "$ref": "#/definitions/HexColor" },
        "glass":     { "$ref": "#/definitions/RgbaColor" }
      }
    },
    "buttons": {
      "type": "object",
      "additionalProperties": false,
      "required": ["border_bottom", "border_bottom_active", "shadow", "shadow_active"],
      "properties": {
        "border_bottom":        { "type": "string" },
        "border_bottom_active": { "type": "string" },
        "shadow":               { "type": "string" },
        "shadow_active":        { "type": "string" }
      }
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parchment", "slate", "ink_wash", "gold_leaf", "knotwork"],
      "properties": {
        "parchment": { "type": "string", "format": "uri-reference" },
        "slate":     { "type": "string", "format": "uri-reference" },
        "ink_wash":   { "type": "string", "format": "uri-reference" },
        "gold_leaf": { "type": "string", "format": "uri-reference" },
        "knotwork":  { "type": "string", "format": "uri-reference" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "body", "mono"],
      "properties": {
        "display": { "type": "string" },
        "body":    { "type": "string" },
        "mono":    { "type": "string" }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3", "4", "5", "6", "7", "8"],
      "properties": {
        "1": { "type": "string" },
        "2": { "type": "string" },
        "3": { "type": "string" },
        "4": { "type": "string" },
        "5": { "type": "string" },
        "6": { "type": "string" },
        "7": { "type": "string" },
        "8": { "type": "string" }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm", "md", "lg", "xl", "full"],
      "properties": {
        "sm":   { "type": "string" },
        "md":   { "type": "string" },
        "lg":   { "type": "string" },
        "xl":   { "type": "string" },
        "full": { "type": "string" }
      }
    },
    "shadows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm", "md", "lg", "xl"],
      "properties": {
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "xl": { "type": "string" }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fast", "base", "slow", "standard_ease", "emphasized_ease"],
      "properties": {
        "fast":            { "type": "string" },
        "base":            { "type": "string" },
        "slow":            { "type": "string" },
        "standard_ease":   { "type": "string" },
        "emphasized_ease": { "type": "string" }
      }
    },
    "z": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "dropdown", "sticky", "overlay", "modal", "popover", "toast"],
      "properties": {
        "base":     { "type": "integer" },
        "dropdown": { "type": "integer" },
        "sticky":   { "type": "integer" },
        "overlay":  { "type": "integer" },
        "modal":    { "type": "integer" },
        "popover":  { "type": "integer" },
        "toast":    { "type": "integer" }
      }
    },
    "lineage": {
      "type": "object",
      "description": "Lineage viewer (CocoInsight click-to-highlight) — per R32 of openspec/changes/2026-07-19-leaving-cert-pdf-lineage-and-schema-codegen-v1",
      "additionalProperties": false,
      "required": ["selected", "upstream", "downstream", "dim"],
      "properties": {
        "selected":   { "$ref": "#/definitions/HexColor", "description": "Purple-600 — the clicked element" },
        "upstream":   { "$ref": "#/definitions/HexColor", "description": "Blue-600 — direct upstream dependencies" },
        "downstream": { "$ref": "#/definitions/HexColor", "description": "Green-600 — direct downstream consumers" },
        "dim":        { "type": "number", "minimum": 0, "maximum": 1, "description": "Opacity 0..1 — unrelated fields/nodes render at this opacity" }
      }
    }
  },
  "definitions": {
    "HexColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "A hex color of the form #RRGGBB"
    },
    "RgbaColor": {
      "type": "string",
      "pattern": "^rgba\\(.+\\)$",
      "description": "An rgba() CSS color"
    }
  }
}
