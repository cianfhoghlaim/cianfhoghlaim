{
  "name": "@cianfhoghlaim/cianfhoghlaim-leaving-cert",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && bun run dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check --write .",
    "clean": "turbo clean"
  },
  "dependencies": {
    "convex": "^1.40.0",
    "zod": "^4.0.0",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "turbo": "^2.6.0",
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/bun": "^1.2.6"
  },
  "packageManager": "bun@1.3.0"
}