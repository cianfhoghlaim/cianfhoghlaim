# =============================================================================
# Aleyum Portal Secrets
# =============================================================================
# Copy to .env and fill in actual values
# DO NOT COMMIT THIS FILE WITH REAL VALUES

# PostgreSQL
POSTGRES_USER=aleyum
POSTGRES_PASSWORD=
POSTGRES_DB=aleyum
DATABASE_URL=postgresql://aleyum:${POSTGRES_PASSWORD}@aleyum-db:5432/aleyum

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://aleyum.cianfhoghlaim.ie

# PocketID OIDC
POCKETID_CLIENT_ID=
POCKETID_CLIENT_SECRET=
POCKETID_ISSUER=https://auth.cianfhoghlaim.ie

# Browser Agent (optional)
BROWSER_AGENT_URL=http://browser-agent:8002

# Komodo API (optional - for real stack management)
KOMODO_API_URL=https://komodo.cianfhoghlaim.ie
KOMODO_API_KEY=
KOMODO_API_SECRET=

# Timezone
TZ=Europe/Dublin
