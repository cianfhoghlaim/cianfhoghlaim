{
  "name": "@croilar/web",
  "version": "1.0.0",
  "description": "Cro\u00edl\u00e1r \u2014 personal portfolio + CV + data engineering",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3003",
    "build": "vite build",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "notebook:wasm:music": "mkdir -p public/wasm/music && marimo export wasm ../../notebooks/streams/music/music_analytics.py -o public/wasm/music",
    "notebook:wasm:teaching": "mkdir -p public/wasm/teaching && marimo export wasm ../../notebooks/streams/teaching/teaching_analytics.py -o public/wasm/teaching",
    "notebook:wasm": "bun run notebook:wasm:music && bun run notebook:wasm:teaching"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.58",
    "@cianfhoghlaim/auth": "workspace:*",
    "@cianfhoghlaim/contracts": "workspace:*",
    "@cianfhoghlaim/db": "workspace:*",
    "@cianfhoghlaim/ui-kit": "workspace:*",
    "@copilotkit/react-core": "^1.69.2",
    "@copilotkit/react-ui": "^1.69.2",
    "@copilotkit/runtime": "^1.69.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/ai": "^0.49.1",
    "@tanstack/ai-react": "^0.22.1",
    "@tanstack/db": "^0.8.5",
    "@tanstack/react-db": "^0.3.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.8",
    "@tanstack/react-start": "1.168.21",
    "@tanstack/router-plugin": "^1.132.0",
    "better-auth": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.40.0",
    "i18next": "^25.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
