{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "@convex/*": ["./convex/*"]
    }
  },
  "include": ["app.config.ts", "vite.config.ts", "src/**/*.ts", "src/**/*.tsx", "convex/**/*.ts"],
  "exclude": ["node_modules", ".output", "dist", ".vinxi", ".next", "_merged"]
}
