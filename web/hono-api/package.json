{
  "name": "@cianfhoghlaim/hono-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo ok",
    "test": "echo ok",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@cianfhoghlaim/ui-kit": "workspace:*",
    "@cianfhoghlaim/auth": "workspace:*",
    "@cianfhoghlaim/db": "workspace:*",
    "hono": "^4.8.0",
    "better-auth": "^1.3.11",
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
