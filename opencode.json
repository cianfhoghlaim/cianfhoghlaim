{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browserbase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browserbasehq/mcp"
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "enabled": true
    },
    "motherduck": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-motherduck",
        "--db-path",
        "md:",
        "--read-write"
      ],
      "enabled": true
    }
  }
}