{
  "$schema": "https://opencode.ai/config.json",
  "snapshot": false,
  "subagent_depth": 2,
  "default_agent": "build",
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".venv/**",
      "stedding/**",
      ".cocoindex_code/**",
      ".git/**",
      "dist/**",
      ".turbo/**",
      "**/__pycache__/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "instructions": [
    "AGENTS.md",
    "openspec/AGENTS.md",
    ".agents/skills/INDEXING_AND_COGNITION.md",
    ".cocoindex_code/guides.yml",
    ".agents/skills/openspec/SKILL.md"
  ],
  "provider": {
    "qwen": {
      "name": "Qwen Token Plan (Qwen Cloud / DashScope coding plan — OpenAI-compatible; swap DASHSCOPE_BASE_URL in .env to switch between coding.dashscope.aliyuncs.com/v1 and dashscope-intl.aliyuncs.com/compatible-mode/v1)",
      "api": "openai",
      "options": {
        "apiKey": "{env:DASHSCOPE_API_KEY}",
        "baseURL": "{env:DASHSCOPE_BASE_URL}",
        "timeout": 600000,
        "chunkTimeout": 30000
      },
      "models": {
        "qwen3.7-plus": {
          "id": "qwen3.7-plus",
          "name": "Qwen 3.7 Plus (token plan flagship)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "qwen3-coder-next": {
          "id": "qwen3-coder-next",
          "name": "Qwen 3 Coder Next (token plan coding specialist)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "qwen3-coder-plus": {
          "id": "qwen3-coder-plus",
          "name": "Qwen 3 Coder Plus (token plan coding workhorse)",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 65536
          }
        }
      }
    },
    "litellm_local": {
      "name": "LiteLLM gateway LOCAL fallback (http://localhost:4000) — used when the direct token-plan endpoints are unavailable; the public edge litellm.cianfhoghlaim.ie is NOT referenced until its ACME cert is repaired",
      "api": "openai",
      "options": {
        "apiKey": "{env:LITELLM_MASTER_KEY}",
        "baseURL": "http://localhost:4000/v1",
        "timeout": 600000
      },
      "models": {
        "minimax-m3": {
          "id": "minimax-m3",
          "name": "MiniMax M3 (via local LiteLLM gateway)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 500000
          }
        },
        "local/vision/qwen3-vl-8b": {
          "id": "local/vision/qwen3-vl-8b",
          "name": "Qwen3-VL 8B (local llama-swap via LiteLLM)",
          "attachment": true,
          "reasoning": false,
          "tool_call": false,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "unsloth-studio": {
      "name": "Unsloth Studio (host.docker.internal:8888) — the 2026-08-21 fallback when the M3 token plan quota is exhausted; same UNSLOTH_API_KEY as hermes/openclaw/openchamber. Per the 2026-08-21-unsloth-v5-architecture-refinement-v1 change: Unsloth Studio runs directly on the bunchloch host, not in a Docker container.",
      "api": "openai",
      "options": {
        "apiKey": "{env:UNSLOTH_API_KEY}",
        "baseURL": "http://host.docker.internal:8888/v1/",
        "timeout": 600000
      },
      "models": {
        "unsloth/Qwen3.8-27B-GGUF": {
          "id": "unsloth/Qwen3.8-27B-GGUF",
          "name": "Local Qwen3.8 (Unsloth Studio, coding fallback)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "unsloth/DeepSeek-V4-Pro-0813-GGUF": {
          "id": "unsloth/DeepSeek-V4-Pro-0813-GGUF",
          "name": "Local DeepSeek-V4 Pro (Unsloth Studio, reasoning)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32768
          }
        },
        "unsloth/Kimi-K2.7-Code-GGUF": {
          "id": "unsloth/Kimi-K2.7-Code-GGUF",
          "name": "Local Kimi-K2.7 Code (Unsloth Studio)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "unsloth/Muse-Glimmer-30B-GGUF": {
          "id": "unsloth/Muse-Glimmer-30B-GGUF",
          "name": "Local Muse Glimmer (Unsloth Studio)",
          "attachment": true,
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "dlt-workspace-mcp": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "dlthub",
        "ai",
        "mcp",
        "--stdio"
      ],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "firecrawl-mcp"
      ],
      "environment": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "enabled": true
    },
    "crawl4ai": {
      "type": "remote",
      "url": "https://crawl4ai-mcp.cianfhoghlaim.ie/sse",
      "headers": {
        "Authorization": "Bearer {env:CRAWL4AI_JWT_SECRET}"
      },
      "enabled": true,
      "timeout": 60000
    },
    "infisical": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@infisical/mcp"
      ],
      "environment": {
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "${INFISICAL_CLIENT_ID}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "${INFISICAL_SECRET}",
        "INFISICAL_HOST_URL": "http://localhost:8081",
        "INFISICAL_PROJECT_ID": "${INFISICAL_PROJECT_ID}"
      },
      "enabled": true
    },
    "motherduck": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-motherduck",
        "--db-path",
        ":memory:",
        "--read-write",
        "--allow-switch-databases"
      ],
      "environment": {
        "MOTHERDUCK_TOKEN": "infisical://dev-baile/motherduck/token"
      },
      "enabled": true
    },
    "chrome": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "chrome-devtools-mcp"
      ],
      "enabled": true
    },
    "cocoindex-code": {
      "type": "local",
      "command": [
        "ccc",
        "mcp"
      ],
      "enabled": true
    },
    "cognee": {
      "type": "local",
      "command": [
        "uvx",
        "cognee-mcp"
      ],
      "environment": {
        "COGNEE_API_URL": "http://localhost:8100",
        "COGNEE_API_KEY": "infisical://dev-baile/cognee/api_key",
        "LLM_API_KEY": "${DEEPSEEK_API_KEY}"
      },
      "enabled": true
    },
    "graphiti": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "graphiti_core.mcp"
      ],
      "environment": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "devpassword"
      },
      "enabled": true
    },
    "langfuse": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@langfuse/mcp"
      ],
      "environment": {
        "LANGFUSE_PUBLIC_KEY": "infisical://dev-baile/langfuse/public_key",
        "LANGFUSE_SECRET_KEY": "infisical://dev-baile/langfuse/secret_key",
        "LANGFUSE_HOST": "http://localhost:3000"
      },
      "enabled": true
    },
    "hermes": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "hermes_agent.mcp"
      ],
      "environment": {
        "HERMES_API_URL": "http://hermes:9119",
        "HERMES_API_KEY": "infisical://dev-baile/hermes/api_server_key"
      },
      "enabled": false
    },
    "agent-registry": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "cianfhoghlaim.cocoindex.agent_registry"
      ],
      "environment": {
        "OPENCODE_JSON_PATH": "./opencode.json"
      },
      "enabled": false
    },
    "agents-md": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "cianfhoghlaim.cocoindex.agents_md"
      ],
      "environment": {
        "AGENTS_MD_REPO_ROOT": "./"
      },
      "enabled": false
    },
    "apple-photos": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "-m",
        "cianfhoghlaim.cocoindex.apple_photos_metadata"
      ],
      "environment": {
        "LEABHARLANN_PHOTOS_ROOT": "./leabharlann/photos",
        "LEABHARLANN_PHOTOS_INCLUDE_GPS": "false"
      },
      "enabled": false
    },
    "huggingface": {
      "type": "remote",
      "url": "https://huggingface.co/mcp?login",
      "enabled": true
    },
    "design-system": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "python",
        "web/apps/cianfhoghlaim-leaving-cert/apps/web/packages/mcp/design-system-server.py"
      ],
      "args": [
        "--stdio"
      ],
      "enabled": true
    }
  },
  "agent": {
    "build": {
      "description": "Primary build agent — full read/write/exec, all 65 top-level skills available. Default agent when the user opens a coding task. Uses the M3 direct coding-plan slot (no LiteLLM, no OpenCode Go).",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "primary",
      "color": "primary",
      "prompt": "{file:./.opencode/agents/build.md}"
    },
    "plan": {
      "description": "Primary plan agent — read-only, no edits, no destructive exec. Use for spec/proposal/architectural-design tasks. Switch back to build for implementation.",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "primary",
      "color": "secondary",
      "prompt": "{file:./.opencode/agents/plan.md}"
    },
    "research": {
      "description": "Research primary agent — browser-driven investigation via firecrawl + browserbase + ccc + cognee. Allows webfetch + websearch.",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "primary",
      "prompt": "{file:./.opencode/agents/research.md}"
    },
    "orchestrator": {
      "description": "End-to-end orchestrator for the BIEP + Túatha + Croílár pipeline stack. Hidden (programmatic-only invocation).",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "primary",
      "hidden": true,
      "prompt": "{file:./.opencode/agents/orchestrator.md}"
    },
    "data-platform": {
      "description": "Functional subagent for the data plane (DLT + Dagster + BAML + DuckLake + MotherDuck + CocoIndex + marimo notebooks).",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "subagent",
      "color": "#3a5f3a",
      "prompt": "{file:./.opencode/agents/data-platform.md}"
    },
    "infrastructure": {
      "description": "Functional subagent for the infrastructure mesh (Komodo + Pangolin + Locket + Infisical + Pulumi + Dagger).",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "subagent",
      "color": "#5a5a5a",
      "prompt": "{file:./.opencode/agents/infrastructure.md}"
    },
    "agent-platform": {
      "description": "Functional subagent for the AI/ML services (12 agents + 24 OCR models + 7 Celtic languages + Unsloth + BAML + LiteLLM + Langfuse + MLflow + RAGAS + Graphiti + Cognee).",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "subagent",
      "color": "#1e3a5f",
      "prompt": "{file:./.opencode/agents/agent-platform.md}"
    },
    "frontend-apps": {
      "description": "Functional subagent for the web/agentic app surfaces (TanStack Start + Convex + Hono + CopilotKit + AG-UI + marimo + Babylon.js).",
      "model": "qwen/qwen3-coder-next",
      "mode": "subagent",
      "color": "#5f5f8a",
      "prompt": "{file:./.opencode/agents/frontend-apps.md}"
    },
    "notebooks": {
      "description": "Marimo notebook authoring + debugging for the 109 BIEP lakehouse dashboards.",
      "model": "qwen/qwen3.7-plus",
      "mode": "subagent",
      "color": "#3a5a8f",
      "prompt": "{file:./.opencode/agents/notebooks.md}"
    },
    "baml": {
      "description": "BAML schema authoring for the 320 files under baml_src/. Owns BAML 0.223.0 syntax.",
      "model": "qwen/qwen3-coder-next",
      "mode": "subagent",
      "color": "#5f3a8a",
      "prompt": "{file:./.opencode/agents/baml.md}"
    },
    "dagster": {
      "description": "Dagster asset + component + job authoring for the 5-layer KCG architecture.",
      "model": "qwen/qwen3-coder-next",
      "mode": "subagent",
      "color": "#5a3a5a",
      "prompt": "{file:./.opencode/agents/dagster.md}"
    },
    "mise": {
      "description": "mise.toml task authoring for the canonical 9-namespace task catalogue.",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "subagent",
      "color": "#3a5a3a",
      "prompt": "{file:./.opencode/agents/mise.md}"
    },
    "proposal-author": {
      "description": "OpenSpec change-author subagent for writing proposal.md + tasks.md + spec deltas.",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "subagent",
      "color": "#8a5f3a",
      "prompt": "{file:./.opencode/agents/proposal-author.md}"
    },
    "dev-env-demo": {
      "description": "Dev-environment demo agent — wraps the 8 dev_env tools (ccc_search, ccc_index, drift_detect, firecrawl_refactor_discover, hf_best_model, openspec_list_specs, openspec_validate, mise_lint_skills). READ-ONLY.",
      "model": "minimax-coding-plan/MiniMax-M3",
      "mode": "subagent",
      "hidden": true,
      "color": "#5f8a5f",
      "prompt": "{file:./.opencode/agents/dev-env-demo.md}"
    },
    "deep-cuts": {
      "description": "Structural deep-cuts analyser for any cianfhoghlaim subdirectory. Hidden (programmatic-only).",
      "model": "qwen/qwen3.7-plus",
      "mode": "subagent",
      "hidden": true,
      "color": "#5f8a5f",
      "prompt": "{file:./.opencode/agents/deep-cuts.md}"
    }
  }
}
