{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browserbase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@browserbasehq/mcp"
      ],
      "env": {
        "BROWSERBASE_API_KEY": "bb_live_SjWIy63dVmsAyJj9fzQSwXC1H6c"
      },
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "fc-159a71fbd84140bd9fb80784910a739c"
      },
      "enabled": true
    },
    "motherduck": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-motherduck",
        "--db-path",
        "md:",
        "--read-write"
      ],
      "env": {
        "MOTHERDUCK_TOKEN": "infisical://dev-baile/motherduck/token"
      },
      "enabled": true
    }
  }
}