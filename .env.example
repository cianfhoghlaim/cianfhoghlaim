# 2026-07-13: Minimax-M3 (the user's M3 model via the coding plan API)
# Per the 2026-07-13-baml-final-cleanup-v1 change
# 2026-08-31: Added MINIMAX_API_KEY_V2 per the
# 2026-08-31-cianfhoghlaim-v5-opencode-model-priority-v1 change.
# Build + plan agents use the v2 key; research + agent-platform +
# data-platform + infrastructure + mise + proposal-author +
# dev-env-demo + orchestrator use the existing key.
MINIMAX_BASE_URL=https://api.minimax.com/v1
MINIMAX_API_KEY=sk-your-key-here
MINIMAX_API_KEY_V2=sk-your-v2-key-here

# 2026-08-31: MODEL_PROFILE gates the public_model_roster
# (hackathon | dev | both). Default = dev (BIEP keeps M3 as
# canonical primary). Set MODEL_PROFILE=hackathon to expose the
# Gemma 4 + Gemini 3.5 chains via model_for().
MODEL_PROFILE=dev

# 2026-08-31: Google API surface (Vertex AI Express + AI Studio).
# Per the gemini_hackathon Gemma+Gemini refocus applied to cianfhoghlaim.
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# 2026-08-31: Unsloth Studio (host.docker.internal:8888/v1) —
# the Gemma 4 family host process on bunchloch.
UNSLOTH_BASE_URL=http://host.docker.internal:8888/v1/
UNSLOTH_API_KEY=
UNSLOTH_MODEL=unsloth/gemma-4-26B-A4B-it-GGUF

# University Personal Archive (UoG + transferability)
# Per the 2026-08-23-uog-personal-archive-tertiary-modules-v1 change.
# The same factory runs against any other student's
# `leabharlann/<university>/` corpus — the 9 vars below are the
# 9 env-var fields of `UniversityPersonalArchiveConfig` (the
# Pydantic v2 BaseModel).
# Default values match the UoG case study.
UNIVERSITY_PERSONAL_ARCHIVE_PATH=leabharlann/ollscoil_na_gaillimhe
UNIVERSITY_REGISTRY_URL=https://www.universityofgalway.ie
UNIVERSITY_NAME=University of Galway
UNIVERSITY_INSTITUTION_ID=ie-university-galway
UNIVERSITY_PROGRAMME_CODE_REGEX=[A-Za-z]{2,3}\d{3,4}
UNIVERSITY_TRANSCRIPT_FILE_PATTERNS=*transcript*.pdf
UNIVERSITY_ASSIGNMENT_FILE_PATTERN=*assignment*.pdf
UNIVERSITY_LECTURE_NOTES_DIR_PATTERN=*Lectures*
DUCKLAKE_DESTINATION=local

# ─── Post-cascade follow-ups (2026-08-25-post-cascade-followups) ─────────────

# MotherDuck token (the Wave 4 destination `get_motherduck_destination()`
# raises RuntimeError if this is not set). Per the Wave 4 openspec:
#   "MotherDuck hosts the same DuckLake v1.0 format but in their managed
#    cloud. ... requires `MOTHERDUCK_TOKEN` resolved via the
#    Infisical→.env→op chain."
# Get your token at: https://app.motherduck.com → Settings → Access Tokens
CIANFHOGHLAIM_MOTHERDUCK_TOKEN=

# Convex backend URL (the Wave 6 `web/packages/api-client` + the
# `web/packages/db/convex/schema.ts` real schema use this)
# Run `npx convex dev` to spin up a local Convex backend; copy the URL
# here. In production, use your Cloud Convex deployment URL.
CONVEX_URL=http://localhost:8000

# AG-UI runtime URL (the single hono-api gateway that all 5 web apps
# subscribe to via @cianfhoghlaim/api-client `createCianfhoghlaimAgent()`)
# In dev: `http://localhost:4000`. In prod: `https://api.cianfhoghlaim.ie`.
CIANFHOGHLAIM_RUNTIME_URL=http://localhost:4000

# Wave 7 MLflow tracing (the 4th TracingBackend added in Wave 7)
# Per docs/lakehouse-otel-fanout.md, MLflow v3.15.1 is the canonical
# local-tracing sink.
MLFLOW_TRACKING_URI=sqlite:///stedding/mlflow.db

# ─── Post-cascade follow-ups (2026-08-25-post-cascade-followups) ─────────────

# MotherDuck token (the Wave 4 destination `get_motherduck_destination()`
# raises RuntimeError if this is not set). Per the Wave 4 openspec:
#   "MotherDuck hosts the same DuckLake v1.0 format but in their managed
#    cloud. ... requires `MOTHERDUCK_TOKEN` resolved via the
#    Infisical→.env→op chain."
# Get your token at: https://app.motherduck.com → Settings → Access Tokens
CIANFHOGHLAIM_MOTHERDUCK_TOKEN=

# Convex backend URL (the Wave 6 `web/packages/api-client` + the
# `web/packages/db/convex/schema.ts` real schema use this)
# Run `npx convex dev` to spin up a local Convex backend; copy the URL
# here. In production, use your Cloud Convex deployment URL.
CONVEX_URL=http://localhost:8000

# AG-UI runtime URL (the single hono-api gateway that all 5 web apps
# subscribe to via @cianfhoghlaim/api-client `createCianfhoghlaimAgent()`)
# In dev: `http://localhost:4000`. In prod: `https://api.cianfhoghlaim.ie`.
CIANFHOGHLAIM_RUNTIME_URL=http://localhost:4000

# Wave 7 MLflow tracing (the 4th TracingBackend added in Wave 7)
# Per docs/lakehouse-otel-fanout.md, MLflow v3.15.1 is the canonical
# local-tracing sink.
MLFLOW_TRACKING_URI=sqlite:///stedding/mlflow.db

