# =============================================================================
# LANCEDB - Environment Variables (Vector Storage)
# =============================================================================
# Per the 2026-08-24-lakehouse-stack-doctor-and-env-var-cleanup-v1 change.
# See `.infisical.env.lakehouse` for the lakehouse-specific secrets.
# =============================================================================

# Lance Namespace 0.9 contract API key
LANCEDB_API_KEY=infisical://dev-baile/lancedb/api_key

# Lance Namespace 0.9 contract token (the `header.<name>` context-header prefix
# replaces the pre-v0.9 `x-lance-ctx-<name>` convention)
LANCEDB_NAMESPACE_TOKEN=infisical://dev-baile/lancedb/namespace_token
