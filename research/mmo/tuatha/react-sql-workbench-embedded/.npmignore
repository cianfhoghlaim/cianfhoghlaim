# Source files (not needed in published package)
src/
*.ts
*.tsx
!*.d.ts

# Development and build files
tsconfig.json
tsconfig.build.json
vite.config.ts
vitest.config.ts
eslint.config.js

# Test files
src/**/*.test.ts
src/**/*.test.tsx
src/test/
src/components/__tests__/
*.test.*
*.spec.*

# Demo and development files
src/demo/
index.html
DEMO.md

# Documentation (keep README.md and LICENSE)
CONTRIBUTING.md
USAGE.md

# Development dependencies
node_modules/
package-lock.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage and build artifacts
coverage/
.nyc_output/

# Source maps (optional - remove if you don't want them in the package)
dist/**/*.map

# Legacy JS files (not needed since we have ESM and UMD bundles)
dist/components/*.js
dist/index.js
dist/types.js

# Temporary files
*.tmp
*.temp
