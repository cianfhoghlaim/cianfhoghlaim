  "docker_compose_management": {
    "overview": "Multi-environment Docker Compose configuration with base and override pattern",
    "compose_files": {
      "base": {
        "file": "docker/compose.yml",
        "purpose": "Base configuration for local development",
        "services": [
          "redis (6379) - Session and caching",
          "dgraph-zero (5080, 6080) - DGraph cluster coordinator",
          "dgraph-alpha (8080, 9080) - DGraph database with GraphQL",
          "namespace-service (5001) - Go microservice for namespace management",
          "blockchain (8545) - Anvil local Ethereum node",
          "server (5000) - Python Flask API",
          "ui (3000, 3001) - React frontend with HMR",
          "inference (5001) - GPU ML inference (optional profile)",
          "seed-init, seed-verify, seed-reset - Data seeding services (seed profile)"
        ],
        "networks": {
          "havona-network": {
            "driver": "bridge",
            "subnet": "172.20.0.0/16"
          }
        },
        "volumes": [
          "dgraph_zero_data",
          "dgraph_alpha_data",
          "blockchain_data",
          "redis_data",
          "server_logs",
          "inference_models"
        ],
        "health_checks": {
          "redis": "redis-cli ping",
          "dgraph-zero": "HTTP health endpoint",
          "dgraph-alpha": "GraphQL health with jq validation",
          "namespace-service": "wget health endpoint",
          "blockchain": "Custom health check",
          "ui": "curl localhost:3000"
        }
      },
      "uat_overrides": {
        "file": "docker/compose-UAT.yml",
        "usage": "docker compose -f compose.yml -f compose-UAT.yml up",
        "key_changes": [
          "Production build targets",
          "Resource limits (memory constraints)",
          "UAT environment variables from .env.uat",
          "UI uses production build mode (fixes OOM issues)",
          "Redis memory limits with LRU eviction"
        ]
      },
      "dev_overrides": {
        "file": "docker/compose-DEV.yml",
        "purpose": "Development-specific overrides"
      },
      "prod_overrides": {
        "file": "docker/compose-PROD.yml",
        "purpose": "Production-specific overrides"
      }
    },
    "dockerfiles": {
      "server": {
        "path": "docker/server/Dockerfile",
        "base_image": "python:3.11-slim",
        "stages": ["development", "production"],
        "port": 5000,
        "key_steps": [
          "Install system dependencies",
          "Copy requirements.txt and install Python packages",
          "Copy server code",
          "Set PYTHONPATH=/app",
          "Run python3 server/api/havona.py"
        ]
      },
      "ui": {
        "path": "docker/ui/Dockerfile",
        "base_image": "node:18-alpine",
        "stages": ["development", "production"],
        "development_port": 3000,
        "production_port": 8080,
        "production_server": "serve -s dist -l 8080",
        "build_args": ["BUILD_ENV (uat, prod)"]
      },
      "blockchain": {
        "path": "docker/blockchain/Dockerfile",
        "base_image": "ghcr.io/foundry-rs/foundry:latest",
        "port": 8545,
        "startup_script": "start.sh",
        "purpose": "Run Anvil with contract deployment"
      },
      "namespace_service": {
        "path": "server/services/namespace/Dockerfile",
        "language": "Go",
        "port": 5001,
        "purpose": "DGraph v25 namespace management microservice"
      },
      "agents": {
        "path": "docker/agents/Dockerfile",
        "purpose": "AI agent service container"
      }
    },
    "startup_orchestration": {
      "dependency_order": [
        "1. Infrastructure: redis, dgraph-zero",
        "2. Database: dgraph-alpha (depends on dgraph-zero)",
        "3. Namespace service (depends on dgraph-alpha)",
        "4. Blockchain (independent)",
        "5. Server (depends on redis, dgraph-alpha, namespace-service, blockchain)",
        "6. UI (depends on server)",
        "7. Seed services (depends on server and dgraph-alpha)"
      ],
      "health_check_strategy": "Each service has health checks; dependent services use condition: service_healthy"
    },
    "environment_configuration": {
      "local": {
        "env_file": "server/.env.local",
        "blockchain": "Anvil localhost:8545",
        "dgraph": "localhost:8080",
        "auth0": "havona-dev.us.auth0.com"
      },
      "uat": {
        "env_file": "server/.env.uat",
        "blockchain": "Ten Testnet",
        "dgraph": "hypermode.host/dgraph/graphql",
        "auth0": "UAT tenant configuration"
      },
      "production": {
        "env_file": "server/.env.prod",
        "deployment": "Google Cloud Run"
      }
    },
    "volume_management": {
      "persistence": "Named volumes for all stateful data",
      "volume_list": [
        "dgraph_zero_data - DGraph coordinator state",
        "dgraph_alpha_data - DGraph database storage",
        "blockchain_data - Anvil chain state and contract addresses",
        "redis_data - Redis AOF persistence",
        "server_logs - Application logs",
        "inference_models - ML model cache"
      ]
    },
    "service_profiles": {
      "default": "Core services (redis, dgraph, blockchain, server, ui)",
      "seed": "Data seeding services (seed-init, seed-verify, seed-reset)",
      "inference": "Optional GPU ML inference service"
    }
  },

