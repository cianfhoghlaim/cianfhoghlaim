  "cryptocurrency_blockchain": {
    "overview": "Blockchain used for immutable data persistence with CBOR encoding and EIP-712 signatures",
    "networks": {
      "local": {
        "type": "Anvil",
        "url": "http://localhost:8545",
        "contract_address": "0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512",
        "purpose": "Local development and testing"
      },
      "uat": {
        "type": "Ten Testnet",
        "contract_address": "0xD8010Dbf1254D9cfE81e1b508ebCf78006fBaa79",
        "purpose": "User acceptance testing with TEE privacy"
      },
      "production": {
        "type": "TEN Network",
        "purpose": "Production deployment with Trusted Execution Environment"
      }
    },
    "smart_contracts": {
      "main_contract": {
        "name": "HavonaPersistor",
        "path": "contracts/src/HavonaPersistor.sol",
        "solidity_version": "0.8.20",
        "key_features": [
          "CBOR-encoded data storage",
          "EIP-712 signature verification",
          "Access control per data key",
          "Automatic versioning (max 100 versions per key)",
          "TEN.xyz TEE privacy integration",
          "ReentrancyGuard protection",
          "Batch operations for gas optimization"
        ],
        "storage_mechanism": {
          "encoding": "CBOR (Concise Binary Object Representation)",
          "key_generation": "keccak256 hash of storage identifiers",
          "versioning": "Automatic archival on updates",
          "access_control": "Owner-only writes, granular read permissions"
        },
        "security_features": [
          "EIP712 typed data signing",
          "Nonce-based replay protection",
          "Signature expiry (max 1 hour)",
          "Content hash verification",
          "Owner access control (Ownable pattern)"
        ]
      },
      "supporting_contracts": {
        "HavonaMemberManager": {
          "path": "contracts/src/HavonaMemberManager.sol",
          "purpose": "Member lifecycle and role management"
        },
        "CBOREncoding": {
          "path": "contracts/src/CBOREncoding.sol",
          "purpose": "CBOR encoding utilities"
        },
        "CBORDecoding": {
          "path": "contracts/src/CBORDecoding.sol",
          "purpose": "CBOR decoding with validation"
        },
        "ParentChild": {
          "path": "contracts/src/ParentChild.sol",
          "purpose": "Hierarchical document relationships"
        }
      }
    },
    "blockchain_service": {
      "path": "server/api/services/blockchain.py",
      "web3_library": "web3.py 7.5.0",
      "key_components": [
        "Web3 HTTP Provider connection",
        "Account management with private keys",
        "Contract instance initialization",
        "ABI loading from havona_abi.json",
        "Connection health checks",
        "Balance and block number queries"
      ],
      "initialization_flow": [
        "Connect to RPC endpoint",
        "Load account from private key",
        "Load contract ABI from file",
        "Create contract instance with address and ABI"
      ]
    },
    "blockchain_integration": {
      "write_flow": [
        "Receive JSON payload via API",
        "Detect Pydantic model type",
        "Validate against schema",
        "Encode to CBOR format",
        "Generate storage key (keccak256)",
        "Sign with EIP-712 (if delegated)",
        "Submit transaction to smart contract",
        "Store in DGraph for fast queries"
      ],
      "read_flow": [
        "Query DGraph for fast access",
        "Optionally verify with blockchain",
        "Decode CBOR to JSON",
        "Return to API consumer"
      ]
    },
    "privacy_model": {
      "technology": "TEN Network Trusted Execution Environment",
      "encryption": "TEE-based encryption at rest",
      "access_control": "Smart contract enforces who can decrypt eth_getLogs responses",
      "admin_access": "Havona admin (contract owner) has full access",
      "user_access": "Explicit permission required per data key"
