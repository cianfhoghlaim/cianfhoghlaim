  "pydantic_usage": {
    "version": "2.11.2",
    "purpose": "Type validation, serialization, and schema enforcement",
    "generation_strategy": {
      "approach": "Schema-first code generation",
      "source": "schema/master.graphql (6,116 lines)",
      "generator": "model/generators/generate_all.py",
      "outputs": [
        "Python Pydantic models → server/model/models.py",
        "TypeScript types → ui/src/types/"
      ],
      "workflow": [
        "1. Update schema/master.graphql",
        "2. Run python3 model/generators/generate_all.py",
        "3. Generated models.py contains all Pydantic classes",
        "4. Import models in server code",
        "5. Use for validation and serialization"
      ]
    },
    "generated_models": {
      "location": "server/model/models.py",
      "generation_date": "2025-10-20 23:20:01",
      "structure": [
        "Enums for all GraphQL enums",
        "BaseModel classes for all GraphQL types",
        "Forward references for circular dependencies",
        "Field validators and constraints"
      ],
      "example_enums": [
        "BlockchainSyncStatus",
        "CommodityRiskClassification",
        "RiskFrequency",
        "HedgingPurpose",
        "DerivativeRiskClass"
      ]
    },
    "usage_patterns": {
      "request_validation": {
        "location": "server/api/validation/",
        "pattern": "Validate incoming JSON against Pydantic models before processing"
      },
      "dynamic_type_detection": {
        "path": "server/api/core/dynamic_persistor.py",
        "method": "detect_model_type()",
        "approach": "Introspect Pydantic model fields to match payload structure",
        "flow": [
          "1. Check for explicit 'model_type' or 'type' field",
          "2. Use PydanticModelIntrospector to analyze payload",
          "3. Match payload keys against all available Pydantic models",
          "4. Return best deterministic match based on field overlap"
        ]
      },
      "response_serialization": {
        "pattern": "Use Pydantic .model_dump() for JSON serialization",
        "benefits": "Type-safe, automatic field conversion, null handling"
      },
      "graphql_integration": {
        "pattern": "Pydantic models mirror GraphQL schema types",
        "validation": "Ensure data sent to DGraph matches schema"
      }
    },
    "advanced_features": {
      "field_validators": "Custom validation logic in models.py",
      "field_constraints": "@length directives from GraphQL schema",
      "nested_models": "Support for complex nested structures",
      "forward_references": "Handle circular dependencies in schema",
      "json_schema_generation": "Export JSON schemas for documentation"
    },
    "model_categories": [
      "Trade documents (TradeContract, DigitalTradeTransaction)",
      "Risk management (RiskProfile, RiskExposure, HedgingStrategy)",
      "Commodities (CommodityReference, CommodityPrice)",
      "Members and parties (Member, PrincipleParties)",
      "Field tracking (FieldStatus, FieldHistory)",
      "Blockchain (DLTTransaction, PostTradeDocumentSeal)"
    ],
    "validation_benefits": [
      "Catch type errors before database operations",
      "Prevent invalid data on blockchain",
      "Ensure API contract compliance",
      "Automatic documentation generation",
      "IDE autocomplete and type hints"
    ],
    "integration_with_ai": {
      "pydantic_ai": {
        "library": "pydantic-ai 0.0.16",
        "path": "server/agents/",
        "usage": "Structured LLM outputs with Pydantic validation"
      },
      "rag_applications": {
        "path": "server/rag/",
        "usage": "Validate extracted entities from documents"
      }
    }
  },

  "graphql_dgraph_integration": {
    "overview": "DGraph provides native GraphQL interface with multi-tenant namespace isolation",
    "dgraph_version": "v25.0.0",
    "graphql_libraries": {
      "python": "gql 3.5.0, pydgraph 24.0.2",
      "javascript": "Apollo Client 3.7.17"
    },
    "architecture": {
      "dgraph_cluster": {
        "zero": {
          "purpose": "Cluster coordinator and shard management",
