# ==============================================================================
# CRYPTEOLAS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in the values

# ==============================================================================
# DATABASE (PostgreSQL)
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crypteolas"

# ==============================================================================
# BETTER AUTH
# ==============================================================================
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-secret-key-here"
AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3000"

# App configuration
APP_URL="http://localhost:3000"
APP_DOMAIN="localhost"
EMAIL_DOMAIN="crypto.local"

# Cookie configuration (optional, for production)
# COOKIE_DOMAIN=".yourdomain.com"
# TRUSTED_ORIGINS="https://yourdomain.com,https://app.yourdomain.com"

# GitHub OAuth (optional, for social login)
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# ==============================================================================
# WEB3 / BLOCKCHAIN
# ==============================================================================
# RPC URLs (using public endpoints as fallbacks)
MAINNET_RPC_URL="https://eth.llamarpc.com"
CRONOS_RPC_URL="https://evm.cronos.org"
BASE_RPC_URL="https://mainnet.base.org"

# WalletConnect Project ID (get from cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# ==============================================================================
# X402 PAYMENT PROTOCOL
# ==============================================================================
# Payment recipient wallet address
PAYMENT_RECIPIENT="0xYourWalletAddressHere"
NEXT_PUBLIC_PAYMENT_RECIPIENT="0xYourWalletAddressHere"

# x402 Facilitator URL (use official or self-hosted)
FACILITATOR_URL="https://x402.org/facilitator"

# Default network for payments (cronos, base, polygon)
DEFAULT_PAYMENT_NETWORK="cronos"

# ==============================================================================
# AI / LLM CONFIGURATION
# ==============================================================================
# LiteLLM proxy URL (recommended for multi-provider support)
LITELLM_BASE_URL="http://localhost:4000"
LLM_MODEL="gpt-4o-mini"

# OpenAI API (direct, if not using LiteLLM)
OPENAI_API_KEY=""

# Anthropic API (optional)
# ANTHROPIC_API_KEY=""

# CopilotKit Cloud API Key (optional, for hosted runtime)
# COPILOTKIT_API_KEY=""

# ==============================================================================
# BACKEND SERVICES (AGNO / MCP)
# ==============================================================================
# Agno agent orchestration
AGNO_API_URL="http://localhost:8765"

# Cognee document processing
COGNEE_API_URL="http://localhost:8001"

# Crypto.com MCP Server (free, no auth required)
CRYPTO_COM_MCP_URL="https://mcp.crypto.com/market-data/mcp"

# ==============================================================================
# DATA STORES
# ==============================================================================
# Graph databases
MEMGRAPH_URL="bolt://localhost:7687"
FALKORDB_URL="redis://localhost:6379"

# Vector search
LANCEDB_URL="http://localhost:8080"

# DuckDB (local analytics)
DUCKDB_PATH="./data/crypteolas.duckdb"

# ==============================================================================
# DATA SOURCES (OPTIONAL)
# ==============================================================================
# CoinGecko API (free tier or Pro)
# COINGECKO_API_KEY=""

# DeFiLlama (no key required)
DEFILLAMA_API_URL="https://api.llama.fi"

# Firecrawl (for web scraping)
# FIRECRAWL_API_KEY=""

# ==============================================================================
# EXTERNAL SERVICES (OPTIONAL)
# ==============================================================================
# Redis (for session/cache storage in production)
# REDIS_URL="redis://localhost:6379"

# Sentry (error tracking)
# SENTRY_DSN=""

# ==============================================================================
# DEVELOPMENT
# ==============================================================================
NODE_ENV="development"
LOG_LEVEL="debug"
DEBUG="false"
