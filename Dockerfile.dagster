# =============================================================================
# DAGSTER - Unified Pipeline Server
# =============================================================================
# Runs all sruth pipelines in a single Dagster instance
#
# BUILD: docker build -f Dockerfile.dagster -t cianfhoghlaim-dagster .
# =============================================================================

FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install UV for fast package management
RUN pip install uv

WORKDIR /app

# Copy workspace config
COPY pyproject.toml uv.lock ./
COPY workspace.yaml ./

# Copy pipeline code
COPY sruth/ ./sruth/

# Install dependencies
RUN uv sync --frozen

# Create dagster home
ENV DAGSTER_HOME=/opt/dagster/home
RUN mkdir -p $DAGSTER_HOME

# Copy dagster configuration
COPY dagster.yaml $DAGSTER_HOME/dagster.yaml

# Expose Dagster webserver port
EXPOSE 3000

# Run Dagster webserver with workspace config
CMD ["uv", "run", "dagster", "dev", "-h", "0.0.0.0", "-p", "3000", "-w", "workspace.yaml"]
