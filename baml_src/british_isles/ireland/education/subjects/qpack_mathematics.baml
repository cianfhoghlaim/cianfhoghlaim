// BAML schema: Mathematics Quest Pack Generator (LC + JC)
//
// Builds formative assessment quest packs for NCCA Leaving Certificate
// Mathematics + Junior Cycle Mathematics. Quest packs are keyed to
// NCCA learning outcomes, sourced from the per-subject PDF corpus at
// `cianfhoghlaim/leaving_certificate/mathematics/{en,ga}/`.
//
// Bilingual EN + GA on every user-facing field. Gaeilge-taught content
// (rare for Mathematics — most LC Mathematics syllabi are EN-only) is
// signalled by `text_ga = null`.
//
// Usage:
//   from cianfhoghlaim.baml_client import b
//   pack = b.GenerateMathQuestPack(syllabus, past_papers, marking_schemes, "hl")
//   item = b.GenerateMathFormativeItem("LC-MATHS-LO-2.4", difficulty=3)
//   score = b.ScoreMathFormativeResponse(item, response)
//
// Re-gen after changes:  `cd cianfhoghlaim && uv run baml-cli generate`

// ============================================================================
// Enums
// ============================================================================

enum MathNCCALevel {
  JC @description("Junior Cycle Mathematics (ages 12-15)")
  LC_FL @description("Leaving Certificate Foundation Level Mathematics")
  LC_OL @description("Leaving Certificate Ordinary Level Mathematics")
  LC_HL @description("Leaving Certificate Higher Level Mathematics")
}

enum MathTopicArea {
  ALGEBRA
  FUNCTIONS_AND_CALCULUS
  DIFFERENTIATION
  INTEGRATION
  COORDINATE_GEOMETRY
  TRIGONOMETRY
  COMPLEX_NUMBERS
  SEQUENCES_AND_SERIES
  PROBABILITY
  STATISTICS
  FINANCE
  GEOMETRY
  MECHANICS @description("Briefly touched at LC; the bulk is in Applied Mathematics")
  NUMBER_SYSTEMS
  ARITHMETIC
  SETS_AND_LOGIC
}

enum FormativeItemType {
  SHORT_ANSWER @description("Single-step answer; student types a value")
  WORKED_SOLUTION @description("Multi-step solution with marking-scheme points")
  CONCEPTUAL @description("Explain-why question; graded on understanding")
  VISUAL_INTERPRETATION @description("Read from a graph, table, or diagram")
  WORD_PROBLEM @description("Real-world contextual application")
  PROOF @description("Construct a mathematical proof")
}

enum FeedbackChannel {
  MATH_TUTOR @description("Concrete + worked-example feedback (math_agent)")
  QUEST_GUIDE @description("Graduated hints (4 levels)")
  CURRICULUM_LOOKUP @description("Direct NCCA learning outcome citation")
  RESEARCH_ASSISTANT @description("Cross-topic + cross-subject synthesis")
}

// ============================================================================
// Core value types
// ============================================================================

class MathBilingualText {
  text_en string @description("English text")
  text_ga string? @description("Irish translation; null if the syllabus is EN-only")
}

class MathEvidenceLink {
  source_pdf string @description("Path to the source NCCA syllabus PDF, e.g. 'cianfhoghlaim/leaving_certificate/mathematics/en/SCSEC25_Maths_syllabus_examination-2015_English.pdf'")
  source_page int @description("PDF page where the LO appears (1-indexed)")
  excerpt_en string @description("Verbatim English excerpt from the source")
  excerpt_ga string? @description("Verbatim Irish excerpt (if available)")
  ncca_url string? @description("Canonical curriculumonline.ie URL (if known)")
}

class MathNCCALearningOutcome {
  lo_code string @description("Canonical NCCA code, e.g. 'LC-MATHS-LO-2.4' or 'JC-MATHS-LO-3.1'")
  framework string @description("One of: 'ncca-lc', 'ncca-jc'")
  level MathNCCALevel
  topic MathTopicArea
  competency_text MathBilingualText @description("The full NCCA competency statement, bilingual")
  marking_scheme_excerpt MathBilingualText? @description("Excerpt from the marking scheme guidance, if available")
  evidence MathEvidenceLink
}

// ============================================================================
// Formative items (the atomic unit of formative assessment)
// ============================================================================

class MathFormativeItem {
  id string @description("UUID generated by the BAML function")
  lo_code string @description("The NCCA LO this item tests")
  level MathNCCALevel
  topic MathTopicArea
  item_type FormativeItemType
  difficulty int @description("1-5, mapped to the 4 graduated hint levels")
  prompt MathBilingualText @description("The student-facing prompt")
  expected_answer MathBilingualText @description("The expected answer (or worked solution outline)")
  marking_scheme MathBilingualText @description("Per-step marks allocated, e.g. '2 marks for setup, 1 mark for final'")
  common_errors MathBilingualText[] @description("Common student errors to flag in feedback")
  hints MathBilingualText[] @description("4 graduated hints, indexed 0-3, in level order (Level 1 nudge → Level 4 step-by-step)")
  evidence MathEvidenceLink
  feedback_channel FeedbackChannel @description("Which agent channel delivers the feedback")
  est_time_minutes int @description("Estimated time to complete (1-30 minutes)")
}

class MathFormativeItemAttempt {
  item_id string
  student_response string @description("Verbatim student response (typed or transcribed)")
  response_format string @description("One of: 'text', 'latex', 'image', 'multiple_choice'")
  time_taken_seconds int
  hints_used int @description("0-4; 0 = no hints, 4 = full worked solution")
}

class MathScoreBreakdown {
  item_id string
  lo_code string
  total_marks int
  marks_awarded int @description("0 to total_marks; partial credit allowed")
  marks_per_step int[] @description("Per-step mark breakdown, e.g. [2, 1, 1]")
  is_correct bool @description("True iff marks_awarded == total_marks")
  partial_credit_pct float @description("0-100, marks_awarded / total_marks * 100")
  feedback_en string @description("Concrete feedback in English")
  feedback_ga string? @description("Irish translation; null if EN-only")
  next_recommended_lo string? @description("Suggested next LO to study, based on this attempt")
  badge_earned bool @description("True iff marks_awarded / total_marks >= 0.8")
}

// ============================================================================
// Quest packs (the unit delivered to the student)
// ============================================================================

class MathQuestPack {
  id string @description("UUID generated by the BAML function")
  subject string @description("Always 'mathematics' for this file") @stream.not_null
  framework string @description("One of: 'ncca-lc', 'ncca-jc'")
  level MathNCCALevel
  title MathBilingualText @stream.not_null
  description MathBilingualText @description("Player-facing description of the quest pack")
  total_items int
  total_marks int
  est_time_minutes int
  los_covered string[] @description("List of LO codes covered by this quest pack")
  items MathFormativeItem[] @description("The formative items in this quest pack, ordered by difficulty") @stream.with_state
  prerequisites string[] @description("LO codes the student should have mastered before attempting this pack")
  cross_subject_links string[] @description("Suggested cross-subject LO codes (e.g., LC-APPM, LC-CHEM) for interdisciplinary synthesis")
  generated_at string @description("ISO datetime the pack was generated")
  generated_by string @description("Always 'math_agent' for this file")
}

// ============================================================================
// BAML functions
// ============================================================================

// ============================================================================
// Real generation prompts (2026-08-08 docs-informed-quest-and-credential-
// generation-v1 change). Every function below is grounded in the v3
// extraction types (`SyllabusDocument`, `ExamPaper`, `MarkingScheme` —
// `lc_extraction/{curriculum_syllabus,exam_paper_layout,marking_scheme}.baml`)
// rather than the superseded `_legacy/pdfs/leaving_cert_syllabus.baml`
// types, and rather than an unadorned LO code string. `level: JC` (the
// existing `MathNCCALevel` member) is Junior Cycle — no separate file.

function GenerateMathQuestPack(
  syllabus: SyllabusDocument,
  past_papers: ExamPaper[],
  marking_schemes: MarkingScheme[],
  level: string
) -> MathQuestPack {  client ExtractEn
  prompt #"
    You are building a Mathematics formative-assessment quest pack for NCCA
    students at level {{ level }} ("JC" = Junior Cycle; "LC_FL"/"LC_OL"/"LC_HL"
    = Leaving Cert Foundation/Ordinary/Higher). Ground every item in the
    official syllabus, past exam papers, and marking scheme guidance below —
    do not invent topics, learning outcomes, or questions beyond what these
    documents actually establish.

    Official syllabus:
    {{ syllabus }}

    Past exam papers (for question style + marks allocation reference):
    {{ past_papers }}

    Marking scheme guidance (for grading bands + common-error reference):
    {{ marking_schemes }}

    Build a MathQuestPack:
    - subject: "mathematics"
    - framework: "ncca-lc" if level starts with "LC", "ncca-jc" if level is "JC"
    - level: the MathNCCALevel matching {{ level }}
    - title / description: bilingual; text_ga null only if the syllabus text
      itself is English-only
    - items: one MathFormativeItem per learning outcome actually present in
      syllabus.module_topics[].learning_outcomes — prompt/expected_answer/
      marking_scheme grounded in the real syllabus wording; where a past-paper
      question's related_lo_id matches the outcome, mirror its question style
      and mark allocation; hints escalate from a light nudge (hints[0]) to a
      near-complete worked solution (hints[3]); evidence.source_page and
      evidence.excerpt_en/excerpt_ga copied verbatim from the syllabus text
      that grounds the item, never invented; evidence.source_pdf from
      syllabus.source_pdf
    - los_covered: every lo actually present in the syllabus, not a subset
    - total_items / total_marks / est_time_minutes: sums over the actual items
    - prerequisites: LO codes from earlier syllabus modules the items assume
    - cross_subject_links: only topics the syllabus's cross_curricular field
      or assessment_objectives actually name
    - generated_at: current ISO-8601 datetime
    - generated_by: "math_agent"

    Count and cite carefully from the actual text. Output exactly one complete
    JSON object matching MathQuestPack. Never use ellipses (...) or comments;
    include every item in full, however long the list is.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

function ExtractMathLOStatement(paragraph: string) -> string[] {  client ExtractEn
  prompt #"
    Extract every distinct NCCA Mathematics learning-outcome statement from
    the syllabus paragraph below. A learning outcome is a specific, testable
    statement of what a student should be able to do (e.g. "solve quadratic
    equations by factorising, completing the square, and using the formula").
    Return each as its own string, verbatim from the text — do not merge
    multiple outcomes into one string, and do not paraphrase.

    {{ _.role("user") }}
    Paragraph:
    {{ paragraph }}

    {{ ctx.output_format }}
  "#
}

// -----------------------------------------------------------------------------
// ExtractMathGaStatement (added 2026-07-13-baml-cocoindex-tutorials-ga-v1)
// -----------------------------------------------------------------------------
// The bilingual EN+GA variant of ExtractMathLOStatement. Same
// `string[]` return shape but uses `client Default` (not the
// EN-only `client ExtractEn`) and the prompt asks for the Irish
// (Gaeilge) statement text. Rare for Mathematics syllabi (most are
// EN-only) but the shape is canonical so the GA path runs end-to-end.

function ExtractMathGaStatement(paragraph: string) -> string[] {  client ExtractEn
  prompt #"
    Extract every distinct Irish-language (Gaeilge) NCCA Mathematics
    learning-outcome statement from the syllabus paragraph below. Return each
    as its own string, verbatim from the text. If the paragraph is
    English-only (the common case for LC Mathematics), return an empty list
    rather than translating — this function only returns statements that are
    actually present in Irish in the source text.

    {{ _.role("user") }}
    Paragraph:
    {{ paragraph }}

    {{ ctx.output_format }}
  "#
}

function GenerateMathFormativeItem(
  lo_code: string,
  difficulty: int,
  level: string,
  topic: string,
  evidence: MathEvidenceLink
) -> MathFormativeItem {  client ExtractEn
  prompt #"
    You are writing a single formative-assessment item for NCCA Mathematics
    learning outcome {{ lo_code }} (topic: {{ topic }}, level: {{ level }},
    target difficulty: {{ difficulty }}/5).

    Ground the item entirely in this verbatim evidence from the official
    syllabus — do not write a generic maths question unrelated to it:

    {{ evidence }}

    Build a MathFormativeItem:
    - id: a fresh UUID
    - lo_code: {{ lo_code }}, level: the MathNCCALevel matching {{ level }},
      topic: the MathTopicArea matching {{ topic }}
    - item_type: choose the type that best fits what evidence.excerpt_en/
      excerpt_ga actually describes (e.g. WORKED_SOLUTION for a multi-step
      calculation, CONCEPTUAL for an explain-why outcome)
    - difficulty: {{ difficulty }}
    - prompt / expected_answer / marking_scheme: bilingual, derived from the
      evidence excerpt, not a generic template
    - common_errors: plausible mistakes for this specific outcome
    - hints: exactly 4, escalating from a light nudge to a near-complete
      worked solution
    - evidence: pass the input evidence through unchanged
    - feedback_channel: MATH_TUTOR for calculation items, CURRICULUM_LOOKUP
      for definitional/conceptual items
    - est_time_minutes: realistic for the item's difficulty (1-30)

    Output exactly one complete JSON object matching MathFormativeItem.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

function ScoreMathFormativeResponse(
  item: MathFormativeItem,
  attempt: MathFormativeItemAttempt
) -> MathScoreBreakdown {  client ExtractEn
  prompt #"
    You are marking a student's response to a Mathematics formative item,
    using the item's own marking scheme — do not apply an external standard.

    Item (including its expected_answer and marking_scheme):
    {{ item }}

    Student attempt:
    {{ attempt }}

    Build a MathScoreBreakdown:
    - item_id: {{ item.id }}, lo_code: {{ item.lo_code }}
    - total_marks: derived from item.marking_scheme's stated allocation
    - marks_awarded / marks_per_step: award partial credit per the marking
      scheme's per-step breakdown, not all-or-nothing, unless the marking
      scheme itself is all-or-nothing
    - is_correct: true iff marks_awarded == total_marks
    - partial_credit_pct: marks_awarded / total_marks * 100
    - feedback_en / feedback_ga: specific to what the student actually wrote,
      referencing item.common_errors where applicable
    - next_recommended_lo: a plausible next LO only if the response reveals a
      specific gap; otherwise null
    - badge_earned: true iff partial_credit_pct >= 80

    Output exactly one complete JSON object matching MathScoreBreakdown.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

// ============================================================================
// Helper: validate that all items in a quest pack reference valid LOs
// ============================================================================

function ValidateMathQuestPack(pack: MathQuestPack) -> MathQuestPackValidation {  client ExtractEn
  prompt #"
    Validate the internal consistency of this MathQuestPack — every item's
    lo_code SHOULD appear in los_covered, total_items SHOULD equal
    items.length, total_marks SHOULD equal the sum of each item's marking
    scheme allocation, and no item SHOULD have an empty evidence.excerpt_en
    and evidence.excerpt_ga (a missing source excerpt means the item isn't
    actually grounded in the syllabus).

    Quest pack:
    {{ pack }}

    Build a MathQuestPackValidation: pack_id from the input, is_valid true
    only if no errors were found, errors for any hard inconsistency listed
    above, warnings for anything suspicious but not necessarily wrong (e.g.
    an unusually short excerpt).

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

class MathQuestPackValidation {
  pack_id string
  is_valid bool
  errors string[]
  warnings string[]
}