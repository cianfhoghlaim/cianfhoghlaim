// BAML schema: England Mathematics Quest Pack Generator (GCSE + A-Level)
//
// Pilot England subject for `2026-08-08-docs-informed-quest-and-
// credential-generation-v1` Phase 3 — mirrors the fixed Ireland
// `qpack_mathematics.baml` pattern, grounded in England's own v2/v3
// extraction types (`UKQualificationSpec`, `AQAExamPaper`,
// `AQAMarkingScheme` — `curriculum_syllabus.baml`, `exam_paper_layout.baml`,
// `marking_scheme.baml`) rather than Ireland's `SyllabusDocument`/
// `ExamPaper`/`MarkingScheme`.
//
// English-only — no bilingual EN + GA requirement for England content
// (per the parent openspec change's "England GCSE + A-Level subject
// coverage" requirement).
//
// Scope note: this is a PILOT subject, not full 8/9-subject × 3-board
// parity — see this change's tasks.md Phase 3 for what's covered vs.
// deferred. Also note: only AQA has real (non-placeholder) exam-paper +
// marking-scheme extraction types today (`AQAExamPaper`,
// `AQAMarkingScheme`) — OCR/Edexcel only have the generic
// `UKQualificationSpec` (syllabus-level) extraction; this pilot is
// AQA-grounded for exam-paper/marking-scheme content accordingly.
//
// Re-gen: uv run baml-cli generate

enum EnglandMathLevel {
  GCSE     @description("GCSE Mathematics (ages 14-16)")
  A_LEVEL  @description("A-Level Mathematics (ages 16-18)")
}

enum EnglandMathTopicArea {
  NUMBER
  ALGEBRA
  RATIO_PROPORTION_RATES_OF_CHANGE
  GEOMETRY_AND_MEASURES
  PROBABILITY
  STATISTICS
  PURE_MATHEMATICS      @description("A-Level: functions, calculus, trigonometry")
  MECHANICS             @description("A-Level: kinematics, forces, moments")
  STATISTICS_A_LEVEL    @description("A-Level: hypothesis testing, distributions")
}

enum EnglandMathItemType {
  SHORT_ANSWER
  WORKED_SOLUTION
  MULTIPLE_CHOICE
  PROBLEM_SOLVING
  PROOF
}

enum EnglandMathFeedbackChannel {
  MATH_TUTOR
  QUEST_GUIDE
  CURRICULUM_LOOKUP
  RESEARCH_ASSISTANT
}

class EnglandMathEvidenceLink {
  source_pdf string
  source_page int @description("PDF page (1-indexed); estimated if not explicit in the source text")
  excerpt_en string @description("Verbatim English excerpt from the source")
  specification_code string? @description("e.g. AQA '8300' for GCSE Maths")
}

class EnglandMathFormativeItem {
  id string @description("UUID generated by the BAML function")
  lo_code string @description("Specification reference code, e.g. 'AQA-8300-N1'")
  level EnglandMathLevel
  topic EnglandMathTopicArea
  item_type EnglandMathItemType
  difficulty int @description("1-5")
  prompt_en string
  expected_answer_en string
  marking_scheme_en string
  common_errors string[]
  hints string[] @description("4 graduated hints, indexed 0-3")
  evidence EnglandMathEvidenceLink
  feedback_channel EnglandMathFeedbackChannel
  est_time_minutes int
}

class EnglandMathFormativeItemAttempt {
  item_id string
  student_response string
  response_format string @description("'text', 'latex', or 'image'")
  time_taken_seconds int
  hints_used int
}

class EnglandMathScoreBreakdown {
  item_id string
  lo_code string
  total_marks int
  marks_awarded int
  is_correct bool
  partial_credit_pct float
  feedback_en string
  next_recommended_lo string?
  badge_earned bool @description("True iff partial_credit_pct >= 80")
}

class EnglandMathQuestPack {
  id string @description("UUID generated by the BAML function")
  subject string @description("Always 'mathematics'") @stream.not_null
  board string @description("The awarding body, e.g. 'AQA'")
  level EnglandMathLevel
  title_en string @stream.not_null
  description_en string
  total_items int
  total_marks int
  est_time_minutes int
  los_covered string[]
  items EnglandMathFormativeItem[] @stream.with_state
  prerequisites string[]
  generated_at string @description("ISO datetime the pack was generated")
  generated_by string @description("Always 'math_agent'")
}

class EnglandMathQuestPackValidation {
  pack_id string
  is_valid bool
  errors string[]
  warnings string[]
}

// ============================================================================
// BAML functions
// ============================================================================

function GenerateEnglandMathQuestPack(
  spec: UKQualificationSpec,
  past_papers: AQAExamPaper[],
  marking_schemes: AQAMarkingScheme[],
  level: string
) -> EnglandMathQuestPack {  client BIEPV3Extract
  prompt #"
    You are building a Mathematics formative-assessment quest pack for an
    English student studying towards {{ level }} Mathematics under AQA.
    Ground every item in the official specification, past exam papers,
    and marking-scheme/grade-boundary guidance below — do not invent
    content beyond what these documents actually establish.

    Qualification specification:
    {{ spec }}

    Past exam papers (for question style + marks allocation reference):
    {{ past_papers }}

    Marking scheme / grade boundary guidance:
    {{ marking_schemes }}

    Build an EnglandMathQuestPack:
    - subject: "mathematics"
    - board: "AQA"
    - level: the EnglandMathLevel matching {{ level }}
    - title_en / description_en: derived from spec.title
    - items: one EnglandMathFormativeItem per assessment objective /
      content area actually present in spec.assessment_objectives —
      prompt_en/expected_answer_en/marking_scheme_en grounded in the
      real specification wording; where a past-paper question exists for
      a matching topic, mirror its style and mark allocation; hints
      escalate from a light nudge to a near-complete worked solution;
      evidence.source_page and evidence.excerpt_en copied verbatim from
      the grounding text, never invented; evidence.specification_code
      from spec.specification_code
    - los_covered: every specification reference actually present
    - total_items / total_marks / est_time_minutes: sums over the actual
      items
    - prerequisites: content areas the specification states as
      prerequisite (e.g. GCSE content assumed for A-Level)
    - generated_at: current ISO-8601 datetime
    - generated_by: "math_agent"

    Count and cite carefully from the actual text. Output exactly one
    complete JSON object matching EnglandMathQuestPack. Never use
    ellipses (...) or comments; include every item in full, however long
    the list is.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

function GenerateEnglandMathFormativeItem(
  lo_code: string,
  difficulty: int,
  level: string,
  topic: string,
  evidence: EnglandMathEvidenceLink
) -> EnglandMathFormativeItem {  client BIEPV3Extract
  prompt #"
    You are writing a single formative-assessment item for AQA
    Mathematics specification reference {{ lo_code }} (topic:
    {{ topic }}, level: {{ level }}, target difficulty: {{ difficulty }}/5).

    Ground the item entirely in this verbatim evidence from the official
    specification/exam-paper text — do not write a generic maths
    question unrelated to it:

    {{ evidence }}

    Build an EnglandMathFormativeItem:
    - id: a fresh UUID
    - lo_code: {{ lo_code }}, level: the EnglandMathLevel matching
      {{ level }}, topic: the EnglandMathTopicArea matching {{ topic }}
    - item_type: choose the type that best fits the evidence
    - difficulty: {{ difficulty }}
    - prompt_en / expected_answer_en / marking_scheme_en: derived from
      the evidence excerpt, not a generic template
    - common_errors: plausible mistakes for this specific outcome
    - hints: exactly 4, escalating from a light nudge to a near-complete
      worked solution
    - evidence: pass the input evidence through unchanged
    - feedback_channel: MATH_TUTOR for calculation items,
      CURRICULUM_LOOKUP for definitional items
    - est_time_minutes: realistic for the item's difficulty (1-30)

    Output exactly one complete JSON object matching
    EnglandMathFormativeItem.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

function ScoreEnglandMathFormativeResponse(
  item: EnglandMathFormativeItem,
  attempt: EnglandMathFormativeItemAttempt
) -> EnglandMathScoreBreakdown {  client BIEPV3Extract
  prompt #"
    You are marking a student's response to a Mathematics formative
    item, using the item's own marking scheme.

    Item (including its expected_answer_en and marking_scheme_en):
    {{ item }}

    Student attempt:
    {{ attempt }}

    Build an EnglandMathScoreBreakdown:
    - item_id: {{ item.id }}, lo_code: {{ item.lo_code }}
    - total_marks: derived from item.marking_scheme_en's stated allocation
    - marks_awarded: award partial credit per the marking scheme's
      per-step guidance, not all-or-nothing, unless the scheme itself is
      all-or-nothing
    - is_correct: true iff marks_awarded == total_marks
    - partial_credit_pct: marks_awarded / total_marks * 100
    - feedback_en: specific to what the student actually wrote,
      referencing item.common_errors where applicable
    - next_recommended_lo: a plausible next LO only if the response
      reveals a specific gap; otherwise null
    - badge_earned: true iff partial_credit_pct >= 80

    Output exactly one complete JSON object matching
    EnglandMathScoreBreakdown.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}

function ValidateEnglandMathQuestPack(pack: EnglandMathQuestPack) -> EnglandMathQuestPackValidation {  client BIEPV3Extract
  prompt #"
    Validate the internal consistency of this EnglandMathQuestPack —
    every item's lo_code SHOULD appear in los_covered, total_items
    SHOULD equal items.length, total_marks SHOULD equal the sum of each
    item's marking scheme allocation, and no item SHOULD have an empty
    evidence.excerpt_en.

    Quest pack:
    {{ pack }}

    Build an EnglandMathQuestPackValidation: pack_id from the input,
    is_valid true only if no errors were found, errors for any hard
    inconsistency listed above, warnings for anything suspicious but not
    necessarily wrong.

    {{ _.role("user") }}
    {{ ctx.output_format }}
  "#
}
