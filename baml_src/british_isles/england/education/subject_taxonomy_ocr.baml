// BAML schema: England subject taxonomy (OCR awarding body)
//
// Per the 2026-07-29-biep-v3-england-full-coverage-v1 change.
//
// Parallel to the existing `subject_taxonomy.baml` (AQA). The
// canonical BAML function `ExtractUKQualSpec(board: AwardingBody, ...)`
// from `curriculum_syllabus.baml` is now the single entry point
// for all 3 awarding bodies (AQA + OCR + Edexcel), with the per-board
// subject enum selected via the `board` argument.
//
// Reference: openspec/changes/2026-07-29-biep-v3-england-full-coverage-v1/

enum GCSEOCRSubject {
  MATHEMATICS
  ENGLISH_LANGUAGE
  ENGLISH_LITERATURE
  BIOLOGY
  CHEMISTRY
  PHYSICS
  COMPUTER_SCIENCE
  HISTORY
  GEOGRAPHY
  RELIGIOUS_STUDIES
  FRENCH
  GERMAN
  SPANISH
  LATIN
  CLASSICAL_CIVILISATION
  ANCIENT_HISTORY
  ECONOMICS
  BUSINESS
  PSYCHOLOGY
  SOCIOLOGY
  POLITICS
  LAW
  ART_AND_DESIGN
  DESIGN_TECHNOLOGY
  DRAMA
  MUSIC
  PE
  DANCE
  MEDIA_STUDIES
  FOOD_PREPARATION_NUTRITION
  PERFORMING_ARTS
  APPLIED_BUSINESS
  APPLIED_ICT
  APPLIED_SCIENCE_DOUBLE
  APPLIED_TRAVEL_TOURISM
  FURTHER_MATHEMATICS
  STATISTICS
  ENGINEERING
  ELECTRONICS
  ENVIRONMENTAL_SCIENCE
  HUMAN_BIOLOGY
  OTHER
}

