          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><span class=\"paragraph\">It's important to note that the query itself may not return KVs that did not register any type of request\nduring our time interval.</span>\n<span class=\"paragraph\">The query returns the KV Ids. To make results more readable, we will also perform an API call to obtain the\nname:</span></span>"
          }
        }
