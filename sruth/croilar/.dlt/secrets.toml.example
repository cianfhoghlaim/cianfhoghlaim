# DLT secrets template — copy to .dlt/secrets.toml (gitignored) and fill in.
# DLT loads these at pipeline runtime via dlt.secrets.value.
# See https://dlthub.com/docs/general-usage/credentials

# ----------------------------------------------------------------------------
# Spotify (Client Credentials flow)
# ----------------------------------------------------------------------------
# Required scopes: none (Client Credentials is app-only, no user data)
# Get credentials at https://developer.spotify.com/dashboard
[sources.spotify]
client_id = "your-spotify-client-id"
client_secret = "your-spotify-client-secret"

# ----------------------------------------------------------------------------
# GitHub (personal access token, fine-grained recommended)
# ----------------------------------------------------------------------------
# Token needs: public_repo (read), read:user (read profile)
# Generate at https://github.com/settings/tokens
[sources.github]
access_token = "ghp_your_personal_access_token"
username = "Yedya"

# ----------------------------------------------------------------------------
# SoundCloud (no public API — uses Crawl4AI scraping, no credentials needed)
# ----------------------------------------------------------------------------
# The scraper targets public profiles only.
# [sources.soundcloud]
# username = "aleyummusic"

# ----------------------------------------------------------------------------
# YouTube Data API v3 (optional, used by future track_metadata asset)
# ----------------------------------------------------------------------------
# Get key at https://console.cloud.google.com/apis/credentials
# [sources.youtube]
# api_key = "your-youtube-api-key"

# ----------------------------------------------------------------------------
# Firecrawl (used by labels/scraper.py)
# ----------------------------------------------------------------------------
# Get key at https://firecrawl.dev
[sources.firecrawl]
api_key = "fc-your-firecrawl-api-key"

# ----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible, used for asset storage)
# ----------------------------------------------------------------------------
# Generate at https://dash.cloudflare.com → R2 → Manage R2 API Tokens
[destinations.r2]
endpoint_url = "https://your-account-id.r2.cloudflarestorage.com"
access_key_id = "your-r2-access-key"
secret_access_key = "your-r2-secret-key"

# ----------------------------------------------------------------------------
# DuckDB destination (local analytics DB)
# ----------------------------------------------------------------------------
# Default path: ./data/croilar.duckdb
[destinations.duckdb]
database = "./data/croilar.duckdb"

# ----------------------------------------------------------------------------
# DuckLake destination (S3 + Postgres catalog for multi-writer concurrency)
# ----------------------------------------------------------------------------
# Set USE_DUCKLAKE=false in .env to fall back to plain DuckDB
# Local: Garage S3 + local Postgres
# Prod:  Cloudflare R2 + PlanetScale Postgres
[destinations.ducklake]
data_dir = "s3://ducklake/croilar/"
catalog_uri = "postgresql://lakekeeper:devpassword@localhost:5432/ducklake_croilar"

# ----------------------------------------------------------------------------
# PlanetScale Postgres (BetterAuth + Convex metadata, prod only)
# ----------------------------------------------------------------------------
# Get connection string from https://app.planetscale.com
[destinations.planetscale]
host = "aws-eu-west-2-1.pg.psdb.cloud"
port = "6432"           # pgbouncer port for BetterAuth; use 5432 for Convex
database = "postgres"
username = "pscale_api_your_token"
password = "pscale_pw_your_password"
sslmode = "require"

# ----------------------------------------------------------------------------
# LanceDB (vector store for CocoIndex flows)
# ----------------------------------------------------------------------------
[destinations.lancedb]
uri = "./data/croilar.lance"
