# =============================================================================
# DAGSTER - Unified Pipeline Server (Oideachais)
# =============================================================================
# Build context: oideachais/ (the sub-workspace). This keeps the build
# context small (no stedding/, tuatha/, etc.) and puts the data_platform
# at /app/data_platform as the workspace.yaml expects.
# =============================================================================

FROM python:3.13-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install UV for fast package management
RUN pip install uv

WORKDIR /app

# Create package structure for absolute oideachais imports.
# `oideachais.data_platform...` resolves via the symlink to /app.
RUN mkdir -p /opt/packages && ln -s /app /opt/packages/oideachais

# Copy the oideachais sub-workspace (pyproject.toml, uv.lock, workspace.yaml)
COPY pyproject.toml uv.lock workspace.yaml ./

# Copy the rest of the source
COPY . .

# Install dependencies (the oideachais workspace member is at /app;
# the other workspace members (sruth-browser, codeolas) live in their
# own repos and are referenced via git URLs in pyproject.toml).
RUN uv sync --frozen

# Create dagster home
ENV DAGSTER_HOME=/opt/dagster/home
RUN mkdir -p $DAGSTER_HOME

# Set PYTHONPATH
ENV PYTHONPATH="/opt/packages:/app"

# Expose Dagster webserver port
EXPOSE 3000

# Run Dagster webserver with workspace config
CMD ["uv", "run", "dagster", "dev", "-h", "0.0.0.0", "-p", "3000", "-w", "workspace.yaml"]
