{
  "name": "data-unified",
  "version": "1.0.0",
  "description": "Unified data layer combining DuckDB analytics, Redis caching, and BAML schema generation",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf dist/ && tsc",
    "start": "node dist/index.js",
    "baml:generate": "baml generate",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.206.1",
    "@hono/node-server": "^1.15.0",
    "@hono/zod-validator": "^0.7.0",
    "duckdb": "^1.3.2",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "hono": "^4.8.4",
    "ioredis": "^5.6.1",
    "zod": "^3.25.74"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "prettier": "^3.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
