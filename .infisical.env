# TINYAUTH_SECRET_KEY=disabled-infisical://dev-baile/7t2tjbf5ygy3ukm5g6crmtj5o4/secret_key

# =============================================================================
# ADDITIONAL API KEYS
# =============================================================================
API_TOKEN=infisical://dev-baile/api/token

# =============================================================================
# ENVIRONMENT
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
RUST_LOG=info

# =============================================================================
# OIDEACHAIS-SPECIFIC SECRETS
# =============================================================================
# From sruth/oideachais/secrets.env
OIDEACHAIS_LLM_API_KEY=infisical://dev-baile/oideachais-llm/api_key
OIDEACHAIS_LLM_PROVIDER=infisical://dev-baile/oideachais-llm/provider

# =============================================================================
# TUATH-SPECIFIC CONFIGURATION
# =============================================================================
# Sruth: sruth/tuath
TUATH_HOST=0.0.0.0
TUATH_PORT=3000
TUATH_BASE_URL=http://localhost:3000
TUATH_RUST_LOG=tuath_api=debug,tower_http=debug,x402=debug

# =============================================================================
# CODEOLAS-SPECIFIC CONFIGURATION
# =============================================================================
# Sruth: sruth/códeolas
CODEOLAS_REPO_PATH=str(Path.cwd())
CODEOLAS_LANCEDB_TABLE_PREFIX=codeolas_
CODEOLAS_EMBEDDING_MODEL=BAAI/bge-m3
CODEOLAS_EMBEDDING_DIMENSION=1024
CODEOLAS_HNSW_NUM_PARTITIONS=256
CODEOLAS_HNSW_NUM_SUB_VECTORS=16
CODEOLAS_CHUNK_SIZE=1000
CODEOLAS_CHUNK_OVERLAP=200

# -----------------------------------------------------------------------------
# Pulumi Local Backend
# -----------------------------------------------------------------------------
PULUMI_BACKEND_URL=infisical://dev-baile/pulumi/backend_url
PULUMI_CONFIG_PASSPHRASE=infisical://dev-baile/pulumi/passphrase

# -----------------------------------------------------------------------------
# Ansible Infrastructure
# -----------------------------------------------------------------------------
OCI_ARM1_IP=infisical://dev-baile/oci-infrastructure/arm1_ip
