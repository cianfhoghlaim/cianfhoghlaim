# =============================================================================
# TEAM WORKFLOW — Shared PocketID OIDC Client
# =============================================================================
# One OAuth2 client for all 6 team-workflow stacks (vikunja, n8n, cal-diy,
# paperless-ngx, glance, changedetection). Each stack uses the same client_id
# but a different redirect_uri.
POCKETID_TEAM_WORKFLOW_CLIENT_ID=infisical://dev-baile/pocketid-team-workflow/client_id
POCKETID_TEAM_WORKFLOW_CLIENT_SECRET=infisical://dev-baile/pocketid-team-workflow/client_secret

# =============================================================================
# TEAM WORKFLOW STACKS — DB passwords (PlanetScale "bunchloch" schema users)
# =============================================================================
# Each stack connects to the same PlanetScale DB with its own search_path.
# These passwords are for the schema-specific Postgres users on the
# self-hosted fallback (arm1-oci infisical-db). PlanetScale uses a single
# username/password from dev-baile/planetscale.
VIKUNJA_DB_PASSWORD=infisical://dev-baile/vikunja/db_password
VIKUNJA_JWT_SECRET=infisical://dev-baile/vikunja/jwt_secret
VIKUNJA_ADMIN_PASSWORD=infisical://dev-baile/vikunja/admin_password
N8N_ENCRYPTION_KEY=infisical://dev-baile/n8n/encryption_key
N8N_DB_PASSWORD=infisical://dev-baile/n8n/db_password
N8N_API_KEY=infisical://dev-baile/n8n/api_key
CALCOM_DB_PASSWORD=infisical://dev-baile/calcom/db_password
CALCOM_NEXTAUTH_SECRET=infisical://dev-baile/calcom/nextauth_secret
PAPERLESS_DB_PASSWORD=infisical://dev-baile/paperless/db_password
PAPERLESS_SECRET_KEY=infisical://dev-baile/paperless/secret_key
CHANGEDETECTION_ADMIN_PASSWORD=infisical://dev-baile/changedetection/admin_password

HF_TOKEN=infisical://dev-baile/huggingface/token
HUGGINGFACE_HUB_TOKEN=infisical://dev-baile/huggingface/token
HUGGINGFACE_TOKEN=infisical://dev-baile/huggingface/token
HF_HOME=/Users/cianmacandeisigh/dev/kings_college_galway/stedding/huggingface
HF_HUB_CACHE=/Users/cianmacandeisigh/dev/kings_college_galway/stedding/huggingface/hub
HF_HUB_DOWNLOAD_TIMEOUT=600

# =============================================================================
# LITELLM GATEWAY (infrastructure/stacks/engineering/litellm)
# =============================================================================
# These keys are injected by Locket into the LiteLLM proxy container.
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=infisical://dev-baile/litellm/master_key
LITELLM_SALT_KEY=infisical://dev-baile/litellm/salt_key
# Internal Postgres used by LiteLLM (separate from the oideachais lakehouse DB)
LITELLM_DATABASE_URL=infisical://dev-baile/litellm/database_url
LITELLM_POSTGRES_USER=infisical://dev-baile/litellm/postgres_user
LITELLM_POSTGRES_PASSWORD=infisical://dev-baile/litellm/postgres_password
LITELLM_POSTGRES_DB=infisical://dev-baile/litellm/postgres_db

# =============================================================================
# MLX-OMNI (infrastructure/stacks/engineering/mlx-omni)
# =============================================================================
# Bridges MLX-format models (Granite-Docling-MLX, FIBO-MLX, olmOCR-MLX) to
# an OpenAI-compatible API for Apple Silicon.
MLX_OMNI_API_KEY=infisical://dev-baile/mlx-omni/api_key

# =============================================================================
# INVOKEAI (infrastructure/stacks/engineering/invokeai)
# =============================================================================
# Image generation service for Z-Image-Turbo + SDXL fallbacks.
INVOKEAI_API_KEY=infisical://dev-baile/invokeai/api_key
INVOKEAI_DATABASE_URL=infisical://dev-baile/invokeai/database_url
INVOKEAI_REDIS_PASSWORD=infisical://dev-baile/invokeai/redis_password

# =============================================================================
# DOCLING-SERVE (used by LiteLLM tool calls for document parsing)
# =============================================================================
DOCLING_SERVE_API_KEY=infisical://dev-baile/docling-serve/api_key

# =============================================================================
# GEMINI 3 FLASH PREVIEW (latest preview, opt-in for LiteLLM primary)
# =============================================================================
# Available via Google AI Studio + Vertex AI. Wired through LiteLLM gemini/
# provider. To enable, set USE_GEMINI_3=true in the litellm service env.
GEMINI_3_FLASH_PREVIEW_MODEL=gemini-3.0-flash-preview
USE_GEMINI_3=false

# =============================================================================
# OPENCODE GO (per Go.md subscription)
# =============================================================================
# All OpenCode Go models are also exposed as LiteLLM passthrough routes under
# the opencode-go/* model namespace. See infrastructure/stacks/engineering/
# litellm/config/config.yaml for the full route table.
OPENCODE_GO_BASE_URL=infisical://dev-baile/opencode/zen_go_base_url
OPENCODE_GO_API_KEY=infisical://dev-baile/opencode/go_api

# =============================================================================
# RISINGWAVE (infrastructure/stacks/machine_learning/risingwave) — replaces Kafka
# =============================================================================
# Streaming database that subsumes Kafka's role. Used by meaisínfhoghlaim/
# agents/root_agent.py for agent_queries / agent_responses event streams, and
# for CDC replication of all Postgres instances. See
# docs/data_engineering/risingwave-*.md for the patterns.
RISINGWAVE_HOST=risingwave
RISINGWAVE_PORT=4566
RISINGWAVE_USER=root
RISINGWAVE_DB=dev
RISINGWAVE_ADMIN_USER=admin
RISINGWAVE_ADMIN_PASSWORD=infisical://dev-baile/risingwave/admin_password
RISINGWAVE_ETL_USER=etl
RISINGWAVE_ETL_PASSWORD=infisical://dev-baile/risingwave/etl_password
RISINGWAVE_DASHBOARD_PORT=5691
RISINGWAVE_COMPACTOR_PORT=6660
RISINGWAVE_META_PORT=5690
