DUCKLAKE_POSTGRES_PASSWORD=devpassword

# Catalog configuration
DUCKLAKE_CATALOG_TYPE=postgresql
DUCKLAKE_CATALOG_NAME=ducklake_catalog
DUCKLAKE_SQLITE_PATH=./storage/data/ducklake.ducklake
