# =============================================================================
# CIANFHOGHLAIM - Root Environment Configuration
# =============================================================================
# This file contains ALL environment variables with Infisical references.
#
# USAGE:
#   1. Ensure Infisical is running:
#      export INFISICAL_URL=http://132.145.27.89:8080
#      export INFISICAL_SECRET_FILE=./infisical_secret
#      export LOCKET_MODE=watch
#
#   2. Inject secrets with Locket:
#      locket inject --env-file .env
#
#   3. Or use op CLI directly:
#      infisical run --env-file=.env -- <command>
#
# VAULT: dev-baile
# =============================================================================
# Last Updated: 2026-01-07
# Consolidated from mogadishu/.env with lakehouse-garage credentials
# =============================================================================

# =============================================================================
# OBSERVABILITY - Datadog (APM + LLM Observability)
# =============================================================================
# NOTE: Disabled - no longer using Datadog
# Stack: bonneagar/storage/datadog
# DD_API_KEY=disabled-infisical://dev-baile/datadog-trial/api_key
# DD_APP_KEY=disabled-infisical://dev-baile/datadog-trial/app_key
# DD_SITE=datadoghq.eu
# DD_ENV=development
# DD_SERVICE=oideachais-education
# DD_VERSION=0.1.0
#
# # LLM Observability (for ADK agents with Gemini)
# DD_LLMOBS_ENABLED=true
# DD_LLMOBS_ML_APP=celtic-education-pipeline
# DD_LLMOBS_AGENTLESS_ENABLED=true
#
# # APM Agent connection (when running containerized agent)
# DD_TRACE_AGENT_URL=http://localhost:8126
# DD_LOGS_JSON=true

# =============================================================================
# OBSERVABILITY - Logfire (OpenTelemetry Tracing)
# =============================================================================
# Stack: bonneagar/storage/logfire
# Dashboard: https://logfire.pydantic.dev
LOGFIRE_TOKEN=infisical://dev-baile/pydantic-logfire/write_token
LOGFIRE_PROJECT_NAME=oideachas-celtic-education
LOGFIRE_SERVICE_NAME=education-pipeline
LOGFIRE_ENVIRONMENT=development
LOGFIRE_LOG_LEVEL=INFO

# =============================================================================
# OBSERVABILITY - MLflow (Experiment Tracking)
# =============================================================================
# Stack: bonneagar/storage/mlflow (shared with Langfuse)
# Local: http://localhost:5000
# Production: http://mlflow.cianfhoghlaim.ie
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=oideachais-celtic-education

# =============================================================================
# OBSERVABILITY - Langfuse (LLM Tracing + Cost Tracking)
# =============================================================================
# Stack: bonneagar/storage/langfuse
# Local: http://localhost:3000
# Production: http://langfuse.cianfhoghlaim.ie
LANGFUSE_HOST=https://langfuse.cianfhoghlaim.ie
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key

# =============================================================================
# LLM PROVIDERS - Google / Gemini (ADK Agents)
# =============================================================================
# Used by: sruth/oideachais, sruth/crypteolas, bonneagar/storage/browser
GOOGLE_CLOUD_PROJECT=520539692103
GOOGLE_API_KEY=infisical://dev-baile/gemini/api_key
VERTEX_AI_ENABLED=true

# Gemini models for agents
ADK_MODEL=gemini-2.0-flash
ADK_ADVANCED_MODEL=gemini-2.5-pro

# For Ragas evaluation (LiteLLM format)
LITELLM_MODEL=gemini/gemini-1.5-flash

# =============================================================================
# LLM PROVIDERS - OpenAI
# =============================================================================
