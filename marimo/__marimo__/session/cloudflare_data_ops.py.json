            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"5-duckdb-ducklake-integration\">5. DuckDB + DuckLake Integration</h2>\n<span class=\"paragraph\">DuckLake provides a lightweight lakehouse format that works seamlessly with DuckDB and R2.</span></span>"
          }
