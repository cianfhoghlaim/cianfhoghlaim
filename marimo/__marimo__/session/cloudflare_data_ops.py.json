          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"6-graphql-analytics-query\">6. GraphQL Analytics Query</h2>\n<span class=\"paragraph\">Cloudflare's GraphQL API provides detailed analytics for KV, R2, and Workers.</span></span>"
          }
        }
      ],
