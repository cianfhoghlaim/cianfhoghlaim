    {
      "id": "xXTn",
      "code_hash": "4acb76abb08de9dbec33d91f5fb7579a",
      "outputs": [
        {
          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"key-patterns-demonstrated\">Key Patterns Demonstrated</h2>\n<h3 id=\"r2-storage-s3-compatible\">R2 Storage (S3-Compatible)</h3>\n<div class=\"language-python codehilite\"><pre><span></span><code><span class=\"c1\"># List buckets via REST API</span>\n<span class=\"n\">GET</span> <span class=\"o\">/</span><span class=\"n\">client</span><span class=\"o\">/</span><span class=\"n\">v4</span><span class=\"o\">/</span><span class=\"n\">accounts</span><span class=\"o\">/</span><span class=\"p\">{</span><span class=\"n\">account_id</span><span class=\"p\">}</span><span class=\"o\">/</span><span class=\"n\">r2</span><span class=\"o\">/</span><span class=\"n\">buckets</span>\n\n<span class=\"c1\"># Download objects requires AWS SigV4 signing</span>\n<span class=\"n\">headers</span> <span class=\"o\">=</span> <span class=\"n\">create_aws_sigv4_headers</span><span class=\"p\">(</span>\n    <span class=\"n\">method</span><span class=\"o\">=</span><span class=\"s1\">&#39;GET&#39;</span><span class=\"p\">,</span>\n    <span class=\"n\">host</span><span class=\"o\">=</span><span class=\"sa\">f</span><span class=\"s1\">&#39;</span><span class=\"si\">{</span><span class=\"n\">bucket</span><span class=\"si\">}</span><span class=\"s1\">.</span><span class=\"si\">{</span><span class=\"n\">account_id</span><span class=\"si\">}</span><span class=\"s1\">.r2.cloudflarestorage.com&#39;</span><span class=\"p\">,</span>\n    <span class=\"n\">path</span><span class=\"o\">=</span><span class=\"sa\">f</span><span class=\"s1\">&#39;/</span><span class=\"si\">{</span><span class=\"n\">object_key</span><span class=\"si\">}</span><span class=\"s1\">&#39;</span><span class=\"p\">,</span>\n    <span class=\"n\">access_key</span><span class=\"o\">=</span><span class=\"n\">R2_ACCESS_KEY</span><span class=\"p\">,</span>\n    <span class=\"n\">secret_key</span><span class=\"o\">=</span><span class=\"n\">R2_SECRET_KEY</span>\n<span class=\"p\">)</span>\n</code></pre></div>\n<h3 id=\"d1-database\">D1 Database</h3>\n<div class=\"language-python codehilite\"><pre><span></span><code><span class=\"c1\"># Execute SQL via API</span>\n<span class=\"n\">POST</span> <span class=\"o\">/</span><span class=\"n\">client</span><span class=\"o\">/</span><span class=\"n\">v4</span><span class=\"o\">/</span><span class=\"n\">accounts</span><span class=\"o\">/</span><span class=\"p\">{</span><span class=\"n\">account_id</span><span class=\"p\">}</span><span class=\"o\">/</span><span class=\"n\">d1</span><span class=\"o\">/</span><span class=\"n\">database</span><span class=\"o\">/</span><span class=\"p\">{</span><span class=\"n\">db_id</span><span class=\"p\">}</span><span class=\"o\">/</span><span class=\"n\">query</span>\n<span class=\"p\">{</span><span class=\"s2\">&quot;sql&quot;</span><span class=\"p\">:</span> <span class=\"s2\">&quot;SELECT * FROM table LIMIT 10&quot;</span><span class=\"p\">}</span>\n</code></pre></div>\n<h3 id=\"pyiceberg-r2\">PyIceberg + R2</h3>\n<div class=\"language-python codehilite\"><pre><span></span><code><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">pyiceberg.catalog.rest</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">RestCatalog</span>\n\n<span class=\"n\">catalog</span> <span class=\"o\">=</span> <span class=\"n\">RestCatalog</span><span class=\"p\">(</span>\n    <span class=\"n\">name</span><span class=\"o\">=</span><span class=\"s2\">&quot;r2_catalog&quot;</span><span class=\"p\">,</span>\n    <span class=\"n\">warehouse</span><span class=\"o\">=</span><span class=\"n\">R2_WAREHOUSE</span><span class=\"p\">,</span>\n    <span class=\"n\">uri</span><span class=\"o\">=</span><span class=\"n\">R2_CATALOG_URI</span><span class=\"p\">,</span>\n    <span class=\"n\">token</span><span class=\"o\">=</span><span class=\"n\">R2_TOKEN</span><span class=\"p\">,</span>\n<span class=\"p\">)</span>\n\n<span class=\"c1\"># Create table</span>\n<span class=\"n\">catalog</span><span class=\"o\">.</span><span class=\"n\">create_table</span><span class=\"p\">(</span><span class=\"s2\">&quot;namespace.table&quot;</span><span class=\"p\">,</span> <span class=\"n\">schema</span><span class=\"o\">=</span><span class=\"n\">schema</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Query with time travel</span>\n<span class=\"n\">table</span> <span class=\"o\">=</span> <span class=\"n\">catalog</span><span class=\"o\">.</span><span class=\"n\">load_table</span><span class=\"p\">(</span><span class=\"s2\">&quot;namespace.table&quot;</span><span class=\"p\">)</span>\n<span class=\"n\">df</span> <span class=\"o\">=</span> <span class=\"n\">table</span><span class=\"o\">.</span><span class=\"n\">to_polars</span><span class=\"p\">()</span><span class=\"o\">.</span><span class=\"n\">filter</span><span class=\"p\">(</span><span class=\"n\">pl</span><span class=\"o\">.</span><span class=\"n\">col</span><span class=\"p\">(</span><span class=\"s2\">&quot;date&quot;</span><span class=\"p\">)</span> <span class=\"o\">==</span> <span class=\"s2\">&quot;2024-01-01&quot;</span><span class=\"p\">)</span>\n</code></pre></div>\n<h3 id=\"ducklake\">DuckLake</h3>\n<div class=\"language-sql codehilite\"><pre><span></span><code><span class=\"n\">INSTALL</span><span class=\"w\"> </span><span class=\"n\">ducklake</span><span class=\"w\"> </span><span class=\"k\">FROM</span><span class=\"w\"> </span><span class=\"n\">core_nightly</span><span class=\"p\">;</span>\n<span class=\"k\">LOAD</span><span class=\"w\"> </span><span class=\"n\">ducklake</span><span class=\"p\">;</span>\n<span class=\"n\">ATTACH</span><span class=\"w\"> </span><span class=\"s1\">&#39;ducklake:metadata.ducklake&#39;</span><span class=\"w\"> </span><span class=\"k\">AS</span><span class=\"w\"> </span><span class=\"n\">myducklake</span><span class=\"p\">;</span>\n</code></pre></div></span>"
          }
        }
      ],
      "console": []
    },
