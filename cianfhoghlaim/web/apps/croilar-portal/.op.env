# Aleyum Portal - 1Password references
# Usage: op run --env-file=.op.env -- bun dev

# PocketID OIDC (from pocketid-tinyauth)
POCKETID_CLIENT_ID=op://dev-baile/pocketid-tinyauth/client_id
POCKETID_CLIENT_SECRET=op://dev-baile/pocketid-tinyauth/client_secret
POCKETID_ISSUER=https://auth.cianfhoghlaim.ie

# Komodo API (from komodo item)
KOMODO_API_KEY=op://dev-baile/komodo/api-key
KOMODO_API_SECRET=op://dev-baile/komodo/api-secret
KOMODO_API_URL=https://komodo.cianfhoghlaim.ie

# Auth configuration
AUTH_BASE_URL=http://localhost:3001
AUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback/oidc
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=op://dev-baile/7bwkwrkx3nzu3vrfbnj234k37q/better_auth_secret

# Database (PostgreSQL)
# Using local Docker postgres for dev, or shared postgres
DATABASE_URL=op://dev-baile/7bwkwrkx3nzu3vrfbnj234k37q/database_url

# Backend APIs (production endpoints)
TUATH_API_URL=https://tuath.cianfhoghlaim.ie
CRYPTEOLAS_API_URL=https://crypteolas.cianfhoghlaim.ie
BROWSER_AGENT_URL=https://browser.cianfhoghlaim.ie
