# =============================================================================
# Oideachais — Google ADK Agents (separate compose service)
# =============================================================================
# Production Dockerfile for the ADK multi-agent orchestrator.
#
# The 12 ADK agent files in oideachais/agents/adk/ import
# `google.adk.agents`, `google.adk.planners`, `google.adk.tools`,
# `google.adk.events`, etc. Running them in a separate container
# isolates the heavy LLM calls from the FastAPI request path and
# provides independent scaling.
#
# BUILD:
#   docker build -t oideachais-dev-adk-agents -f oideachais/Dockerfile.adk .
#
# RUN:
#   docker run -p 7778:7778 -e LLM_API_KEY=... oideachais-dev-adk-agents
# =============================================================================

FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Copy dependency files
COPY pyproject.toml uv.lock* ./

# Install dependencies + google-adk
RUN uv pip install --system --no-cache google-adk || \
    uv pip install --system --no-cache google-adk fastapi uvicorn httpx PyJWT

# =============================================================================
# Production Image
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY . .

# Create storage directory
RUN mkdir -p /app/storage

# Environment
ENV PYTHONPATH=/app:/app/sruth
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 7778

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD curl -f http://localhost:7778/health || exit 1

# Run the ADK agent server
CMD ["uvicorn", "oideachais.agents.adk.root_agent:app", "--host", "0.0.0.0", "--port", "7778"]
