# Tuath API Configuration
# Copy this to .env and fill in your values

# Server Configuration
HOST=0.0.0.0
PORT=3000

# API Base URL (for x402 resource URLs)
BASE_URL=http://localhost:3000

# x402 Facilitator URL
# Production: https://facilitator.x402.rs
# Local: http://localhost:4021
FACILITATOR_URL=https://facilitator.x402.rs

# Payment Addresses (required)
# Your EVM address to receive USDC payments on Base/Polygon
EVM_PAY_TO=0xYourAddressHere

# Optional: Solana address for Solana payments
# SOLANA_PAY_TO=YourSolanaAddressHere

# Logging Level
RUST_LOG=tuath_api=debug,tower_http=debug,x402=debug
