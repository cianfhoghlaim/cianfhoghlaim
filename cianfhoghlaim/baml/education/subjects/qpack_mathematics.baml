// BAML schema: Mathematics Quest Pack Generator (LC + JC)
//
// Builds formative assessment quest packs for NCCA Leaving Certificate
// Mathematics + Junior Cycle Mathematics. Quest packs are keyed to
// NCCA learning outcomes, sourced from the per-subject PDF corpus at
// `cianfhoghlaim/leaving_certificate/mathematics/{en,ga}/`.
//
// Bilingual EN + GA on every user-facing field. Gaeilge-taught content
// (rare for Mathematics — most LC Mathematics syllabi are EN-only) is
// signalled by `text_ga = null`.
//
// Usage:
//   from cianfhoghlaim.baml_client import b
//   pack = b.GenerateMathQuestPack(syllabus, past_papers, marking_schemes, "hl")
//   item = b.GenerateMathFormativeItem("LC-MATHS-LO-2.4", difficulty=3)
//   score = b.ScoreMathFormativeResponse(item, response)
//
// Re-gen after changes:  `cd cianfhoghlaim && uv run baml-cli generate`

// ============================================================================
// Enums
// ============================================================================

enum MathNCCALevel {
  JC @description("Junior Cycle Mathematics (ages 12-15)")
  LC_FL @description("Leaving Certificate Foundation Level Mathematics")
  LC_OL @description("Leaving Certificate Ordinary Level Mathematics")
  LC_HL @description("Leaving Certificate Higher Level Mathematics")
}

enum MathTopicArea {
  ALGEBRA
  FUNCTIONS_AND_CALCULUS
  DIFFERENTIATION
  INTEGRATION
  COORDINATE_GEOMETRY
  TRIGONOMETRY
  COMPLEX_NUMBERS
  SEQUENCES_AND_SERIES
  PROBABILITY
  STATISTICS
  FINANCE
  GEOMETRY
  MECHANICS @description("Briefly touched at LC; the bulk is in Applied Mathematics")
  NUMBER_SYSTEMS
  ARITHMETIC
  SETS_AND_LOGIC
}

enum FormativeItemType {
  SHORT_ANSWER @description("Single-step answer; student types a value")
  WORKED_SOLUTION @description("Multi-step solution with marking-scheme points")
  CONCEPTUAL @description("Explain-why question; graded on understanding")
  VISUAL_INTERPRETATION @description("Read from a graph, table, or diagram")
  WORD_PROBLEM @description("Real-world contextual application")
  PROOF @description("Construct a mathematical proof")
}

enum FeedbackChannel {
  MATH_TUTOR @description("Concrete + worked-example feedback (math_agent)")
  QUEST_GUIDE @description("Graduated hints (4 levels)")
  CURRICULUM_LOOKUP @description("Direct NCCA learning outcome citation")
  RESEARCH_ASSISTANT @description("Cross-topic + cross-subject synthesis")
}

// ============================================================================
// Core value types
// ============================================================================

class MathBilingualText {
  text_en: string @description("English text")
  text_ga: string? @description("Irish translation; null if the syllabus is EN-only")
}

class MathEvidenceLink {
  source_pdf: string @description("Path to the source NCCA syllabus PDF, e.g. 'cianfhoghlaim/leaving_certificate/mathematics/en/SCSEC25_Maths_syllabus_examination-2015_English.pdf'")
  source_page: int @description("PDF page where the LO appears (1-indexed)")
  excerpt_en: string @description("Verbatim English excerpt from the source")
  excerpt_ga: string? @description("Verbatim Irish excerpt (if available)")
  ncca_url: string? @description("Canonical curriculumonline.ie URL (if known)")
}

class MathNCCALearningOutcome {
  lo_code: string @description("Canonical NCCA code, e.g. 'LC-MATHS-LO-2.4' or 'JC-MATHS-LO-3.1'")
  framework: string @description("One of: 'ncca-lc', 'ncca-jc'")
  level: MathNCCALevel
  topic: MathTopicArea
  competency_text: MathBilingualText @description("The full NCCA competency statement, bilingual")
  marking_scheme_excerpt: MathBilingualText? @description("Excerpt from the marking scheme guidance, if available")
  evidence: MathEvidenceLink
}

// ============================================================================
// Formative items (the atomic unit of formative assessment)
// ============================================================================

class MathFormativeItem {
  id: string @description("UUID generated by the BAML function")
  lo_code: string @description("The NCCA LO this item tests")
  level: MathNCCALevel
  topic: MathTopicArea
  item_type: FormativeItemType
  difficulty: int @description("1-5, mapped to the 4 graduated hint levels")
  prompt: MathBilingualText @description("The student-facing prompt")
  expected_answer: MathBilingualText @description("The expected answer (or worked solution outline)")
  marking_scheme: MathBilingualText @description("Per-step marks allocated, e.g. '2 marks for setup, 1 mark for final'")
  common_errors: MathBilingualText[] @description("Common student errors to flag in feedback")
  hints: MathBilingualText[] @description("4 graduated hints, indexed 0-3, in level order (Level 1 nudge → Level 4 step-by-step)")
  evidence: MathEvidenceLink
  feedback_channel: FeedbackChannel @description("Which agent channel delivers the feedback")
  est_time_minutes: int @description("Estimated time to complete (1-30 minutes)")
}

class MathFormativeItemAttempt {
  item_id: string
  student_response: string @description("Verbatim student response (typed or transcribed)")
  response_format: string @description("One of: 'text', 'latex', 'image', 'multiple_choice'")
  time_taken_seconds: int
  hints_used: int @description("0-4; 0 = no hints, 4 = full worked solution")
}

class MathScoreBreakdown {
  item_id: string
  lo_code: string
  total_marks: int
  marks_awarded: int @description("0 to total_marks; partial credit allowed")
  marks_per_step: int[] @description("Per-step mark breakdown, e.g. [2, 1, 1]")
  is_correct: bool @description("True iff marks_awarded == total_marks")
  partial_credit_pct: float @description("0-100, marks_awarded / total_marks * 100")
  feedback_en: string @description("Concrete feedback in English")
  feedback_ga: string? @description("Irish translation; null if EN-only")
  next_recommended_lo: string? @description("Suggested next LO to study, based on this attempt")
  badge_earned: bool @description("True iff marks_awarded / total_marks >= 0.8")
}

// ============================================================================
// Quest packs (the unit delivered to the student)
// ============================================================================

class MathQuestPack {
  id: string @description("UUID generated by the BAML function")
  subject: string @description("Always 'mathematics' for this file") @stream.not_null
  framework: string @description("One of: 'ncca-lc', 'ncca-jc'")
  level: MathNCCALevel
  title: MathBilingualText @stream.not_null
  description: MathBilingualText @description("Player-facing description of the quest pack")
  total_items: int
  total_marks: int
  est_time_minutes: int
  los_covered: string[] @description("List of LO codes covered by this quest pack")
  items: MathFormativeItem[] @description("The formative items in this quest pack, ordered by difficulty") @stream.with_state
  prerequisites: string[] @description("LO codes the student should have mastered before attempting this pack")
  cross_subject_links: string[] @description("Suggested cross-subject LO codes (e.g., LC-APPM, LC-CHEM) for interdisciplinary synthesis")
  generated_at: string @description("ISO datetime the pack was generated")
  generated_by: string @description("Always 'math_agent' for this file")
}

// ============================================================================
// BAML functions
// ============================================================================

function GenerateMathQuestPack(
  syllabus: LeavingCertSyllabus,
  past_papers: LeavingCertPastPaper[],
  marking_schemes: LeavingCertMarkingScheme[],
  level: string
) -> MathQuestPack {
  client ExtractEnStrong
  prompt #"
    You are an Irish Leaving Certificate Mathematics expert.
    Build a formative assessment quest pack for NCCA Mathematics at the
    {{ level }} level.

    The quest pack should:
    - Cover ALL learning outcomes in the syllabus that are appropriate
      for the {{ level }} level (Foundation, Ordinary, or Higher).
    - Contain ≥1 MathFormativeItem per learning outcome.
    - Bilingual EN + GA on every user-facing text field (text_ga may be
      null for EN-only LOs).
    - Reference the source NCCA PDF page in each item's evidence.
    - Be ordered by difficulty (1 → 5).
    - Suggest cross-subject links to Applied Mathematics (APPM) and
      Chemistry where the topic naturally bridges.

    Syllabus: {{ syllabus }}
    Past papers: {{ past_papers }}
    Marking schemes: {{ marking_schemes }}

    {{ ctx.output_format }}
  "#
}

function ExtractMathLOStatement(paragraph: string) -> string[] {
  client ExtractEn
  prompt #"
    Extract all Mathematics learning outcome statements from the
    following NCCA syllabus paragraph. Return them as a list of full
    statements (verbatim from the source, with the LO code if present).

    Paragraph:
    {{ paragraph }}

    {{ ctx.output_format }}
  "#
}

function GenerateMathFormativeItem(
  lo_code: string,
  difficulty: int,
  level: string,
  topic: string
) -> MathFormativeItem {
  client ExtractEnStrong
  prompt #"
    Generate a single formative assessment item for the NCCA Leaving
    Certificate (or Junior Cycle) Mathematics learning outcome
    {{ lo_code }}.

    Difficulty: {{ difficulty }} (1 = easiest, 5 = hardest)
    Level: {{ level }} (JC / LC_FL / LC_OL / LC_HL)
    Topic: {{ topic }}

    The item must:
    - Be appropriate for the stated difficulty + level
    - Reference a specific NCCA PDF page in the evidence.source_page
    - Have 4 graduated hints (Level 1 nudge → Level 4 step-by-step)
    - List ≥2 common student errors in common_errors
    - Be bilingual EN + GA (text_ga may be null for EN-only LOs)
    - Have an est_time_minutes between 1 and 30

    Use the math_agent feedback channel by default.

    {{ ctx.output_format }}
  "#
}

function ScoreMathFormativeResponse(
  item: MathFormativeItem,
  attempt: MathFormativeItemAttempt
) -> MathScoreBreakdown {
  client ExtractEnStrong
  prompt #"
    Score the following student attempt at the formative item.

    Item:
    - LO: {{ item.lo_code }}
    - Level: {{ item.level }}
    - Difficulty: {{ item.difficulty }}
    - Expected answer: {{ item.expected_answer }}
    - Marking scheme: {{ item.marking_scheme }}

    Student attempt:
    - Response: {{ attempt.student_response }}
    - Format: {{ attempt.response_format }}
    - Time taken: {{ attempt.time_taken_seconds }} seconds
    - Hints used: {{ attempt.hints_used }} of 4

    Compute:
    - Total marks (from the marking scheme)
    - Marks awarded (per-step breakdown)
    - is_correct
    - partial_credit_pct
    - feedback_en + feedback_ga (bilingual)
    - next_recommended_lo (suggest the next LO based on this attempt)
    - badge_earned (true iff partial_credit_pct >= 80)

    Be encouraging in the feedback. Use Irish-language feedback when
    the student wrote in Irish or when the item is Gaeilge-taught.

    {{ ctx.output_format }}
  "#
}

// ============================================================================
// Helper: validate that all items in a quest pack reference valid LOs
// ============================================================================

function ValidateMathQuestPack(pack: MathQuestPack) -> MathQuestPackValidation {
  client ExtractEn
  prompt #"
    Validate the following Mathematics quest pack.

    Check that:
    - All items reference LO codes that match the pack's level
    - The total_marks equals the sum of item.marks_per_step
    - Each item's evidence.source_pdf exists in the corpus
    - Each item's difficulty is within [1, 5]
    - Each item's est_time_minutes is within [1, 30]

    Pack: {{ pack }}

    Return the validation result.

    {{ ctx.output_format }}
  "#
}

class MathQuestPackValidation {
  pack_id: string
  is_valid: bool
  errors: string[]
  warnings: string[]
}