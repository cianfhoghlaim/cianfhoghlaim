# Environment Configuration for LakeKeeper Integration
#
# Copy this file to .env and configure for your environment
# Location: sruth/crypteolas/.env
#
# Usage:
#   cp .env.lakekeeper.example .env
#   # Edit .env with your configuration
#   source .env  # or use dotenv in your code

# =============================================================================
# LakeKeeper Configuration
# =============================================================================

# LakeKeeper server URL (required)
# Local development: http://localhost:8181
# Production: https://lakekeeper.example.com
LAKEKEEPER_URL=http://localhost:8181

# Warehouse name (required)
# Each sruth typically has its own warehouse
LAKEKEEPER_WAREHOUSE=crypteolas

# Default namespace (required)
# Common namespaces: embeddings, staging, experiments
LAKEKEEPER_NAMESPACE=embeddings

# Optional: API key for authentication
# Leave empty if authentication is disabled
LAKEKEEPER_API_KEY=

# =============================================================================
# PostgreSQL Backend Configuration (Production)
# =============================================================================
# Only needed if using PostgreSQL backend instead of SQLite

# PostgreSQL host
PLANETSCALE_HOST=localhost

# PostgreSQL port
PLANETSCALE_PORT=5432

# Database name
PLANETSCALE_DATABASE=lakekeeper

# PostgreSQL username
PLANETSCALE_USERNAME=postgres

# PostgreSQL password
PLANETSCALE_PASSWORD=postgres

# =============================================================================
# LanceDB Configuration
# =============================================================================
# LanceDB storage location
LANCEDB_URI=storage/lance

# =============================================================================
# DuckDB Configuration
# =============================================================================
# DuckDB database path
DUCKDB_PATH=storage/duckdb/crypteolas.duckdb

# =============================================================================
# Other Configuration
# =============================================================================

# Dagster home directory
DAGSTER_HOME=/tmp/dagster_home

# Log level
LOG_LEVEL=INFO
