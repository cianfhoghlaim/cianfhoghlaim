# =============================================================================
# Mailcow-dockerized — Local dev placeholder env vars
# =============================================================================
# COMMITTED: yes. PLAINTEXT: yes (placeholders only).
# For production, Locket resolves secrets via Infisical.
# =============================================================================

# Hostname
MAILCOW_HOSTNAME=mail.cianfhoghlaim.ie
MAILCOW_TZ=Europe/Dublin

# Skips — we trust upstream scanners; Rspamd + rspamd-learn handle
# spam classification. Olefy / ClamAV are heavy and only matter for
# Windows-Office attachment scanning, which the leabharlann pipeline
# does not ingest.
SKIP_OLEFY=y
SKIP_CLAMD=y

# HTTP redirect off — Pangolin terminates TLS at the edge, no need
# to also redirect inside the stack.
HTTP_REDIRECT=n

# ACME / Let's Encrypt contact
ACME_CONTACT=admin@cianfhoghlaim.ie

# Docker bridge subnet for the mailcow-network
IPV4_NETWORK=172.22.1
