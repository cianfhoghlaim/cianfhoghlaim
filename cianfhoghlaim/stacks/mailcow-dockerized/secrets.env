# =============================================================================
# MAILCOW-DOCKERIZED - Infisical URI references (NO plaintext)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
# =============================================================================

# =============================================================================
# Database (MySQL / MariaDB) — 4 base mailcow refs
# =============================================================================
DBNAME=infisical://dev-baile/mailcow/dbname
DBUSER=infisical://dev-baile/mailcow/dbuser
DBPASS=infisical://dev-baile/mailcow/dbpass
DBROOT=infisical://dev-baile/mailcow/db_root

# =============================================================================
# Redis
# =============================================================================
REDISPASS=infisical://dev-baile/mailcow/redispass
REDISMASTERPASS=infisical://dev-baile/mailcow/redismasterpass

# =============================================================================
# Mailcow Hostname & Identity
# =============================================================================
MAILCOW_HOSTNAME=infisical://dev-baile/mailcow/hostname

# =============================================================================
# API Keys
# =============================================================================
API_KEY=infisical://dev-baile/mailcow/api_key
API_KEY_READ_ONLY=infisical://dev-baile/mailcow/api_key_read_only
API_ALLOW_FROM=infisical://dev-baile/mailcow/api_allow_from

# =============================================================================
# ACME / Let's Encrypt
# =============================================================================
ACME_CONTACT=infisical://dev-baile/mailcow/admin_pass

# =============================================================================
# Dovecot Master Credentials
# =============================================================================
DOVECOT_MASTER_USER=infisical://dev-baile/mailcow/dovecot_master_user
DOVECOT_MASTER_PASS=infisical://dev-baile/mailcow/dovecot_master_pass

# =============================================================================
# Spamhaus DQS Key
# =============================================================================
SPAMHAUS_DQS_KEY=infisical://dev-baile/mailcow/spamhaus_dqs_key

# =============================================================================
# IMAP Credentials — 4 external accounts (dovecot_imapsync_runner)
# =============================================================================
# Each account's user/app_password resolves at container start.
# The Mailcow imapsync_runner reads ${IMAP_USER_<ACCOUNT>} +
# ${IMAP_PASS_<ACCOUNT>} from data/conf/dovecot/imapsync_runner.conf
# (see Step 1.7). Setup guide: docs/email-inbox/account_credentials_setup.md
# -----------------------------------------------------------------------------
IMAP_USER_DKIT_IE=infisical://dev-baile/mailcow/imap_credentials/dkit_ie_user
IMAP_PASS_DKIT_IE=infisical://dev-baile/mailcow/imap_credentials/dkit_ie_app_password
IMAP_USER_GMAIL_PERSONAL=infisical://dev-baile/mailcow/imap_credentials/gmail_personal_user
IMAP_PASS_GMAIL_PERSONAL=infisical://dev-baile/mailcow/imap_credentials/gmail_personal_app_password
IMAP_USER_GMAIL_ACADEMIC=infisical://dev-baile/mailcow/imap_credentials/gmail_academic_user
IMAP_PASS_GMAIL_ACADEMIC=infisical://dev-baile/mailcow/imap_credentials/gmail_academic_app_password
IMAP_USER_HOTMAIL_LEGACY=infisical://dev-baile/mailcow/imap_credentials/hotmail_legacy_user
IMAP_PASS_HOTMAIL_LEGACY=infisical://dev-baile/mailcow/imap_credentials/hotmail_legacy_app_password

# =============================================================================
# Configuration (non-secret, set as needed)
# =============================================================================
TZ=Europe/Dublin
MAILCOW_PASS_SCHEME=BLF-CRYPT
COMPOSE_PROJECT_NAME=mailcow-dockerized
IPV4_NETWORK=172.22.1
IPV6_NETWORK=fd4d:6169:6c63:6f77::/64
SQL_PORT=127.0.0.1:13306
REDIS_PORT=127.0.0.1:7654
HTTPS_PORT=443
HTTP_PORT=80
SMTP_PORT=25
SMTPS_PORT=465
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
POP_PORT=110
POPS_PORT=995
SIEVE_PORT=4190
