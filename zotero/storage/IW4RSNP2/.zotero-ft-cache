  import  torch 

# Move the model to appropriate device 
device  =  torch . device ( "cuda"  if  torch . cuda . is_available ()  else  "cpu" ) 
model  =  model . to ( device ) 

# Set the model to train mode (HuggingFace models load in eval mode) 
