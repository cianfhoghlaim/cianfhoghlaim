{
  "$schema": "https://turborepo.com/microfrontends/schema.json",
  "options": {
    "localProxyPort": 3024
  },
  "applications": {
    "portal": {
      "packageName": "cianfhoghlaim-portal",
      "development": {
        "local": {
          "port": 3000
        },
        "fallback": "https://portal.cianfhoghlaim.ie"
      }
    },
    "oideachais": {
      "packageName": "@oideachais/web",
      "development": {
        "local": {
          "port": 3100
        },
        "fallback": "https://oideachais.cianfhoghlaim.ie"
      },
      "routing": [
        {
          "group": "curriculum",
          "paths": ["/curriculum", "/curriculum/:path*"]
        },
        {
          "group": "exams",
          "paths": ["/exams", "/exams/:path*"]
        },
        {
          "group": "subjects",
          "paths": ["/subjects", "/subjects/:path*"]
        }
      ]
    },
    "crypteolas": {
      "packageName": "crypteolas-ui",
      "development": {
        "local": {
          "port": 3101
        },
        "fallback": "https://crypteolas.cianfhoghlaim.ie"
      },
      "routing": [
        {
          "group": "defi",
          "paths": ["/defi", "/defi/:path*"]
        },
        {
          "group": "protocols",
          "paths": ["/protocols", "/protocols/:path*"]
        },
        {
          "group": "code",
          "paths": ["/code", "/code/:path*"]
        }
      ]
    },
    "tuath": {
      "packageName": "tuath-ui",
      "development": {
        "local": {
          "port": 3102
        },
        "fallback": "https://tuath.cianfhoghlaim.ie"
      },
      "routing": [
        {
          "group": "game",
          "paths": ["/game", "/game/:path*"]
        },
        {
          "group": "mythology",
          "paths": ["/mythology", "/mythology/:path*"]
        },
        {
          "group": "map",
          "paths": ["/map", "/map/:path*"]
        }
      ]
    },
    "dagster": {
      "development": {
        "local": {
          "port": 3335
        }
      },
      "routing": [
        {
          "paths": ["/dagster", "/dagster/:path*"]
        }
      ]
    }
  }
}
