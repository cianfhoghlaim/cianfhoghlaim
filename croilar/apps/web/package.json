{
  "name": "@croilar/web",
  "version": "1.0.0",
  "description": "Croílár — personal portfolio + CV + data engineering",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3003",
    "build": "vite build",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler pages deploy dist",
    "deploy:preview": "wrangler pages deploy dist --branch preview",
    "notebook:wasm:aleyum": "mkdir -p public/wasm/aleyum-music && marimo export wasm ../../notebooks/aleyum/music_analytics.py -o public/wasm/aleyum-music",
    "notebook:wasm:cianfhoghlaim": "mkdir -p public/wasm/cianfhoghlaim-teaching && marimo export wasm ../../notebooks/cianfhoghlaim/teaching_analytics.py -o public/wasm/cianfhoghlaim-teaching",
    "notebook:wasm": "bun run notebook:wasm:aleyum && bun run notebook:wasm:cianfhoghlaim"
  },
  "dependencies": {
    "@croilar/db": "workspace:*",
    "@croilar/i18n": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^25.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.4.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^7.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3"
  }
}
