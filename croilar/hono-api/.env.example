# =============================================================================
# CROILAR HONO API — Environment Variables
# =============================================================================
# Copy to .env (gitignored) and fill in real values.
# For production, secrets come from Locket → dev-baile/croilar/hono/
# =============================================================================

# === Required: Database ===
# Local dev (croilar-postgres stack): postgres://croilar:devpassword@localhost:5434/croilar
# Production (PlanetScale): postgres://pscale_api_*:pscale_pw_*@aws-eu-west-2-1.pg.psdb.cloud:6432/postgres
DATABASE_URL=postgres://croilar:devpassword@localhost:5434/croilar

# === Required: BetterAuth ===
# 32-byte hex string. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-32-byte-hex
# Public URL of this Hono API. Must match the issuer in Convex auth.config.ts.
BETTER_AUTH_URL=http://localhost:4000
# Public URL of the web app (CORS origin)
PUBLIC_WEB_URL=http://localhost:3000

# === Optional: Social Providers ===
# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Croílár-specific ===
CROILAR_HMAC_SECRET=replace-me
CROILAR_ENCRYPTION_KEY=replace-me

# === Convex (for HTTP webhooks from BetterAuth → Convex) ===
CONVEX_URL=http://localhost:3210

# === Server ===
PORT=4000
NODE_ENV=development
