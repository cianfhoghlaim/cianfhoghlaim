{
  "name": "cianfhoghlaim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cianfhoghlaim — Celtic language AI learning platform. Polyglot monorepo orchestrator (bun + uv + turbo).",
  "packageManager": "bun@1.3.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "workspaces": [
    "sruth/oideachais/web",
    "sruth/oideachais/mcp/filesystem",
    "tuatha/ui",
    "tuatha/apps/crypteolas_demo",
    "croilar/apps/web",
    "croilar/apps/portal",
    "croilar/hono-api",
    "croilar/packages/*"
  ],
  "scripts": {
    "postinstall": "turbo run postinstall --filter=./scripts/* || true",

    "setup": "mise install && bun install && uv sync && bun run secrets:env && bun run secrets:init",
    "doctor": "bunx turbo run doctor || mise run doctor",

    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev --concurrency=20",
    "dev:oideachais": "bunx turbo run dev --filter=oideachais-web",
    "dev:tuatha": "bunx turbo run dev --filter=tuatha-ui",
    "typecheck": "bunx turbo run typecheck",
    "lint": "bunx turbo run lint",
    "format": "bunx turbo run format",
    "test": "bunx turbo run test",
    "clean": "bunx turbo run clean && rm -rf node_modules .turbo **/__pycache__",

    "secrets:env": "bun run scripts/create-env.ts",
    "secrets:init": "bun run scripts/init-vault.ts",
    "secrets:sync": "bun run scripts/init-vault.ts",

    "dagster:oideachais": "cd sruth/oideachais && uv run dagster dev -m data_platform.dagster_defs.definitions",
    "dagster:tuatha": "cd tuatha && uv run dagster dev -m dagster_assets.definitions",

    "komodo:sync": "mise run komodo:sync",
    "pangolin:check": "mise run pangolin:check",
    "locket:exec": "mise run locket:exec",

    "ccc:init": "ccc init",
    "ccc:index": "uv run cocoindex update sruth.oideachais.cocoindex_flows.codebase_indexing:CodebaseIndex",
    "ccc:search": "ccc search",
    "ccc:v1:index": "uv run cocoindex update sruth.oideachais.cocoindex_flows.codebase_indexing:CodebaseIndex",
    "ccc:v1:search": "uv run python -c 'import asyncio, sys; from sruth.oideachais.cocoindex_flows.codebase_indexing import search_codebase; rows = asyncio.run(search_codebase(sys.argv[1])); [print(f\"{r.get(\\\"score\\\", 0):.3f}\\t{r.get(\\\"path\\\")}:{r.get(\\\"chunk_start\\\")}-{r.get(\\\"chunk_end\\\")}\\t{(r.get(\\\"chunk_text\\\") or \\\"\\\").splitlines()[0][:120]}\") for r in rows]' \"${1:-}\"",
    "docs:consolidate": "uv run cocoindex update sruth.oideachais.cocoindex_flows.docs_skills_consolidation:DocsSkillsConsolidation",
    "docs:consolidate:live": "uv run cocoindex update -L sruth.oideachais.cocoindex_flows.docs_skills_consolidation:DocsSkillsConsolidation",
    "baml:generate": "uv run baml-cli generate",

    "spec:list": "openspec list",
    "spec:validate": "openspec validate",
    "spec:archive": "openspec archive",

    "validate-stacks": "bash scripts/stack-doctor.sh",
    "doctor:stacks": "bash scripts/stack-doctor.sh --json | jq",
    "mise:run": "mise run",

    "validate-docs": "bun run scripts/validate-docs.ts",
    "validate-openspec-stale": "bun run scripts/validate-openspec-stale.ts",
    "validate-frontmatter": "bun run scripts/validate-frontmatter.ts",

    "smoke": "bash infrastructure/stacks/frontend/scripts/smoke.sh",

    "croilar:analyze": "bun run croilar/scripts/analyze-web-stack.ts",
    "croilar:glance:regen": "bun run croilar/scripts/regenerate-glance-config.ts",
    "croilar:export:wasm": "bun run croilar/scripts/export-marimo-wasm.ts",
    "croilar:devtools:refresh": "bun run croilar/scripts/analyze-web-stack.ts --out croilar/.cache/webstack-snapshot.json",
    "croilar:devtools:hub": "bun run croilar/scripts/regenerate-glance-config.ts && bun run croilar/scripts/export-marimo-wasm.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.7.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "dotenv": "^17.2.0"
  }
}
