{
  "name": "cianfhoghlaim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cianfhoghlaim — Celtic language AI learning platform. Polyglot monorepo orchestrator (bun + uv + turbo). The bonneagar v5 IaC (88 Docker Compose stacks + Komodo resource-syncs + Pangolin blueprint imports + Infisical/Locket/Pangolin/Traefik orchestration) lives in the bonneagar/ subdirectory and is reached via the iac:* scripts that delegate with --cwd bonneagar.",
  "packageManager": "bun@1.3.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "workspaces": [
    "web/apps/*",
    "web/packages/*",
    "web/hono-api"
  ],
  "scripts": {
    "postinstall": "turbo run postinstall --filter=./scripts/* || true",
    "setup": "mise install && bun install && uv sync && bun run secrets:env && bun run secrets:init",
    "doctor": "bunx turbo run doctor || mise run doctor",
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev --concurrency=20",
    "dev:oideachais": "bunx turbo run dev --filter=oideachais-web",
    "dev:tuatha": "bunx turbo run dev --filter=tuatha-ui",
    "dev:croilar": "bunx turbo run dev --filter=croilar-web",
    "typecheck": "bunx turbo run typecheck",
    "lint": "bunx turbo run lint",
    "format": "bunx turbo run format",
    "test": "bunx turbo run test",
    "clean": "bunx turbo run clean && rm -rf node_modules .turbo **/__pycache__",
    "secrets:env": "bun run scripts/create-env.ts",
    "secrets:init": "bun run scripts/init-vault.ts",
    "secrets:sync": "bun run scripts/init-vault.ts",
    "dagster:oideachais": "uv run dagster dev -m assets.definitions",
    "dagster:tuatha": "uv run dagster dev -m assets.definitions",
    "komodo:sync": "mise run komodo:sync",
    "pangolin:check": "mise run pangolin:check",
    "locket:exec": "mise run locket:exec",
    "iac": "bun run --cwd bonneagar iac",
    "iac:plan": "bun run --cwd bonneagar iac:plan",
    "iac:deploy": "bun run --cwd bonneagar iac:deploy",
    "iac:bootstrap": "bun run --cwd bonneagar iac:bootstrap",
    "iac:teardown": "bun run --cwd bonneagar iac:teardown",
    "iac:health": "bun run --cwd bonneagar iac:health",
    "iac:sync:secrets": "bun run --cwd bonneagar iac:sync:secrets",
    "iac:sync:resources": "bun run --cwd bonneagar iac:sync:resources",
    "iac:sync:sites": "bun run --cwd bonneagar iac:sync:sites",
    "iac:sync:procedures": "bun run --cwd bonneagar iac:sync:procedures",
    "iac:sync:resource-syncs": "bun run --cwd bonneagar iac:sync:resource-syncs",
    "iac:sync:monitors": "bun run --cwd bonneagar iac:sync:monitors",
    "iac:sync:alerts": "bun run --cwd bonneagar iac:sync:alerts",
    "iac:sync:variables": "bun run --cwd bonneagar iac:sync:variables",
    "iac:sync:schedules": "bun run --cwd bonneagar iac:sync:schedules",
    "iac:sync:action-recipients": "bun run --cwd bonneagar iac:sync:action-recipients",
    "iac:sync:olm": "bun run --cwd bonneagar iac:sync:olm",
    "iac:rotate-auth": "bun run --cwd bonneagar iac:rotate-auth",
    "iac:bootstrap-pocketid-admin": "bun run --cwd bonneagar iac:bootstrap-pocketid-admin",
    "preflight:arm-oci": "bun run scripts/preflight-arm-oci.ts",
    "preflight:arm-oci:strict": "bun run scripts/preflight-arm-oci.ts --strict",
    "preflight:arm-oci:report": "bun run scripts/preflight-arm-oci.ts --strict --emit-md",
    "ccc:init": "ccc init",
    "ccc:index": "uv run cocoindex update core.cocoindex.codebase_indexing:CodebaseIndex",
    "ccc:search": "bun run scripts/_ccc-deprecation-banner.ts && ccc search",
    "ccc:v1:index": "uv run cocoindex update core.cocoindex.codebase_indexing:CodebaseIndex",
    "ccc:v1:search": "uv run python scripts/ccc_v1_search.py",
    "docs:consolidate": "uv run cocoindex update core.cocoindex.docs_skills_consolidation:DocsSkillsConsolidation",
    "docs:consolidate:live": "uv run cocoindex update -L core.cocoindex.docs_skills_consolidation:DocsSkillsConsolidation",
    "upstream:blog": "uv run cocoindex update core.cocoindex.upstream_blog_monitor:UpstreamBlogMonitor",
    "upstream:blog:live": "uv run cocoindex update -L core.cocoindex.upstream_blog_monitor:UpstreamBlogMonitor",
    "upstream:conformance": "uv run python -c 'import asyncio; from core.cocoindex.cocoindex_v1_conformance import run_conformance_check; report = asyncio.run(run_conformance_check()); print(report.summary()); import sys; sys.exit(0 if report.all_passed else 1)'",
    "upstream:api-surface": "uv run cocoindex update core.cocoindex.upstream_api_surface:UpstreamApiSurface",
    "baml:generate": "uv run baml-cli generate",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate",
    "spec:archive": "openspec archive",
    "schema:generate": "bun run scripts/schema-generate.ts --offline",
    "schema:validate": "bun run scripts/schema-validate.ts --offline --quiet",
    "lineage:validate": "bun run scripts/lineage-validate.ts --quiet",
    "lineage:smoke": "bun run scripts/lineage-smoke.ts",
    "validate-stacks": "bash scripts/stack-doctor.sh",
    "doctor:stacks": "bash scripts/stack-doctor.sh --json | jq",
    "validate-env": "uv run python scripts/validate_env.py",
    "validate-ccc-freshness": "bun run scripts/validate-ccc-freshness.ts",
    "hooks:install": "bash scripts/install-hooks.sh",
    "mise:run": "mise run",
    "validate-docs": "bun run scripts/validate-docs.ts",
    "validate-openspec-stale": "bun run scripts/validate-openspec-stale.ts",
    "validate-frontmatter": "bun run scripts/validate-frontmatter.ts",
    "smoke": "bash stacks/frontend/scripts/smoke.sh",
    "croilar:analyze": "bun run scripts/croilar/analyze-web-stack.ts",
    "croilar:glance:regen": "bun run scripts/croilar/regenerate-glance-config.ts",
    "croilar:export:wasm": "bun run scripts/croilar/export-marimo-wasm.ts",
    "croilar:devtools:refresh": "bun run scripts/croilar/analyze-web-stack.ts --out .cache/webstack-snapshot.json",
    "croilar:devtools:hub": "bun run scripts/croilar/regenerate-glance-config.ts && bun run scripts/croilar/export-marimo-wasm.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.7.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "dotenv": "^17.2.0",
    "komodo_client": "^2.1.1",
    "opencode-ai": "^1.18.16"
  }
}
