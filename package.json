{
  "name": "cianfhoghlaim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Cianfhoghlaim — Celtic language AI learning platform. Polyglot monorepo orchestrator (bun + uv + turbo).",
  "packageManager": "bun@1.3.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "workspaces": [
    "cianfhoghlaim/web/apps/oideachais-web",
    "cianfhoghlaim/web/apps/tuatha-ui",
    "cianfhoghlaim/web/apps/croilar-web",
    "cianfhoghlaim/web/apps/croilar-portal",
    "cianfhoghlaim/web/hono-api",
    "cianfhoghlaim/web/packages/*"
  ],
  "scripts": {
    "postinstall": "turbo run postinstall --filter=./scripts/* || true",

    "setup": "mise install && bun install && uv sync && bun run secrets:env && bun run secrets:init",
    "doctor": "bunx turbo run doctor || mise run doctor",

    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev --concurrency=20",
    "dev:oideachais": "bunx turbo run dev --filter=oideachais-web",
    "dev:tuatha": "bunx turbo run dev --filter=tuatha-ui",
    "dev:croilar": "bunx turbo run dev --filter=croilar-web",
    "typecheck": "bunx turbo run typecheck",
    "lint": "bunx turbo run lint",
    "format": "bunx turbo run format",
    "test": "bunx turbo run test",
    "clean": "bunx turbo run clean && rm -rf node_modules .turbo **/__pycache__",

    "secrets:env": "bun run scripts/create-env.ts",
    "secrets:init": "bun run scripts/init-vault.ts",
    "secrets:sync": "bun run scripts/init-vault.ts",

    "dagster:oideachais": "uv run dagster dev -m cianfhoghlaim.assets.definitions",
    "dagster:tuatha": "uv run dagster dev -m cianfhoghlaim.assets.definitions",

    "komodo:sync": "mise run komodo:sync",
    "pangolin:check": "mise run pangolin:check",
    "locket:exec": "mise run locket:exec",

    "ccc:init": "ccc init",
    "ccc:index": "uv run cocoindex update cianfhoghlaim.core.cocoindex.codebase_indexing:CodebaseIndex",
    "ccc:search": "bun run scripts/_ccc-deprecation-banner.ts && ccc search",
    "ccc:v1:index": "uv run cocoindex update cianfhoghlaim.core.cocoindex.codebase_indexing:CodebaseIndex",
    "ccc:v1:search": "uv run python scripts/ccc_v1_search.py",
    "docs:consolidate": "uv run cocoindex update cianfhoghlaim.core.cocoindex.docs_skills_consolidation:DocsSkillsConsolidation",
    "docs:consolidate:live": "uv run cocoindex update -L cianfhoghlaim.core.cocoindex.docs_skills_consolidation:DocsSkillsConsolidation",

    "upstream:blog": "uv run cocoindex update cianfhoghlaim.core.cocoindex.upstream_blog_monitor:UpstreamBlogMonitor",
    "upstream:blog:live": "uv run cocoindex update -L cianfhoghlaim.core.cocoindex.upstream_blog_monitor:UpstreamBlogMonitor",
    "upstream:conformance": "uv run python -c 'import asyncio; from cianfhoghlaim.core.cocoindex.cocoindex_v1_conformance import run_conformance_check; report = asyncio.run(run_conformance_check()); print(report.summary()); import sys; sys.exit(0 if report.all_passed else 1)'",
    "upstream:api-surface": "uv run cocoindex update cianfhoghlaim.core.cocoindex.upstream_api_surface:UpstreamApiSurface",
    "baml:generate": "uv run baml-cli generate",

    "spec:list": "openspec list",
    "spec:validate": "openspec validate",
    "spec:archive": "openspec archive",

    "validate-stacks": "bash scripts/stack-doctor.sh",
    "doctor:stacks": "bash scripts/stack-doctor.sh --json | jq",
    "validate-ccc-freshness": "bun run scripts/validate-ccc-freshness.ts",
    "hooks:install": "bash scripts/install-hooks.sh",
    "mise:run": "mise run",

    "validate-docs": "bun run scripts/validate-docs.ts",
    "validate-openspec-stale": "bun run scripts/validate-openspec-stale.ts",
    "validate-frontmatter": "bun run scripts/validate-frontmatter.ts",

    "smoke": "bash cianfhoghlaim/stacks/frontend/scripts/smoke.sh",

    "croilar:analyze": "bun run cianfhoghlaim/scripts/croilar/analyze-web-stack.ts",
    "croilar:glance:regen": "bun run cianfhoghlaim/scripts/croilar/regenerate-glance-config.ts",
    "croilar:export:wasm": "bun run cianfhoghlaim/scripts/croilar/export-marimo-wasm.ts",
    "croilar:devtools:refresh": "bun run cianfhoghlaim/scripts/croilar/analyze-web-stack.ts --out cianfhoghlaim/.cache/webstack-snapshot.json",
    "croilar:devtools:hub": "bun run cianfhoghlaim/scripts/croilar/regenerate-glance-config.ts && bun run cianfhoghlaim/scripts/croilar/export-marimo-wasm.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.4.0",
    "turbo": "^2.7.2",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "dotenv": "^17.2.0"
  }
}
