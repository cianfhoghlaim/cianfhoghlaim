{
  "name": "stagehand-server",
  "version": "1.0.0",
  "type": "module",
  "description": "Local Stagehand server with Browserbase fallback for sruth browser automation",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "latest",
    "express": "^4.21.2",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2",
    "lru-cache": "^11.0.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
