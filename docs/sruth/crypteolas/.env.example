# Crypteolas Environment Variables
# Copy to .env and fill in your values

# =============================================================================
# Required API Keys
# =============================================================================

# GitHub Personal Access Token (for repository analysis)
# Scopes needed: public_repo, read:org, read:user
GITHUB_TOKEN=

# AI/LLM Providers (at least one required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# =============================================================================
# Database Connections (populated by Docker Compose)
# =============================================================================

# DuckDB (local file)
DUCKDB_PATH=./storage/duckdb/crypteolas.duckdb

# LanceDB (local directory)
LANCEDB_URI=./storage/lance

# Memgraph (knowledge graph)
MEMGRAPH_URL=bolt://localhost:7688
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=
NEO4J_PASSWORD=

# DragonflyDB (Redis-compatible cache)
DRAGONFLY_URL=redis://localhost:6380
REDIS_URL=redis://localhost:6380

# =============================================================================
# Observability (Optional)
# =============================================================================

# Langfuse (LLM tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3004
LANGFUSE_NEXTAUTH_SECRET=your-secret-change-me
LANGFUSE_SALT=your-salt-change-me

# =============================================================================
# External APIs (Optional)
# =============================================================================

# DeFiLlama (for DeFi protocol data)
DEFILLAMA_API_KEY=

# Coingecko (for token prices)
COINGECKO_API_KEY=

# The Graph (for subgraph queries - Aave, Pendle, etc.)
# Get key at: https://thegraph.com/studio/apikeys/
THEGRAPH_API_KEY=
