FROM python:3.12-slim

WORKDIR /opt/dagster/app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Copy dependency files
COPY pyproject.toml ./

# Install Python dependencies
RUN uv pip install --system --no-cache \
    dagster==1.9.0 \
    dagster-webserver==1.9.0 \
    dagster-dlt>=0.25.0 \
    dlt[duckdb,parquet]>=1.18.0 \
    lancedb>=0.17.0 \
    ibis-framework[duckdb]>=11.0.0 \
    polars>=1.0.0 \
    crawl4ai>=0.4.0 \
    boto3>=1.34.0 \
    httpx>=0.27.0 \
    pydantic>=2.0.0 \
    pydantic-settings>=2.0.0

# Set up Dagster home
ENV DAGSTER_HOME=/opt/dagster/dagster_home
RUN mkdir -p $DAGSTER_HOME/storage

# Copy Dagster configuration
COPY dagster.yaml $DAGSTER_HOME/dagster.yaml

# Copy workspace configuration
COPY workspace.yaml /opt/dagster/app/workspace.yaml

# Copy application code (volumes will override in dev)
COPY definitions.py ./
COPY dagster_assets/ ./dagster_assets/
COPY pipelines/ ./pipelines/
COPY _shared/ ./_shared/
COPY cocoindex_flows/ ./cocoindex_flows/
COPY services/ ./services/

EXPOSE 3000
