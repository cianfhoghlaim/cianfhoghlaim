# =============================================================================
# OIDEACHAIS - Celtic Education Platform Configuration
# =============================================================================
# Copy this file to .env.local for local development
#
# cp .env.local.example .env.local
#
# =============================================================================

# -----------------------------------------------------------------------------
# DATADOG (APM + LLM Observability)
# -----------------------------------------------------------------------------
DD_API_KEY=your-datadog-api-key
DD_APP_KEY=your-datadog-app-key
DD_SITE=datadoghq.eu
DD_ENV=development
DD_SERVICE=oideachais-celtic-education
DD_VERSION=0.1.0

# LLM Observability (for ADK agents with Gemini)
DD_LLMOBS_ENABLED=true
DD_LLMOBS_ML_APP=celtic-education-pipeline
DD_LLMOBS_AGENTLESS_ENABLED=true

# APM Agent connection (when running containerized agent)
DD_TRACE_AGENT_URL=http://localhost:8126
DD_LOGS_JSON=true

# -----------------------------------------------------------------------------
# MLFLOW (Experiment Tracking)
# -----------------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
# Production: MLFLOW_TRACKING_URI=http://mlflow.cianfhoghlaim.ie
MLFLOW_EXPERIMENT_NAME=oideachais-celtic-education

# -----------------------------------------------------------------------------
# LANGFUSE (LLM Tracing + Cost Tracking)
# -----------------------------------------------------------------------------
LANGFUSE_HOST=http://localhost:3000
# Production: LANGFUSE_HOST=http://langfuse.cianfhoghlaim.ie
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key

# -----------------------------------------------------------------------------
# CONFLUENT KAFKA (Streaming)
# -----------------------------------------------------------------------------
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.europe-west1.gcp.confluent.cloud:9092
CONFLUENT_API_KEY=your-confluent-api-key
CONFLUENT_API_SECRET=your-confluent-api-secret

# Schema Registry
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxxx.europe-west1.gcp.confluent.cloud
CONFLUENT_SR_API_KEY=your-schema-registry-api-key
CONFLUENT_SR_API_SECRET=your-schema-registry-api-secret

# -----------------------------------------------------------------------------
# GOOGLE CLOUD / VERTEX AI (ADK Agents)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=cianfhoghlaim
VERTEX_AI_ENABLED=true

# Gemini models for agents
ADK_MODEL=gemini-2.0-flash
ADK_ADVANCED_MODEL=gemini-2.5-pro

# For Ragas evaluation (LiteLLM format)
LITELLM_MODEL=gemini/gemini-1.5-flash

# -----------------------------------------------------------------------------
# DATABASE CONNECTIONS
# -----------------------------------------------------------------------------
# DuckDB (single-threaded only!)
DUCKDB_PATH=./storage/data/oideachais.duckdb

# LanceDB (MVCC safe)
LANCEDB_URI=./storage/data/lancedb

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

# Memgraph (alternative graph)
MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=memgraph
MEMGRAPH_PASSWORD=devpassword

# -----------------------------------------------------------------------------
# S3 / CLOUDFLARE R2 (Object Storage)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com
AWS_REGION=auto

# -----------------------------------------------------------------------------
# EMBEDDING MODELS
# -----------------------------------------------------------------------------
# Default embedding model
EMBEDDING_MODEL=multilingual-e5-large
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Batch size (MANDATORY: minimum 100 for performance)
EMBEDDING_BATCH_SIZE=100

# -----------------------------------------------------------------------------
# COCOINDEX CONFIGURATION
# -----------------------------------------------------------------------------
COCOINDEX_API_KEY=your-cocoindex-api-key
# Optional: Cloud CocoIndex endpoint
# COCOINDEX_ENDPOINT=https://api.cocoindex.io

# -----------------------------------------------------------------------------
# FIRECRAWL (Web Scraping)
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY=your-firecrawl-api-key

# -----------------------------------------------------------------------------
# API CONFIGURATION
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# CopilotKit backend URL
ADK_BACKEND_URL=http://localhost:8000/agent

# -----------------------------------------------------------------------------
# CELTIC LANGUAGE CONFIGURATION
# -----------------------------------------------------------------------------
# Supported languages: ga (Irish), gd (Scottish Gaelic), cy (Welsh),
#                      gv (Manx), kw (Cornish), br (Breton)
DEFAULT_LANGUAGE=ga
SUPPORTED_LANGUAGES=ga,gd,cy,gv,kw,br

# Irish-specific models
IRISH_LLM_MODEL=DCU-NLP/bert-base-irish-cased-v1
# Or: UCCIX-Llama2-13B-Instruct for instruction-following

# -----------------------------------------------------------------------------
# GEOSPATIAL CONFIGURATION
# -----------------------------------------------------------------------------
# Irish Small Areas (18,641 areas)
# UK LSOAs (Lower Layer Super Output Areas)
GEOSPATIAL_CACHE_DIR=./storage/data/geospatial_cache

# -----------------------------------------------------------------------------
# LOCKET / 1PASSWORD CONNECT (Production Secrets)
# -----------------------------------------------------------------------------
OP_CONNECT_HOST=http://132.145.27.89:8080
OP_CONNECT_TOKEN_FILE=./op_token
LOCKET_MODE=watch
