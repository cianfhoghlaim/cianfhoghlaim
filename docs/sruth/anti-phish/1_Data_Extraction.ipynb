   },
   "source": [
    "**Email Datasets**"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "30d4a4d1-d94a-4841-938a-a4d89cad6831",
   "metadata": {
    "citation-manager": {
     "citations": {
