{
  "name": "cianfhoghlaim-base",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/node": "^22.13.14",
      "@tanstack/react-query": "^5.90.12",
      "@orpc/server": "^1.12.2",
      "@orpc/client": "^1.12.2",
      "@orpc/openapi": "^1.12.2",
      "@orpc/zod": "^1.12.2",
      "@orpc/tanstack-query": "^1.12.2",
      "ai": "^6.0.3",
      "@ai-sdk/react": "^3.0.3",
      "better-auth": "^1.4.9",
      "@polar-sh/better-auth": "^1.1.3",
      "alchemy": "^0.82.1",
      "@better-auth/expo": "^1.4.9"
    }
  },
  "type": "module",
  "scripts": {
    "check": "biome check --write .",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @cianfhoghlaim-base/db db:push",
    "db:studio": "turbo -F @cianfhoghlaim-base/db db:studio",
    "db:generate": "turbo -F @cianfhoghlaim-base/db db:generate",
    "db:migrate": "turbo -F @cianfhoghlaim-base/db db:migrate",
    "deploy": "turbo -F @cianfhoghlaim-base/infra deploy",
    "destroy": "turbo -F @cianfhoghlaim-base/infra destroy"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@cianfhoghlaim-base/env": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "@biomejs/biome": "2.3.10",
    "ultracite": "6.5.0",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@cianfhoghlaim-base/config": "workspace:*",
    "@cloudflare/workers-types": "^4.20251213.0"
  },
  "packageManager": "bun@1.3.0"
}
