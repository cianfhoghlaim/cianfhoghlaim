#!/usr/bin/env bash
#MISE description="Stack lifecycle (up + down + logs)"
#MISE alias=["stack:up","stack:down","stack:logs"]
set -euo pipefail

ACTION="${1:?Usage: mise run stack <name> <up|down|logs>}"
NAME="${2:?Usage: mise run stack <name> <up|down|logs>}"
shift 2 || true

cd bonneagar
case "$ACTION" in
  up)
    ./scripts/stack.sh "$NAME" up -d "$@"
    ;;
  down)
    ./scripts/stack.sh "$NAME" down "$@"
    ;;
  logs)
    ./scripts/stack.sh "$NAME" logs -f "$@"
    ;;
  *)
    echo "Unknown stack action: $ACTION" >&2
    exit 1
    ;;
esac
