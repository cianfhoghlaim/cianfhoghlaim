#!/usr/bin/env bash
#MISE description="OpenCode code search (build the v1 LanceDB index if stale + semantic search)"
set -euo pipefail

QUERY="${1:-}"
if [ -z "$QUERY" ]; then
  echo "Usage: mise run opencode:search <query>" >&2
  exit 1
fi

# Refresh index first (idempotent)
uv run cocoindex update cocoindex_flows.infrastructure.codebase_indexing:CodebaseIndex 2>/dev/null || \
  bunx ccc search "$QUERY"
