#!/usr/bin/env bash
#MISE description="BONNEAGAR mirror — publish bonneagar/ to github.com/cianfhoghlaim/bonneagar in root layout (force-update). Usage: mise run bonneagar:mirror [--dry-run] [--ref <rev>] [--no-backup]"
#
# =============================================================================
# bonneagar:mirror — the one-way parent -> mirror publish
# =============================================================================
# `bonneagar/` in this monorepo is canonical. The standalone repo at
# github.com/cianfhoghlaim/bonneagar is a published mirror of it in ROOT
# layout (stacks/, komodo/, iac/ at the repo root, no bonneagar/ prefix).
#
# The export uses `git filter-repo --subdirectory-filter`, NOT
# `git subtree split`: this history carries 4 legacy
# "Squashed 'infrastructure/' content" commits whose git-subtree-split
# trailers make `subtree split` abort with "no new revisions were found".
#
# The mirror is FORCE-updated. Commits made directly on the mirror are
# discarded. Before each push this writes a backup branch on the mirror
# (backup/pre-monorepo-sync-<UTC-date>) so any push is one command to undo:
#
#   git push --force <mirror> backup/pre-monorepo-sync-<date>:main
#
# Exit codes:
#   0  mirror is up to date (pushed, or already matching)
#   1  precondition failed (dirty bonneagar/, missing tool, bad ref)
#   2  export verification failed (tree SHA mismatch) — nothing was pushed
#   3  push failed
# =============================================================================
set -euo pipefail

PREFIX="bonneagar"
MIRROR_URL="https://github.com/cianfhoghlaim/bonneagar.git"
MIRROR_BRANCH="main"

DRY_RUN=0
DO_BACKUP=1
REF="HEAD"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)    DRY_RUN=1; shift ;;
    --no-backup)  DO_BACKUP=0; shift ;;
    --ref)        REF="${2:?--ref needs a revision}"; shift 2 ;;
    -h|--help)    sed -n '3,28p' "$0"; exit 0 ;;
    *) echo "unknown flag: $1" >&2; exit 1 ;;
  esac
done

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ─── Preconditions ──────────────────────────────────────────────────────────
command -v git-filter-repo >/dev/null 2>&1 || {
  echo "✗ git-filter-repo not on PATH (pip install git-filter-repo)" >&2
  exit 1
}

git rev-parse --verify "$REF" >/dev/null 2>&1 || {
  echo "✗ not a valid revision: $REF" >&2; exit 1
}

# Uncommitted work under bonneagar/ would be silently omitted from the mirror.
if [[ -n "$(git status --porcelain -- "$PREFIX")" ]]; then
  echo "✗ uncommitted changes under $PREFIX/ — commit them first, or the mirror will be stale:" >&2
  git status --short -- "$PREFIX" >&2
  exit 1
fi

SRC_TREE="$(git rev-parse "${REF}:${PREFIX}")"
SRC_COMMIT="$(git rev-parse "$REF")"
echo "→ source     ${SRC_COMMIT:0:9}  (${REF})"
echo "→ tree       ${SRC_TREE:0:9}"

# ─── Export ─────────────────────────────────────────────────────────────────
WORK="$(mktemp -d -t bonneagar-mirror)"
trap 'rm -rf "$WORK"' EXIT

echo "→ cloning monorepo (single branch, no checkout)…"
git clone --no-local --no-checkout --single-branch \
  --branch "$(git rev-parse --abbrev-ref HEAD)" \
  "file://$REPO_ROOT" "$WORK/export" --quiet

cd "$WORK/export"
git checkout --quiet --detach "$SRC_COMMIT"

echo "→ filter-repo --subdirectory-filter $PREFIX…"
# --force: the clone is intentionally --no-checkout, which filter-repo would
# otherwise read as "uncommitted changes". $WORK is a throwaway.
git filter-repo --subdirectory-filter "$PREFIX" --force --quiet

# ─── Verify before pushing ──────────────────────────────────────────────────
OUT_TREE="$(git rev-parse HEAD^{tree})"
if [[ "$OUT_TREE" != "$SRC_TREE" ]]; then
  echo "✗ export tree $OUT_TREE != source tree $SRC_TREE — refusing to push" >&2
  exit 2
fi
echo "✓ export verified: root tree == ${REF}:${PREFIX} (${OUT_TREE:0:9}), $(git rev-list --count HEAD) commits"

if [[ "$DRY_RUN" == "1" ]]; then
  echo "→ --dry-run: not pushing. Export left at $WORK/export (removed on exit)."
  echo "  would force-push ${OUT_TREE:0:9} -> ${MIRROR_URL} ${MIRROR_BRANCH}"
  exit 0
fi

# ─── Backup the current mirror tip, then push ───────────────────────────────
git remote add mirror "$MIRROR_URL"

if [[ "$DO_BACKUP" == "1" ]]; then
  CURRENT="$(git ls-remote mirror "refs/heads/$MIRROR_BRANCH" | cut -f1)"
  if [[ -n "$CURRENT" ]]; then
    BACKUP="backup/pre-monorepo-sync-$(date -u +%Y-%m-%d)"
    echo "→ backing up mirror tip ${CURRENT:0:9} -> $BACKUP"
    git fetch --quiet mirror "$MIRROR_BRANCH"
    git push --quiet --force mirror "${CURRENT}:refs/heads/${BACKUP}" || {
      echo "✗ could not write backup branch — refusing to force-push" >&2; exit 3; }
  fi
fi

echo "→ force-pushing to $MIRROR_URL $MIRROR_BRANCH…"
git push --force mirror "HEAD:refs/heads/${MIRROR_BRANCH}" || { echo "✗ push failed" >&2; exit 3; }

echo "✓ mirror updated to ${OUT_TREE:0:9} (from ${SRC_COMMIT:0:9})"
