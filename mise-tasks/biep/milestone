#!/usr/bin/env bash
#MISE description="BIEP v3 milestone M<n> runner (m0 through m10)"
#MISE alias=["biep:v3:m0","biep:v3:m1","biep:v3:m2","biep:v3:m3","biep:v3:m4","biep:v3:m5","biep:v3:m6","biep:v3:m7","biep:v3:m8","biep:v3:m9","biep:v3:m10"]
#USAGE arg "<n>" help="Milestone number 0-10" default="0"
set -euo pipefail

N="{{arg(n)}}"
SCRIPT="scripts/m${N}_*.py"

# Use bash glob expansion to find the actual milestone script
shopt -s nullglob
CANDIDATES=($SCRIPT)
shopt -u nullglob

if [ ${#CANDIDATES[@]} -eq 0 ]; then
  echo "ERROR: no script matching $SCRIPT found" >&2
  exit 1
fi

if [ ${#CANDIDATES[@]} -gt 1 ]; then
  echo "ERROR: multiple scripts matching $SCRIPT found: ${CANDIDATES[*]}" >&2
  exit 1
fi

.venv/bin/python3 "${CANDIDATES[0]}"
