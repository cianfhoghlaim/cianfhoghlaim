# DLT Secrets Configuration
# Copy this file to secrets.toml and fill in your values
# DO NOT commit secrets.toml to version control

[sources.github_api]
access_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

[destination.duckdb]
# Optional: specify database path (defaults to pipeline name)
# database = "./data/github_intelligence.duckdb"

[destination.lancedb]
# LanceDB stores data in a local directory
# lance_uri = "./data/github_intelligence.lancedb"

# Optional: Motherduck for cloud deployment
[destination.motherduck]
# database = "md:github_intelligence"
# token = "your-motherduck-token"
