system):" }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}}{EXCHG {PARA 0 "> " 0 "" 
{MPLTEXT 1 0 34 "sigma:=10.0:rho:=28.0:beta:=8.0/3:" }}}{EXCHG {PARA 
0 "> " 0 "" {MPLTEXT 1 0 110 "sysdeq2:=diff(x(t),t)=sigma*(y(t)-x(t)),
diff(y(t),t)=rho*x(t)-y(t)-x(t)*z(t),diff(z(t),t)=x(t)*y(t)-beta*z(t);
" }}{PARA 12 "" 1 "" {XPPMATH 20 "6#>%(sysdeq2G6%/-%%diffG6$-%\"xG6#%
