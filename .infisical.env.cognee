# =============================================================================
# COGNEE - Environment Variables (Knowledge Graph Builder)
# =============================================================================
# Per the 2026-08-24-lakehouse-stack-doctor-and-env-var-cleanup-v1 change.
#
# Cognee-specific secrets resolved by Locket from dev-baile/cognee/ + dev-baile/lakehouse/.
# See `.infisical.env.lakehouse` for the lakehouse-specific secrets.
# =============================================================================

# Cognee PostgreSQL user (dedicated — added 2026-08-23 for security isolation)
COGNEE_POSTGRES_USER=cognee  # not Locket-resolved; hardcoded in compose.yaml
COGNEE_POSTGRES_PASSWORD=infisical://dev-baile/lakehouse/cognee_postgres_password

# LLM via LiteLLM proxy (no-key-needed is a sentinel — see compose.yaml comment)
COGNEE_LLM_API_KEY=infisical://dev-baile/cognee/llm_api_key
COGNEE_EMBEDDING_API_KEY=infisical://dev-baile/cognee/embedding_api_key
COGNEE_LLM_MODEL=infisical://dev-baile/cognee/llm_model
COGNEE_EMBEDDING_MODEL=infisical://dev-baile/cognee/embedding_model

# Galileo AI observability (optional — token-pricing + drift alerts)
GALILEO_API_KEY=infisical://dev-baile/cognee/galileo_api_key
