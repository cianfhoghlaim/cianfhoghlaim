{SECT 0 {EXCHG {PARA 407 "" 0 "" {TEXT -1 0 "" }}{PARA 403 "" 0 "" 
{TEXT 269 23 "MAPLE NOTES for MA321  " }}{PARA 403 "" 0 "" {TEXT 270 
55 "School of Mathematics, Statistics & Applied Mathematics" }}{PARA 
0 "" 0 "" {TEXT -1 0 "" }}{PARA 405 "" 0 "" {TEXT 271 58 "Please proce
ed by entering return at each > prompt symbol." }}{PARA 0 "" 0 "" 
{TEXT -1 0 "" }}}{PARA 258 "" 0 "" {TEXT 256 3 "6. " }{TEXT -1 54 "Boo
lean algebra, if and do control structures in Maple" }{TEXT 257 2 ". \+
" }}{EXCHG {PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {TEXT 268 
43 "The following Maple commands are discussed:" }}{PARA 0 "" 0 "" 
{TEXT -1 0 "" }}{PARA 259 "" 0 "" {HYPERLNK 17 "and ,or, not" 1 "" "an
d" }{TEXT -1 2 " ," }}{PARA 259 "" 0 "" {HYPERLNK 17 "evalb" 1 "" "eva
lb" }{TEXT -1 3 " , " }}{PARA 259 "" 0 "" {HYPERLNK 17 "if-then-elif" 
1 "" "if" }{TEXT -1 3 " , " }}{PARA 402 "" 0 "" {HYPERLNK 17 "while-do
" 1 "" "while" }{TEXT -1 2 " ," }}{PARA 259 "" 0 "" {HYPERLNK 17 "for-
do" 1 "" "do" }{TEXT -1 2 " ," }}{PARA 408 "" 0 "" {TEXT -1 1 " " }}}
{EXCHG {PARA 409 "" 0 "" {TEXT -1 0 "" }{TEXT 258 26 "Boolean Constant
s in Maple" }{TEXT -1 1 " " }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 
261 "" 0 "" {TEXT -1 151 "MAPLE defines two Boolean logical constants:
 true and false. These can be manipulated with standard logical Boolea
n operations such as and, or and not:" }}{PARA 262 "" 0 "" {TEXT -1 0 
"" }}{PARA 263 "" 0 "" {TEXT -1 10 "> a and b;" }}{PARA 264 "" 0 "" 
{TEXT -1 9 "> a or b;" }}{PARA 265 "" 0 "" {TEXT -1 8 "> not a;" }}
{PARA 266 "" 0 "" {TEXT -1 0 "" }}{PARA 267 "" 0 "" {TEXT -1 41 "where
 a, b are elements of \{true, false\}." }}{PARA 268 "" 0 "" {TEXT -1 
0 "" }}{PARA 269 "" 0 "" {TEXT -1 10 "Examples:\n" }}{PARA 270 "> " 0 
"" {MPLTEXT 1 0 14 "true or false;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#
%%trueG" }}}{EXCHG {PARA 271 "> " 0 "" {MPLTEXT 1 0 9 "not true;" }}
{PARA 11 "" 1 "" {XPPMATH 20 "6#%&falseG" }}}{EXCHG {PARA 410 "" 0 "" 
{TEXT -1 0 "" }}{PARA 273 "" 0 "" {TEXT -1 160 "The logical constants \+
appear as the results of Boolean operations and functions defined in M
aple. Thus equality and inequality between quantities can be tested:" 
}}{PARA 274 "" 0 "" {TEXT -1 0 "" }}{PARA 275 "" 0 "" {TEXT -1 10 "Exa
mples:\n" }}{PARA 276 "> " 0 "" {MPLTEXT 1 0 5 "x:=2;" }}{PARA 11 "" 
1 "" {XPPMATH 20 "6#>%\"xG\"\"#" }}}{EXCHG {PARA 277 "> " 0 "" 
{MPLTEXT 1 0 12 "evalb(x>=3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#%&fal
seG" }}}{EXCHG {PARA 279 "" 0 "" {TEXT -1 36 "x is not greater than or
 equal to 3." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 279 "" 0 "evalb
" {TEXT 259 5 "evalb" }{TEXT -1 79 ": The command evalb is Boolean eva
luation whose result is always true or false." }}{PARA 0 "" 0 "" 
{TEXT -1 0 "" }}{PARA 280 "> " 0 "" {MPLTEXT 1 0 14 "evalb(2*x<>6);" }
}{PARA 11 "" 1 "" {XPPMATH 20 "6#%%trueG" }}}{EXCHG {PARA 282 "" 0 "" 
{TEXT -1 52 "2*x is not equal to 6 and hence the result is true.\n" }}
{PARA 283 "> " 0 "" {MPLTEXT 1 0 11 "evalb(x=2);" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#%%trueG" }}}{EXCHG {PARA 289 "> " 0 "" {MPLTEXT 1 0 15 
"isprime(56731);" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#%%trueG" }}}
{EXCHG {PARA 411 "" 0 "" {TEXT -1 0 "" }}{PARA 291 "" 0 "" {TEXT -1 
87 "Not that isprime is a Boolean Maple function that tests a given in
teger for primality. " }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}}{EXCHG 
{PARA 293 "" 0 "" {TEXT -1 74 "A Maple variable can also be assigned t
he value true or false as required." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }
}{PARA 294 "> " 0 "" {MPLTEXT 1 0 26 "right:=true;wrong:=false; " }}
{PARA 11 "" 1 "" {XPPMATH 20 "6#>%&rightG%%trueG" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#>%&wrongG%&falseG" }}}{EXCHG {PARA 295 "> " 0 "" 
{MPLTEXT 1 0 10 "not right;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#%&false
G" }}}{EXCHG {PARA 412 "" 0 "" {TEXT -1 0 "" }}{PARA 297 "" 0 "if" 
{TEXT 260 24 "Maple Control Structures" }}{PARA 0 "" 0 "" {TEXT -1 0 "
" }}{PARA 416 "" 0 "" {TEXT -1 92 "Maple contains the usual control st
ructures including conditional if and do loop structures." }}}{EXCHG 
{PARA 413 "" 0 "" {TEXT -1 0 "" }}{PARA 299 "" 0 "" {TEXT 261 12 "if-t
hen-else" }{TEXT -1 66 ": Conditional execution.  The simplest form of
 this structure is :" }}{PARA 300 "" 0 "" {TEXT -1 0 "" }}{PARA 301 "
" 0 "" {TEXT -1 20 "> if condition then " }}{PARA 302 "" 0 "" {TEXT 
-1 21 ">    statement seq_1;" }}{PARA 303 "" 0 "" {TEXT -1 6 "> else" 
}}{PARA 304 "" 0 "" {TEXT -1 20 ">   statement seq_2;" }}{PARA 305 "" 
0 "" {TEXT -1 20 ">  end if;  (or fi;)" }}{PARA 0 "" 0 "" {TEXT -1 0 "
" }}}{EXCHG {PARA 307 "" 0 "" {TEXT -1 394 "Condition is a logical sta
tement which is either true or false. The condition usually consists o
f some combination of equalities or inequalities but other logical exp
ressions are available as above. Statement seq_1 is executed if the co
ndition is true whereas statement seq_2 is executed if the condition i
s false. Note that the if structure must always end with the \"end if
\" or \"fi\" statement." }}{PARA 308 "" 0 "" {TEXT -1 0 "" }}{PARA 
309 "" 0 "" {TEXT -1 9 "Example:\n" }}{PARA 310 "> " 0 "" {MPLTEXT 1 
0 13 "x:=234352341;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%\"xG\"*TBNM#
" }}}{EXCHG {PARA 311 "> " 0 "" {MPLTEXT 1 0 132 "\nif isprime(x) then
\n   print(`x is a prime number`);\nelse\n   print(`x is not prime`);
\n   print(`x has factors `,ifactor(x));\nend if;" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#%/x~is~not~primeG" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$%/
x~has~factors~G*&)-%!G6#\"\"$\"\"#\"\"\"-F'6#\")\\\"Rg#F+" }}}{EXCHG 
{PARA 318 "" 0 "" {TEXT -1 0 "" }}{PARA 318 "" 0 "" {TEXT -1 85 "ifact
or is a Maple command that finds all of the integer factors of a given
 integer.\n" }}}{EXCHG {PARA 0 "> " 0 "" {MPLTEXT 1 0 0 "" }}}{EXCHG 
{PARA 320 "" 0 "" {TEXT -1 0 "" }}{PARA 320 "" 0 "" {TEXT 262 17 "if -
 elif - else." }{TEXT -1 84 " Maple also supports the elif command all
owing k-1 conditions to be tested together:" }}{PARA 321 "" 0 "" 
{TEXT -1 0 "" }}{PARA 322 "" 0 "" {TEXT -1 22 "> if condition_1 then \+
" }}{PARA 323 "" 0 "" {TEXT -1 20 ">   statement seq_1;" }}{PARA 324 "
" 0 "" {TEXT -1 23 "> elif condition_2 then" }}{PARA 325 "" 0 "" 
{TEXT -1 20 ">   statement seq_2;" }}{PARA 326 "" 0 "" {TEXT -1 12 "> \+
         ." }}{PARA 327 "" 0 "" {TEXT -1 12 ">          ." }}{PARA 
328 "" 0 "" {TEXT -1 6 "> else" }}{PARA 329 "" 0 "" {TEXT -1 20 ">   s
tatement seq_k;" }}{PARA 330 "" 0 "" {TEXT -1 9 "> end if;" }}}{EXCHG 
{PARA 333 "" 0 "" {TEXT -1 0 "" }}{PARA 415 "" 0 "" {TEXT 263 19 "Repe
tition in Maple" }}{PARA 333 "" 0 "" {TEXT -1 0 "" }}{PARA 333 "" 0 "
" {TEXT -1 36 "Maple supports two forms of do loop." }}{PARA 0 "" 0 "
" {TEXT -1 0 "" }}{PARA 334 "" 0 "while" {TEXT 264 10 "while - do" }
{TEXT -1 76 ":  Repetition while you wait for a condition to be satisf
ied is obtained by:" }}{PARA 335 "" 0 "" {TEXT -1 0 "" }}{PARA 336 "" 
0 "" {TEXT -1 20 "> while condition do" }}{PARA 337 "" 0 "" {TEXT -1 
23 ">   statement sequence;" }}{PARA 338 "" 0 "" {TEXT -1 19 "> end do
;  (or od;)" }}{PARA 339 "" 0 "" {TEXT -1 0 "" }}{PARA 340 "" 0 "" 
{TEXT -1 154 "where the do loop continues executing provided the logic
al condition is true. Notice that the do loop must terminate with the \+
\"end do\" or \"od\"  statement." }}{PARA 341 "" 0 "" {TEXT -1 0 "" }}
{PARA 342 "" 0 "" {TEXT -1 49 "Example: Find the first prime larger th
an 10000.\n" }}{PARA 343 "> " 0 "" {MPLTEXT 1 0 11 "n := 10001;" }}
{PARA 11 "" 1 "" {XPPMATH 20 "6#>%\"nG\"&,+\"" }}}{EXCHG {PARA 344 "> \+
" 0 "" {MPLTEXT 1 0 45 "while  not  isprime(n)  do \nn:= n+2; \nend do
;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%\"nG\"&.+\"" }}{PARA 11 "" 1 "
" {XPPMATH 20 "6#>%\"nG\"&0+\"" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%\"
nG\"&2+\"" }}}{EXCHG {PARA 346 "" 0 "" {TEXT -1 0 "" }}{PARA 346 "" 0 
"" {TEXT -1 76 "The do loop terminates with the last value of n:=10007
  which must be prime." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}}{EXCHG 
{PARA 348 "" 0 "do" {TEXT 265 9 "for - do:" }{TEXT -1 127 " Here the d
o loop continues while an integer index i beginning with value start i
s incremented by value change to value finish:" }}{PARA 349 "" 0 "" 
{TEXT -1 0 "" }}{PARA 350 "" 0 "" {TEXT -1 41 "> for i from start by c
hange to finish do" }}{PARA 351 "" 0 "" {TEXT -1 23 ">   statement seq
uence;" }}{PARA 352 "" 0 "" {TEXT -1 9 "> end do;" }}{PARA 353 "" 0 "
" {TEXT -1 0 "" }}{PARA 354 "" 0 "" {TEXT -1 72 "If no change is speci
fied then an increment of +1 is assumed by default." }}{PARA 355 "" 0 
"" {TEXT -1 0 "" }}{PARA 356 "" 0 "" {TEXT -1 9 "Example:\n" }}{PARA 
357 "> " 0 "" {MPLTEXT 1 0 57 "for i from 2 by 3 to 10 do\n  print(`in
dex is`,i);\nend do;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$%)index~isG\"
\"#" }}{PARA 11 "" 1 "" {XPPMATH 20 "6$%)index~isG\"\"&" }}{PARA 11 "
" 1 "" {XPPMATH 20 "6$%)index~isG\"\")" }}}{EXCHG {PARA 361 "" 0 "" 
{TEXT -1 0 "" }}{PARA 361 "" 0 "" {TEXT -1 82 "The index begins at 2 a
nd increments by 3 until the finishing value 10 is exceeded" }}{PARA 
362 "" 0 "" {TEXT -1 0 "" }}{PARA 363 "" 0 "" {TEXT -1 93 "The for and
 while structures can be used together. Repeating the prime example ab
ove we have:" }}{PARA 364 "" 0 "" {TEXT -1 0 "" }}{PARA 365 "> " 0 "" 
{MPLTEXT 1 0 57 "for n from 10001 by 2 while not(isprime(n)) do  \nend
 do;\n" }}}{EXCHG {PARA 366 "> " 0 "" {MPLTEXT 1 0 2 "n;" }}{PARA 11 "
" 1 "" {XPPMATH 20 "6#\"&2+\"" }}}{EXCHG {PARA 368 "" 0 "" {TEXT -1 0 
"" }}{PARA 417 "" 0 "op" {TEXT 266 28 "Do Loops Indexed by Operands" }
}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 368 "" 0 "" {TEXT -1 92 "Do loo
ps can also be defined where the index x runs over the operands of a g
iven expression." }}{PARA 369 "" 0 "" {TEXT -1 0 "" }}{PARA 370 "" 0 "
" {TEXT -1 24 "> for x in expression do" }}{PARA 371 "" 0 "" {TEXT -1 
23 ">   statement sequence;" }}{PARA 372 "" 0 "" {TEXT -1 9 "> end do;
" }}{PARA 373 "" 0 "" {TEXT -1 0 "" }}}{EXCHG {PARA 375 "" 0 "" {TEXT 
-1 127 "The index runs over all the elements of op(expression), the op
erands of the expression at the top level of the expression tree." }}
{PARA 376 "" 0 "" {TEXT -1 0 "" }}{PARA 377 "" 0 "" {TEXT -1 83 "Examp
le: For a given set, find a new set consisting of the squares of all e
lements." }}{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 378 "> " 0 "" 
{MPLTEXT 1 0 27 "Set:=\{log(4*u),2,-3,1/2,3\};" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#>%$SetG<'!\"$\"\"#\"\"$#\"\"\"F'-%#lnG6#,$*&\"\"%F*%\"u
GF*F*" }}}{EXCHG {PARA 379 "> " 0 "" {MPLTEXT 1 0 11 "NewSet:=\{\};" }
}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%'NewSetG<\"" }}}{EXCHG {PARA 380 ">
 " 0 "" {MPLTEXT 1 0 53 "for x in Set do\n  NewSet:=NewSet union \{x^2
\};\nend do;" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%'NewSetG<#\"\"*" }}
{PARA 11 "" 1 "" {XPPMATH 20 "6#>%'NewSetG<$\"\"%\"\"*" }}{PARA 11 "" 
1 "" {XPPMATH 20 "6#>%'NewSetG<$\"\"%\"\"*" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#>%'NewSetG<%\"\"%\"\"*#\"\"\"F&" }}{PARA 11 "" 1 "" 
{XPPMATH 20 "6#>%'NewSetG<&\"\"%\"\"*#\"\"\"F&*$)-%#lnG6#,$*&F&F)%\"uG
F)F)\"\"#F)" }}}{EXCHG {PARA 383 "" 0 "" {TEXT -1 0 "" }}{PARA 383 "" 
0 "" {TEXT 267 15 "Another Example" }{TEXT -1 219 ": Find the critical
 points of a given function of one variable f(x)=x^4-3*x^2+1. We use t
he operand do loop to extract the roots of df/dx=0 and then test the s
ign of d^2f/dx^2 to to find the type of the critical point.\n" }}
{PARA 384 "> " 0 "" {MPLTEXT 1 0 25 "restart:f:=x^4-3*x^3+x+1;" }}
{PARA 11 "" 1 "" {XPPMATH 20 "6#>%\"fG,**$)%\"xG\"\"%\"\"\"F**&\"\"$F*
)F(F,F*!\"\"F(F*F*F*" }}}{EXCHG {PARA 385 "> " 0 "" {MPLTEXT 1 0 31 "f
x:=diff(f,x);fxx:=diff(f,x,x);" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%#f
xG,(*&\"\"%\"\"\")%\"xG\"\"$F(F(*&\"\"*F()F*\"\"#F(!\"\"F(F(" }}{PARA 
11 "" 1 "" {XPPMATH 20 "6#>%$fxxG,&*&\"#7\"\"\")%\"xG\"\"#F(F(*&\"#=F(
F*F(!\"\"" }}}{EXCHG {PARA 386 "> " 0 "" {MPLTEXT 1 0 23 "fsolve(fx,x,
maxsols=3);" }}{PARA 11 "" 1 "" {XPPMATH 20 "6%$!+JGcBJ!#5$\"+hr!4k$F%
$\"+nbE)>#!\"*" }}}{EXCHG {PARA 387 "> " 0 "" {MPLTEXT 1 0 11 "crpts:=
\{%\};" }}{PARA 11 "" 1 "" {XPPMATH 20 "6#>%&crptsG<%$\"+nbE)>#!\"*$!+
JGcBJ!#5$\"+hr!4k$F+" }}}{EXCHG {PARA 388 "" 0 "" {TEXT -1 96 "\nThese
 are the critical points of f(x). Now test each in turn to find nature
 of critical point:\n" }}{PARA 389 "> " 0 "" {MPLTEXT 1 0 17 "for p in
 crpts do" }}{PARA 390 "> " 0 "" {MPLTEXT 1 0 23 "   fxxp:=subs(x=p,fx
x);" }}{PARA 391 "> " 0 "" {MPLTEXT 1 0 17 "   if fxxp>0 then" }}
{PARA 392 "> " 0 "" {MPLTEXT 1 0 53 "      print(p,`a local minimum wi
th f=`,subs(x=p,f));" }}{PARA 393 "> " 0 "" {MPLTEXT 1 0 20 "   elif f
xxp<0 then " }}{PARA 394 "> " 0 "" {MPLTEXT 1 0 53 "      print(p,`a l
ocal maximum with f=`,subs(x=p,f));" }}{PARA 395 "> " 0 "" {MPLTEXT 1 
0 7 "   else" }}{PARA 396 "> " 0 "" {MPLTEXT 1 0 49 "      print(p,`un
kown type with f=`,subs(x=p,f));" }}{PARA 397 "> " 0 "" {MPLTEXT 1 0 
10 "   end if:" }}{PARA 398 "> " 0 "" {MPLTEXT 1 0 7 "end do:" }}
{PARA 11 "" 1 "" {XPPMATH 20 "6%$\"+nbE)>#!\"*%8a~local~minimum~with~f
=G$!+LxU=`F%" }}{PARA 11 "" 1 "" {XPPMATH 20 "6%$!+JGcBJ!#5%8a~local~m
inimum~with~f=G$\"+uS*e)yF%" }}{PARA 11 "" 1 "" {XPPMATH 20 "6%$\"+hr!
4k$!#5%8a~local~maximum~with~f=G$\"+y&poB\"!\"*" }}}{EXCHG {PARA 399 "
