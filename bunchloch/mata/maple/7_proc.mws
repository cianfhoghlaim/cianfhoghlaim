256 3 "7. " }{TEXT -1 19 "Procedures in MAPLE" }{TEXT 257 1 " " }}
{PARA 0 "" 0 "" {TEXT -1 0 "" }}{EXCHG {PARA 0 "" 0 "" {TEXT -1 65 "Ba
sic and advanced aspects of procedures are discussed including:" }}
{PARA 0 "" 0 "" {TEXT -1 0 "" }}{PARA 0 "" 0 "" {HYPERLNK 17 "proc..en
d proc " 1 "" "proc" }{TEXT -1 3 " , " }}{PARA 0 "" 0 "" {HYPERLNK 17 
"RETURN" 1 "" "return" }{TEXT -1 2 " ," }}{PARA 0 "" 0 "" {HYPERLNK 
17 "local and global variables" 1 "" "local" }{TEXT -1 3 " , " }}
{PARA 0 "" 0 "" {HYPERLNK 17 "ERROR" 1 "" "error" }{TEXT -1 3 " , " }}
{PARA 0 "" 0 "" {HYPERLNK 17 "type declarations " 1 "" "type" }{TEXT 
