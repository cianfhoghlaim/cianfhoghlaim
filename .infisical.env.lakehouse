# =============================================================================
# LAKEHOUSE - Environment Variables (canonical 6-file GOLD_STANDARD member)
# =============================================================================
# Per the 2026-08-24-lakehouse-stack-doctor-and-env-var-cleanup-v1 change.
#
# This file is the CANONICAL list of lakehouse-specific Infisical URIs. The
# root `.infisical.env` file references this sub-file via header comment.
#
# `scripts/init-vault.ts` still reads the root `.infisical.env` (the sub-files
# are documentation only — a future PR will update init-vault.ts to merge them).
#
# To update a lakehouse env var:
#   1. Update THIS file
#   2. Update the matching key in root `.infisical.env` (init-vault.ts parses both)
#   3. Update `bonneagar/stacks/lakehouse/secrets.env` (the Locket template)
#   4. Update `bonneagar/stacks/lakehouse/compose.yaml` if adding new env vars
# =============================================================================

# -----------------------------------------------------------------------------
# Garage S3 Storage (consumed by Garage container + Lance + Lakekeeper)
# -----------------------------------------------------------------------------
GARAGE_RPC_SECRET=infisical://dev-baile/lakehouse-garage/rpc_secret
GARAGE_ADMIN_TOKEN=infisical://dev-baile/lakehouse-garage/admin_token
GARAGE_ACCESS_KEY_ID=infisical://dev-baile/lakehouse-garage/access_key_id
GARAGE_SECRET_ACCESS_KEY=infisical://dev-baile/lakehouse-garage/secret_access_key

# -----------------------------------------------------------------------------
# Centralised Postgres (shared lakehouse-postgres — 14 databases)
# -----------------------------------------------------------------------------
# Superuser password (the existing `lakekeeper` user). Used by:
#   - Lakekeeper (ducklake_* databases)
#   - Dagster (dagster_local database)
#   - Olake (olake_state database)
#   - Nimtable (nimtable database)
#   - langfuse (lakehouse.langfuse database)
#   - mlflow (lakehouse.mlflow database)
#   - litellm (lakehouse.litellm database)
#   - cognee (cognee_cianfhoghlaim database — also uses dedicated cognee user)
POSTGRES_PASSWORD=infisical://dev-baile/lakehouse/postgres_password

# -----------------------------------------------------------------------------
# Lakekeeper (Iceberg REST Catalog)
# -----------------------------------------------------------------------------
# 64-character hex encryption key for Lakekeeper secrets storage
LAKEKEEPER_ENCRYPTION_KEY=infisical://dev-baile/lakehouse/encryption_key

# -----------------------------------------------------------------------------
# ClickHouse (Centralised Columnar Engine — consumed by langfuse)
# -----------------------------------------------------------------------------
CLICKHOUSE_PASSWORD=infisical://dev-baile/lakehouse-clickhouse/password

# -----------------------------------------------------------------------------
# Redis (Centralised Queue/Cache — consumed by langfuse)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=infisical://dev-baile/lakehouse-redis/password

# -----------------------------------------------------------------------------
# DuckLake (storage layer for BIEP v3)
# -----------------------------------------------------------------------------
DUCKLAKE_POSTGRES_PASSWORD=infisical://dev-baile/dagster/ducklake_postgres_password

# -----------------------------------------------------------------------------
# MotherDuck (cloud DuckDB — consumed by BIEP MotherDuck Dives)
# -----------------------------------------------------------------------------
# CHANGED 2026-08-01 (lakehouse-and-reproducible-deploy-v1):
#   Canonical path is dev-baile/motherduck/token (also exported by oideachais).
#   This single-token path prevents the BIEP v3 MotherDuck Flights from
#   racing between two Infisical entries.
MOTHERDUCK_TOKEN=infisical://dev-baile/motherduck/token

# -----------------------------------------------------------------------------
# PlanetScale (optional override for managed Postgres)
# -----------------------------------------------------------------------------
# When PLANETSCALE_DATABASE_URL is set, the lakehouse-postgres container is
# bypassed entirely (Lakekeeper + Nimtable + Dagster connect to managed
# PlanetScale). For local dev, leave unset (defaults to lakehouse-postgres).
# PLANETSCALE_DATABASE_URL=infisical://dev-baile/lakehouse/planetscale_database_url

# -----------------------------------------------------------------------------
# Olake CDC engine (consumed by BIEP pipeline)
# -----------------------------------------------------------------------------
OLAKE_JDBC_PASSWORD=infisical://dev-baile/lakehouse/jdbc_password
OLAKE_SOURCE_PG_PASSWORD=infisical://dev-baile/lakehouse/source_pg_password
OLAKE_WRITER_S3_SECRET_KEY=infisical://dev-baile/lakehouse/writer_s3_secret_key

# -----------------------------------------------------------------------------
# LanceDB (vector storage — consumed by BIEP CocoIndex Apps)
# -----------------------------------------------------------------------------
LANCEDB_API_KEY=infisical://dev-baile/lancedb/api_key
LANCEDB_NAMESPACE_TOKEN=infisical://dev-baile/lancedb/namespace_token

# -----------------------------------------------------------------------------
# Cloudflare R2 (optional — for cloud storage)
# -----------------------------------------------------------------------------
# S3-compatible cloud storage for production deployments
# R2_ACCESS_KEY_ID=infisical://dev-baile/cloudflare-r2/access_key_id
# R2_SECRET_ACCESS_KEY=infisical://dev-baile/cloudflare-r2/secret_access_key
# R2_REGION=auto
