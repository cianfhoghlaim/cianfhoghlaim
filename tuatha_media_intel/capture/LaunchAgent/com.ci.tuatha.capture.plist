<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- launchd plist for the tuatha-capture daemon.
         Install:
           cp com.ci.tuatha.capture.plist ~/Library/LaunchAgents/
           launchctl load -w ~/Library/LaunchAgents/com.ci.tuatha.capture.plist

         The binary path assumes mise-style release build at
         $HOME/.tuatha/bin/tuatha-capture. Override with TUATHA_CAPTURE_BIN
         env var in the plist's EnvironmentVariables. -->
    <key>Label</key>
    <string>com.ci.tuatha.capture</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/cianmacandeisigh/.tuatha/bin/tuatha-capture</string>
        <string>daemon</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- The daemon needs Screen Recording + Accessibility (Phase 2 Hermes).
         If these are revoked, the daemon logs the error and pauses. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>TUATHA_CAPTURE_SOCKET</key>
        <string>/tmp/tuatha-capture.sock</string>
        <key>TUATHA_HERMES_ENABLED</key>
        <string>false</string>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/cianmacandeisigh/Library/Logs/tuatha/capture.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cianmacandeisigh/Library/Logs/tuatha/capture.err.log</string>

    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
