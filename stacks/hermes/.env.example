# =============================================================================
# HERMES — Local Development Environment
# =============================================================================
# Copy this file to .env.local and edit values as needed.
# For production, secrets come from Locket/Infisical via sidecar.yaml.
#
# Usage: cp .env.example .env.local
# Then: docker compose -f compose.yaml -f sidecar.yaml up -d
#
# All values that resolve to "infisical://dev-baile/..." URIs are populated
# at runtime by the Locket sidecar. Only put non-secret defaults here.
# =============================================================================

# =============================================================================
# Gateway
# =============================================================================
HERMES_PORT=9119
HERMES_MCP_PORT=9120
HERMES_LOG_LEVEL=info

# =============================================================================
# Auth model
# =============================================================================
# 3-layer auth:
#   1. Pangolin TinyAuth (Pocket ID OIDC) — required by the Traefik route
#   2. config/hermes.yaml users.allowlist — operator's Pocket ID subject
#   3. config/hermes.yaml channels.<name>.allow_from — per-channel sender allowlist
#
# The HERMES_OPERATOR_POCKET_ID_SUBJECT env var below is used at container
# start to populate users.allowlist from day one. The init-allowlist.sh
# script is run as a one-shot init container at deploy time to add the
# subject to the allowlist via the admin API.
HERMES_OPERATOR_POCKET_ID_SUBJECT=

# =============================================================================
# Channels (3 enabled in v1; no overlap with OpenClaw)
# =============================================================================
# HERMES_ENABLE_TELEGRAM=true
# HERMES_ENABLE_DISCORD=true
# HERMES_ENABLE_WEBCHAT=true
# OpenClaw owns: WhatsApp, Slack, MS Teams (no overlap)

# =============================================================================
# Public hostname (used by pangolin.yaml blueprint)
# =============================================================================
PANGOLIN_DOMAIN=hermes.cianfhoghlaim.ie
