# =============================================================================
# UNSTRACT - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar (see sidecar.yaml).
#
# Replaces the legacy Jinja `{{ infisical://... }}` form (forbidden by
# agent-observability §"Infisical URI Format Conformance") with the
# canonical `infisical://dev-baile/<svc>/<key>` Locket format.
#
# Covers the 15-service OSS fleet (per Zipstack/unstract v0.177.7):
#   6 unstract/* images: backend, frontend, platform-service,
#                        x2text-service, runner, worker-unified
#   6 worker-unified variants: metrics, ide-callback, api-deployment,
#                              callback, file-processing, general,
#                              notification, log-consumer, scheduler,
#                              executor
#   5 infrastructure: postgres, redis, minio, qdrant, rabbitmq
#   1 supporting: celery-beat, celery-flower, flipt (feature-flag)
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (db) — 4 secrets
# ---------------------------------------------------------------------------
POSTGRES_USER=infisical://dev-baile/unstract/postgres_user
POSTGRES_PASSWORD=infisical://dev-baile/unstract/postgres_password
POSTGRES_DB=infisical://dev-baile/unstract/postgres_db
POSTGRES_SCHEMA=infisical://dev-baile/unstract/postgres_schema

# ---------------------------------------------------------------------------
# MinIO (object storage) — 4 secrets
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=infisical://dev-baile/unstract/minio_root_user
MINIO_ROOT_PASSWORD=infisical://dev-baile/unstract/minio_root_password
MINIO_ACCESS_KEY=infisical://dev-baile/unstract/minio_access_key
MINIO_SECRET_KEY=infisical://dev-baile/unstract/minio_secret_key

# ---------------------------------------------------------------------------
# Qdrant (vector DB) — 3 secrets
# ---------------------------------------------------------------------------
QDRANT_USER=infisical://dev-baile/unstract/qdrant_user
QDRANT_PASS=infisical://dev-baile/unstract/qdrant_pass
QDRANT_DB=infisical://dev-baile/unstract/qdrant_db

# ---------------------------------------------------------------------------
# RabbitMQ (Celery broker) — 2 secrets
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=infisical://dev-baile/unstract/rabbitmq_user
RABBITMQ_DEFAULT_PASS=infisical://dev-baile/unstract/rabbitmq_pass

# ---------------------------------------------------------------------------
# Django SECRET_KEY (required for backend session signing)
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=infisical://dev-baile/unstract/django_secret_key

# ---------------------------------------------------------------------------
# Celery / Worker config
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=infisical://dev-baile/unstract/celery_broker_url
CELERY_RESULT_BACKEND=infisical://dev-baile/unstract/celery_result_backend

# ---------------------------------------------------------------------------
# OAuth / SSO (optional — populated if Unstract is configured for OAuth)
# ---------------------------------------------------------------------------
OAUTH_GOOGLE_CLIENT_ID=infisical://dev-baile/unstract/google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=infisical://dev-baile/unstract/google_client_secret

# ---------------------------------------------------------------------------
# LLM provider API keys (the unstract service uses these for
# pipeline execution — many are optional)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=infisical://dev-baile/unstract/openai_api_key
ANTHROPIC_API_KEY=infisical://dev-baile/unstract/anthropic_api_key
GEMINI_API_KEY=infisical://dev-baile/unstract/gemini_api_key

# ---------------------------------------------------------------------------
# Optional Tool Registry (path-mounted in compose, not a Locket secret)
# TOOL_REGISTRY_CONFIG_SRC_PATH is already in compose.yaml
# ---------------------------------------------------------------------------