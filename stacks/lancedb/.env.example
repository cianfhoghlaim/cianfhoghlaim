# =============================================================================
# LANCEDB - Environment Variable Catalogue
# =============================================================================
# Documents every ${VAR} reference in lancedb/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     `docker compose -f compose.yaml -f compose.dev.yaml -f sidecar.yaml up -d`
#   For production: rely on Locket (no .env needed).
#
# The lancedb stack has 2 profiles:
#   - default (port 8080) — the LanceDB Viewer web UI
#   - s3       (optional) — enables the rclone S3/R2 mounter sidecar
# =============================================================================

# =============================================================================
# LanceDB Viewer (the only required var)
# =============================================================================
LANCEDB_PORT=8081

# =============================================================================
# Cloud storage (optional; only used by the `s3` profile / lancedb-s3-mounter)
# =============================================================================
# Real keys come from Locket. Dev placeholders below for local `.env`.
R2_BUCKET=lance-embeddings
RCLONE_PROVIDER=Cloudflare
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=

# =============================================================================
# FUSE mount point (where the s3 mounter binds the cloud bucket)
# =============================================================================
LANCE_MOUNT_POINT=./lance_mount_point

# =============================================================================
# LanceDB Cloud (optional; for hosted LanceDB instead of self-hosted viewer)
# =============================================================================
# LANCEDB_API_KEY=
LANCEDB_REGION=us-east-1
LANCEDB_USE_CLOUD=false

# =============================================================================
# Infisical + Locket
# =============================================================================
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch