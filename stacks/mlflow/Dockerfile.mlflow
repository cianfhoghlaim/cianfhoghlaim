# =============================================================================
# Custom MLflow image with psycopg2-binary + boto3 pre-baked.
# Eliminates the 30s pip install on first boot.
#
# Pinned 2026-07-02 (was `ghcr.io/cianfhoghlaim/mlflow:v2.19.0` — the
# org-private image is replaced with the public upstream
# `ghcr.io/mlflow/mlflow:v3.12.0` per user directive "use typical
# public images". The compose.yaml was bumped to v3.12.0 in the
# upgrade-4-stacks-with-infisical change (2026-07-06); this Dockerfile
# is bumped to match as part of the 2026-07-08 pick-3-image-replacement
# change so the local build is consistent with the compose.yaml
# pin.
#
# Multi-arch: build with
#   docker buildx build --platform=linux/amd64,linux/arm64 \
#     -t mlflow-local:v3.12.0 -f Dockerfile.mlflow .
# supports both arm1-oci (arm64) and bunchloch (arm64) plus any
# future x86_64 hosts.
#
# Build:
#   docker build -t mlflow-local:v3.12.0 -f Dockerfile.mlflow .
#
# The compose.yaml uses `image: ghcr.io/mlflow/mlflow:v3.12.0` with
# `build: .` so the local build re-tags the public image with the
# pre-baked deps (no need to use a private org image).
# =============================================================================

FROM --platform=$BUILDPLATFORM ghcr.io/mlflow/mlflow:v3.12.0

# Pre-bake the Postgres + S3 client libraries needed for the
# centralise-data-plane architecture. Reduces cold start by ~30s.
RUN pip install --no-cache-dir \
      psycopg2-binary \
      boto3

# Re-declare the entrypoint (inherits from upstream, but make explicit)
# MLflow server is started by the docker-compose `command:` block.
ENTRYPOINT []
