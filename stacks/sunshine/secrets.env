# =============================================================================
# Sunshine - Locket Secrets Template
# =============================================================================
# Template file for Locket secret injection.
# Uses Infisical URI references (infisical://dev-baile/<svc>/<key>).
# =============================================================================

# Game streaming credentials
SUNSHINE_USER={{ infisical:///username?path=/sunshine }}
SUNSHINE_PASS={{ infisical:///password?path=/sunshine }}

# Timezone
TZ=Europe/Dublin
