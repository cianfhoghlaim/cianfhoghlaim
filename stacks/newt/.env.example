# =============================================================================
# NEWT - Local development environment variables (NOT secrets)
# =============================================================================
# Copy this file to .env and edit values as needed for local dev.
# Real secrets (NEWT_ID + NEWT_SECRET + PERIPHERY_ONBOARDING_KEY) come
# from Infisical dev-baile vault via Locket, NOT from this file.
# =============================================================================

# Path to the Infisical machine identity secret file
# (mounted into the locket sidecar as /run/secrets/infisical_secret)
INFISICAL_SECRET_FILE=./secrets/infisical_secret

# Path to the Locket secrets templates dir
LOCKET_TEMPLATES_DIR=./secrets/templates

# Comma-separated list of secrets to watch in Infisical (optional)
# LOCKET_SECRETS=NEWT_ID,NEWT_SECRET,PERIPHERY_ONBOARDING_KEY

# Newt log level
NEWT_LOG_LEVEL=info

# Periphery connection (defaults are fine for bunchloch)
PERIPHERY_CORE_ADDRESS=wss://komodo.cianfhoghlaim.ie
PERIPHERY_CONNECT_AS=bunchloch
