# =============================================================================
# CROILAR - Environment Variable Catalogue
# =============================================================================
# Generated by scripts/generate-stack-env-example.ts on 2026-07-08T17:46:34.716Z
#
# Documents every ${VAR} reference in croilar/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     docker compose -f compose.yaml -f sidecar.yaml up -d
#   For production: rely on Locket (no .env needed).
#
# The real values are stored in the dev-baile Infisical vault;
# the Locket sidecar injects them at container runtime.
# =============================================================================

