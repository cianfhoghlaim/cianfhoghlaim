# =============================================================================
# INFISICAL - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# NOTE: Infisical itself does NOT use a Locket sidecar — the file is
# kept for documentation parity with the other 85 stacks. The db + redis
# services read env vars directly from compose.yaml's `env_file: .env`.
#
# Updated 2026-07-06 for `deploy-infisical-bunchloch-local`:
# - Removed all Jinja `{{ ... }}` wrappers (forbidden by
#   agent-observability §"Infisical URI Format Conformance").
# - These keys exist for symmetry with the consumer stacks; they may be
#   useful for downstream tooling that reads this file (e.g. the seed
#   script).
# =============================================================================

# Encryption + auth (the 2 most critical secrets — 16-byte hex + 32-byte base64)
ENCRYPTION_KEY=infisical://dev-baile/infisical/encryption_key
AUTH_SECRET=infisical://dev-baile/infisical/auth_secret

# Database (only the password is secret; the username is `infisical`)
POSTGRES_PASSWORD=infisical://dev-baile/infisical/postgres_password
POSTGRES_USER=infisical://dev-baile/infisical/postgres_user
POSTGRES_DB=infisical://dev-baile/infisical/postgres_db

# Redis (no password in the local dev variant)
REDIS_URL=infisical://dev-baile/infisical/redis_url

# Public-facing URL (also a secret to keep prod/preview separate)
SITE_URL=infisical://dev-baile/infisical/site_url

# Locket machine identity (consumed by the 4 consumer stacks in Change 2)
INFISICAL_CLIENT_ID=infisical://dev-baile/infisical/client_id
INFISICAL_CLIENT_SECRET=infisical://dev-baile/infisical/client_secret
INFISICAL_PROJECT_ID=infisical://dev-baile/infisical/project_id