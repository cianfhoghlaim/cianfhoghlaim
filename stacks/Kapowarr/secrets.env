# =============================================================================
# KAPOWARR - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# This stack's compose.yaml declares no runtime secret env vars; the
# file is a placeholder that satisfies the stack-doctor
# "must-have-secrets-env" gate + locks the LOCKET_MODE=watch header.
# To add a secret, append `KEY=infisical://dev-baile/Kapowarr/KEY`
# and register the value in the dev-baile Infisical project
# (path `/Kapowarr`).
# =============================================================================

# NOTE: Kapowarr compose.yaml only sets PUID, PGID, and TZ (non-secret
# runtime config). All secrets (API keys for indexer services) are

LOCKET_MODE=watch
# Example reference (canonical v4 contract — never resolves a real value):
# KAPOWARR_EXAMPLE_KEY=infisical://dev-baile/Kapowarr/example_key
