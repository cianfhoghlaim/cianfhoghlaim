# Langfuse dev secrets (dev mode only — NEVER commit anything other than dev values)
#
# Langfuse v3 uses 4 lakehouse services:
#   - lakehouse-postgres (db=langfuse) for the application DB
#   - lakehouse-redis for the ingestion queue
#   - lakehouse-clickhouse for the columnar event store
#   - lakehouse-garage (3 buckets: langfuse-events/-media/-exports) for S3

# Lakehouse Postgres (db=langfuse)
DATABASE_URL=postgresql://lakekeeper:devpassword@lakehouse-postgres:5432/langfuse
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword

# Lakehouse Redis (REDIS_HOST=lakehouse-redis is the docker DNS)
REDIS_HOST=lakehouse-redis
REDIS_PORT=6379
REDIS_AUTH=devpassword

# Lakehouse ClickHouse
CLICKHOUSE_MIGRATION_URL=clickhouse://lakehouse-clickhouse:9000
CLICKHOUSE_URL=http://lakehouse-clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=devpassword
CLICKHOUSE_CLUSTER_ENABLED=false

# Lakehouse Garage (3 buckets — auto-created by lakehouse garage-init)
AWS_ACCESS_KEY_ID=GK1601dev
AWS_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
GARAGE_ACCESS_KEY_ID=GK1601dev
GARAGE_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse-events
LANGFUSE_S3_EVENT_UPLOAD_REGION=garage
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=GK1601dev
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://lakehouse-garage:3900
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse-media
LANGFUSE_S3_MEDIA_UPLOAD_REGION=garage
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=GK1601dev
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://lakehouse-garage:3900
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
LANGFUSE_S3_BATCH_EXPORT_ENABLED=false
LANGFUSE_S3_BATCH_EXPORT_BUCKET=langfuse-exports
LANGFUSE_S3_BATCH_EXPORT_PREFIX=exports/
LANGFUSE_S3_BATCH_EXPORT_REGION=garage
LANGFUSE_S3_BATCH_EXPORT_ENDPOINT=http://lakehouse-garage:3900
LANGFUSE_S3_BATCH_EXPORT_EXTERNAL_ENDPOINT=https://langfuse.cianfhoghlaim.ie
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=GK1601dev
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
LANGFUSE_S3_BATCH_EXPORT_FORCE_PATH_STYLE=true

# Dev-mode auth (Langfuse requires SALT + ENCRYPTION_KEY)
SALT=dev-salt-not-for-production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TELEMETRY_ENABLED=true
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=true
