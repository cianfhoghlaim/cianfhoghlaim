# =============================================================================
# CONVEX - Environment Variable Catalogue
# =============================================================================
# Generated by scripts/generate-stack-env-example.ts on 2026-07-08T17:46:34.716Z
#
# Documents every ${VAR} reference in convex/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     docker compose -f compose.yaml -f sidecar.yaml up -d
#   For production: rely on Locket (no .env needed).
#
# The real values are stored in the dev-baile Infisical vault;
# the Locket sidecar injects them at container runtime.
# =============================================================================

# =============================================================================
# CONVEX secrets (Locket resolves these at container runtime)
# =============================================================================

# CONVEX_INSTANCE_SECRET=<dev-baile value>
CONVEX_INSTANCE_SECRET=

# AWS_ACCESS_KEY_ID=<dev-baile value>
AWS_ACCESS_KEY_ID=

# AWS_SECRET_ACCESS_KEY=<dev-baile value>
AWS_SECRET_ACCESS_KEY=

# AWS_ENDPOINT_URL=<dev-baile value>
AWS_ENDPOINT_URL=

# CONVEX_POSTGRES_URL=<dev-baile value>
CONVEX_POSTGRES_URL=

# =============================================================================
# Infisical + Locket (canonical)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
