# Lakehouse dev secrets (dev mode only — NEVER commit anything other than dev values)
POSTGRES_PASSWORD=devpassword
CLICKHOUSE_PASSWORD=devpassword
REDIS_PASSWORD=devpassword
GARAGE_RPC_SECRET=dev-rpc-secret-32chars-min-not-for-prod
GARAGE_ADMIN_TOKEN=dev-admin-token-not-for-prod
GARAGE_ACCESS_KEY_ID=GK1601dev
GARAGE_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
LAKEKEEPER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
LANCEDB_VIEWER_ADMIN_TOKEN=dev-lancedb-viewer-token-not-for-prod

# Port remaps (dev mode only) to avoid conflicts with other stacks
# already running on bunchloch:
#   dragonfly uses 6379  → lakehouse-redis on 6390
#   lancedb   uses 8081  → lakehouse-lancedb-viewer on 8082
#   lakekeeper uses 8181 (no conflict; n/a)
#   lance-namespace uses 8182 (no conflict; n/a)
REDIS_PORT=6390
LANCEDB_VIEWER_PORT=8082
