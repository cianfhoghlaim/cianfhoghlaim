<package xmlns="http://www.idpf.org/2007/opf" unique-identifier="uid" version="3.0" xml:lang="en" prefix="calibre: https://calibre-ebook.com">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:title id="title">Origins of the the Legends and Mythologies that Inspired Robert Jordan</dc:title>
    <dc:creator id="id-1">Michael Livingston</dc:creator>
    <dc:identifier>calibre:12533</dc:identifier>
    <dc:identifier>uuid:dc09959a-cd83-44a2-a260-9f22d3288060</dc:identifier>
    <dc:identifier id="uid">9781250860545</dc:identifier>
    <dc:source id="src-id">urn:isbn:9781250860521</dc:source>
    <dc:rights>All rights reserved</dc:rights>
    <dc:language>en-US</dc:language>
    <dc:contributor id="id">calibre (4.23.0) [https://calibre-ebook.com]</dc:contributor>
    <dc:description>&lt;p&gt;&lt;b&gt;"Jordan has come to dominate the world Tolkien began to reveal." &amp;#8212;&lt;i&gt;The New York Times &lt;/i&gt;on The Wheel of Time&amp;#174; series&lt;br&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;Explore never-before-seen insights into the Wheel of Time, including:&lt;/b&gt;&lt;br&gt;&lt;b&gt;- A brand-new, redrawn world map by Ellisa Mitchell using change requests discovered in Robert Jordan's unpublished notes&lt;/b&gt;&lt;br&gt;&lt;b&gt;- An alternate scene from an early draft of &lt;i&gt;The Eye of the World&lt;/i&gt;&lt;br&gt;&lt;i&gt;- &lt;/i&gt;The long-awaited backstory of Nakomi&lt;br&gt;&lt;/b&gt;&lt;b&gt;- 8 page, full color photo insert&lt;/b&gt;&lt;br&gt;Take a deep dive into the real-world history and mythology that inspired the world of Robert Jordan's The Wheel of Time&amp;#174;. &lt;i&gt;Origins of The Wheel of Time&lt;/i&gt; is written by Michael Livingston, Secretary-General of the United States Commission on Military History and professor of medieval literature at The Citadel, with a Foreword by Harriet McDougal, Robert Jordan's editor, widow, and executor of his estate.&lt;br&gt;This companion to the internationally...</dc:description>
    <dc:publisher>Tor Publishing Group</dc:publisher>
