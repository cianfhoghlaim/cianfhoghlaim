// Commonwealth of Nations BAML cluster — re-exports.

class CommonwealthMemberState {
  ISO3  @description("ISO 3166-1 alpha-3 (lowercase) — e.g. aus, can, nzl, ind, zaf")
  NAME @description("The English-language country name")
  REGION @description("Commonwealth region — africa | asia | caribbean | europe | pacific | americas")
}
