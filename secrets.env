# =============================================================================
# OIDEACHAIS - Secrets Template (Locket)
# =============================================================================
# These op:// references are resolved by Locket at runtime
# Vault: dev-baile
#
# Create secrets in 1Password:
#   op item create --vault dev-baile --title "oideachais-llm" \
#     --category api-credential api_key="your-key"
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
LLM_API_KEY={{ op://dev-baile/oideachais-llm/api_key }}
LLM_PROVIDER={{ op://dev-baile/oideachais-llm/provider }}

# -----------------------------------------------------------------------------
# Observability (Langfuse)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY={{ op://dev-baile/langfuse/public_key }}
LANGFUSE_SECRET_KEY={{ op://dev-baile/langfuse/secret_key }}
LANGFUSE_HOST={{ op://dev-baile/langfuse/host }}

# -----------------------------------------------------------------------------
# Datadog (Optional)
# -----------------------------------------------------------------------------
DD_API_KEY={{ op://dev-baile/datadog/api_key }}
DD_SITE={{ op://dev-baile/datadog/site }}
