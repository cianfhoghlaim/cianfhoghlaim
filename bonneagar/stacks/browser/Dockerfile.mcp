# Browser MCP Server Dockerfile
# stdio MCP server wrapping the sruth_browser backends
# Per the openspec change `2026-09-06-adk-gemini-deep-research-control-plane-v1`
# (the previous compose.yaml referenced this Dockerfile but it was missing).

FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Create app directory
WORKDIR /app

# Copy project files
COPY pyproject.toml .
COPY sruth_browser/ ./sruth_browser/

# Install minimal dependencies for the stdio MCP server
RUN uv pip install --system \
    "mcp>=1.0" \
    "pydantic>=2.5" \
    "structlog>=24.0" \
    "httpx>=0.27"

# The sruth_browser.mcp.server entry point is registered as
# `sruth-browser-mcp` in pyproject.toml
ENTRYPOINT ["python", "-m", "sruth_browser.mcp.server"]
