# =============================================================================
# BROWSER - Local Development Environment
# =============================================================================
# Copy this file to .env.local and edit values as needed.
# For production, secrets come from Locket/Infisical via sidecar.yaml.
#
# Per openspec/changes/2026-08-21-complete-browserbase-archive-and-crawl4ai-mcp-v1
# Browserbase env vars are commented out by default (retained as opt-in
# fallback). Uncomment + populate to re-enable Browserbase cloud integration.
#
# Usage: cp .env.example .env.local

# =============================================================================
# Browser Stack (Patchright + Crawl4AI + Stagehand + Skyvern)
# =============================================================================
# BROWSER_CDP_URL=ws://browser-grid:9222
# BROWSER_SKYVERN_API_URL=http://skyvern:8000/api/v1
# BROWSER_CRAWL4AI_URL=http://crawl4ai:11235
# BROWSER_STAGEHAND_URL=http://stagehand-local:3100
# BROWSER_SOLVER_URL=http://solver-service:5000/turnstile

# =============================================================================
# LLM Provider API Keys (set in .env.local for dev, or via Locket/Infisical in production)
# =============================================================================
# OPENAI_API_KEY=sk-...                     # Set via Locket/Infisical in production
# ANTHROPIC_API_KEY=sk-ant-...              # Set via Locket/Infisical in production
# ZAI_API_KEY=...                           # Set via Locket/Infisical in production
# GOOGLE_API_KEY=...                        # Set via Locket/Infisical in production

# =============================================================================
# Opt-in browser backends (default OFF)
# =============================================================================
# BROWSER_ENABLE_SKYVERN=1                   # Enable Skyvern vision-based navigation
# BROWSER_ENABLE_STAGEHAND=1                 # Enable Stagehand AI-powered UI interactions
# BROWSER_ENABLE_BROWSERBASE=1               # Opt-in Browserbase cloud integration (deprecated; see notes above)

# =============================================================================
# Optional paid fallback (Firecrawl — the canonical paid MCP)
# =============================================================================
# FIRECRAWL_API_KEY=fc-...                   # Set via Locket/Infisical in production

# =============================================================================
# Optional opt-in Browserbase cloud integration (DEPRECATED 2026-08-21)
# Uncomment the next 2 lines + populate to re-enable Browserbase.
# =============================================================================
# BROWSERBASE_API_KEY=bb_...
# BROWSERBASE_PROJECT_ID=...

# =============================================================================
# Default LLM provider for Stagehand
# =============================================================================
# LLM_PROVIDER=anthropic
# OPENAI_BASE_URL=http://stagehand-proxy:4005/v1