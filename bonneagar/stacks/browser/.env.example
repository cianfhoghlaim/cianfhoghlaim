# Browser stack — environment template
# Copy this to `.env` and fill in the values, or rely on Locket sidecar
# injection from Infisical via the secrets.env file (recommended).
#
# Per the openspec change `2026-09-06-adk-gemini-deep-research-control-plane-v1`:

# Gemini Deep Research API key (REQUIRED for the new top-priority RESEARCH backend)
GOOGLE_API_KEY=

# Optional: override the Gemini Deep Research model alias
BROWSER_GEMINI_DEEP_RESEARCH_MODEL=gemini-2.5-pro-deep-research

# Stagehand proxy LLM gateway (REQUIRED)
OPENCODE_GO_API=

# LiteLLM master key
LITELLM_API_KEY=

# Paid fallback APIs (optional)
FIRECRAWL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
ZAI_API_KEY=
SKYVERN_API_KEY=

# Observability (Langfuse)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# KG integration (Cognee)
COGNEE_API_URL=
COGNEE_API_KEY=

# Storage paths
DUCKDB_PATH=/app/storage/data/browser.duckdb
LANCEDB_PATH=/app/storage/data/scraped_vectors.lance

# Network
BROWSER_NETWORK=browser_browser-net
