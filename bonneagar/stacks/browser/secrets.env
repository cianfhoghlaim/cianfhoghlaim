# =============================================================================
# BROWSER - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# Per openspec/changes/2026-08-21-complete-browserbase-archive-and-crawl4ai-mcp-v1
# Browserbase env vars are commented out by default (retained as opt-in
# fallback). Uncomment + populate to re-enable Browserbase cloud integration.
# =============================================================================

# =============================================================================
# LLM Provider API Keys (canonical backbone is LiteLLM gateway)
# =============================================================================
OPENAI_API_KEY=infisical://dev-baile/browser/openai_api_key
ANTHROPIC_API_KEY=infisical://dev-baile/browser/anthropic_api_key
ZAI_API_KEY=infisical://dev-baile/browser/zai_api_key
GOOGLE_API_KEY=infisical://dev-baile/browser/google_api_key
OPENCODE_GO_API=infisical://dev-baile/browser/opencode_go_api

# =============================================================================
# Canonical paid fallback (Firecrawl — the canonical paid MCP)
# =============================================================================
FIRECRAWL_API_KEY=infisical://dev-baile/firecrawl/api_key

# =============================================================================
# Cross-stack service URLs
# =============================================================================
LITELLM_BASE_URL=infisical://dev-baile/litellm/base_url

# =============================================================================
# Opt-in browser backends (default OFF — booleans, not Infisical refs)
# Set BROWSER_ENABLE_SKYVERN=1 / BROWSER_ENABLE_STAGEHAND=1 in your .env.local
# to enable the corresponding opt-in backend. The Infisical paths below
# are NOT used; they're documentation only.
# =============================================================================
BROWSER_ENABLE_SKYVERN=false
BROWSER_ENABLE_STAGEHAND=false

# =============================================================================
# Optional opt-in Browserbase cloud integration (DEPRECATED 2026-08-21)
# Uncomment the next 2 lines + populate to re-enable Browserbase.
# =============================================================================
# BROWSERBASE_API_KEY=infisical://dev-baile/browserbase/api_key
# BROWSERBASE_PROJECT_ID=infisical://dev-baile/browserbase/project_id

# =============================================================================
# Default LLM provider for Stagehand
# =============================================================================
LLM_PROVIDER=anthropic