# Browser stack — Cianfhoghlaim Oideachais
# Per the openspec change `2026-09-06-adk-gemini-deep-research-control-plane-v1`.
# All keys are Infisical URI refs — Locket resolves at container start.

# Gemini Deep Research API key (the new top-priority RESEARCH backend)
GOOGLE_API_KEY=infisical://dev-baile/browser/google_api_key

# Optional override for the Gemini Deep Research model alias
# (default: gemini-2.5-pro-deep-research)
# BROWSER_GEMINI_DEEP_RESEARCH_MODEL=gemini-2.5-pro-deep-research

# LiteLLM master key (the browser stack's litellm_config.yaml points here)
LITELLM_API_KEY=infisical://dev-baile/litellm/master_key

# Browser stack fallback paid APIs
FIRECRAWL_API_KEY=infisical://dev-baile/browser/firecrawl_api_key
BROWSERBASE_API_KEY=infisical://dev-baile/browser/browserbase_api_key
BROWSERBASE_PROJECT_ID=infisical://dev-baile/browser/browserbase_project_id
ZAI_API_KEY=infisical://dev-baile/browser/zai_api_key
SKYVERN_API_KEY=infisical://dev-baile/browser/skyvern_api_key

# OpenCode Go API key (the Stagehand proxy's LLM gateway)
OPENCODE_GO_API=infisical://dev-baile/browser/opencode_go_api

# Cognee + Graphiti KG integration
COGNEE_API_URL=infisical://dev-baile/cognee/api_url
COGNEE_API_KEY=infisical://dev-baile/cognee/api_key

# Langfuse observability
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key

# DuckDB local cache (browser data plane)
DUCKDB_PATH=/app/storage/data/browser.duckdb

# LanceDB vector companion (browser-scraped embeddings)
LANCEDB_PATH=/app/storage/data/scraped_vectors.lance
