# =============================================================================
# STATE-EXAMS-IE secrets.env
# =============================================================================
# Per the 6-file GOLD_STANDARD pattern. Every value is an Infisical
# `infisical://dev-baile/...` reference — no raw secrets committed.
# The Locket sidecar hydrates the values at runtime.
# =============================================================================

# The 2 SEC credentials (injected by Locket at startup)
EXAMINATIONS_IE_USERNAME=infisical://dev-baile/cianfhoghlaim/examinations-ie/username
EXAMINATIONS_IE_PASSWORD=infisical://dev-baile/cianfhoghlaim/examinations-ie/password

# The Firecrawl API key (shared with the rest of the platform)
FIRECRAWL_API_KEY=infisical://dev-baile/oideachais/firecrawl-api-key

# The vault's own binding
STATE_EXAMS_IE_PROFILE_DIR=/stedding/firecrawl_profiles/state-exams-ie