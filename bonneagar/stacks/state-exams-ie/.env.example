# state-exams-ie — the canonical .env.example
# Per the 6-file GOLD_STANDARD pattern. No raw values; just the
# structural shape that operators fill in for local dev.

# The 2 SEC credentials (must match those in the dev-baile Infisical vault)
EXAMINATIONS_IE_USERNAME=replace-with-sec-username
EXAMINATIONS_IE_PASSWORD=replace-with-sec-password

# Shared with the rest of the platform
FIRECRAWL_API_KEY=fc-replace-with-your-api-key

# The vault's filesystem path (must be writeable on the host)
STATE_EXAMS_IE_PROFILE_DIR=/tmp/state-exams-ie-dev