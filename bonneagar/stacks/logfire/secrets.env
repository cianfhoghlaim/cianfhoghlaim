# Pydantic Logfire Configuration
# OpenTelemetry-based observability for Python applications.
#
# This stack uses an OpenTelemetry Collector (compose.yaml) to receive OTLP
# traces from KCG services and forward them to:
#   1. Logfire cloud   (SaaS — https://logfire.pydantic.dev) via LOGFIRE_TOKEN
#   2. Langfuse         (self-hosted — langfuse-web:3000)   via LANGFUSE_PUBLIC_KEY + SECRET_KEY
# The fan-out is configured in config/otelcol.yaml (exporter list = [logfire, otlphttp/langfuse, debug]).
#
# Docs: https://logfire.pydantic.dev/docs/

LOGFIRE_TOKEN=infisical://dev-baile/logfire/write_token
LOGFIRE_PROJECT_NAME=oideachas-celtic-education
LOGFIRE_SERVICE_NAME=education-pipeline

# Optional: Environment tagging (consumed by the otelcol processor + exported
# as a resource attribute so the Logfire UI groups traces by environment).
LOGFIRE_ENVIRONMENT=production

# Langfuse OTLP fan-out (NEW 2026-07-30 per env-contract-and-observability-fanout-v1).
# The otlphttp/langfuse exporter in otelcol.yaml uses LANGFUSE_AUTH_HEADER (the
# base64-encoded PUBLIC_KEY:SECRET_KEY pair) as the HTTP Basic auth header.
# LANGFUSE_AUTH_HEADER is a separate Infisical secret under /logfire; the
# operator seeds it as `echo -n "$PUBLIC_KEY:$SECRET_KEY" | base64 -w0` when
# adding the langfuse creds to the vault. The Locket shim writes it to
# /run/secrets/locket/secrets.env at container start.
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key
LANGFUSE_AUTH_HEADER=infisical://dev-baile/logfire/auth_header

# Application code that wants to send traces via OTLP instead of the SDK
# should point at the local collector:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4317
# (host.docker.internal works from a host-side process; logfire-otel is the
# in-network hostname from the compose service name).
