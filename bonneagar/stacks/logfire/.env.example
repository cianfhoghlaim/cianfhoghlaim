# =============================================================================
# LOGFIRE - Environment Variable Catalogue
# =============================================================================
# Documents every ${VAR} reference in logfire/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     `docker compose -f compose.yaml -f compose.dev.yaml -f sidecar.yaml up -d`
#   For production: rely on Locket (no .env needed).
#
# NOTE: Logfire is SaaS-only (https://logfire.pydantic.dev) — the local
# `logfire-otel` service is an OpenTelemetry Collector that forwards
# traces to the Logfire cloud. The Logfire UI itself is NOT self-hosted.
# See README.md and config/otelcol.yaml for the full architecture.
# =============================================================================

# =============================================================================
# Logfire cloud forwarding (real write token comes from Locket)
# =============================================================================
# Get a write token from https://logfire.pydantic.dev → Project Settings → Tokens
LOGFIRE_TOKEN=dev-write-token-placeholder
LOGFIRE_PROJECT_NAME=oideachas-celtic-education
LOGFIRE_SERVICE_NAME=education-pipeline
LOGFIRE_ENVIRONMENT=production

# =============================================================================
# OTLP receivers (the local collector binds these)
# =============================================================================
# Application code that wants to send traces via OTLP instead of the SDK
# should point at the local collector:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4317   (gRPC, preferred)
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4318   (HTTP, fallback)
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4317

# =============================================================================
# Infisical + Locket
# =============================================================================
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch