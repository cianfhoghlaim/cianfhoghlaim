# =============================================================================
# MOTHERDUCK - Environment Variable Catalogue
# =============================================================================
# Generated by scripts/generate-stack-env-example.ts on 2026-07-08T17:51:00Z

# MotherDuck service-account token (managed DuckLake SaaS).
# Provision at https://app.motherduck.com/settings/service-accounts.
# Stored in the dev-baile Infisical vault under the motherduck/ folder.

# MOTHERDUCK_TOKEN=<dev-baile value>
MOTHERDUCK_TOKEN=

# =============================================================================
# Infisical + Locket (canonical)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
