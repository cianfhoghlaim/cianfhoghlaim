# =============================================================================
# MYLAR3 — Locket Secrets Template
# =============================================================================#
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# Mylar3 itself has no required secrets at startup (ComicVine API key,
# indexer credentials, and the qBittorrent download client are all
# configured via the Mylar3 WebUI at /config and stored in the SQLite
# database inside /config).
#
# This file is here for the rare case where you want to seed those values
# via Infisical / Locket rather than via the WebUI. Most operators can
# leave the file empty.
#
# IF YOU ADD A VALUE: create the matching secret under
#   dev-baile/mylar3/<secret-name>
# in the Infisical vault first.
# =============================================================================

# ComicVine metadata API key (free tier: https://comicvine.gamespot.com/api/)
# Optional — improves metadata quality if set; otherwise Mylar3 falls back
# to a curated subset of free providers.
COMICVINE_API_KEY={{ infisical://dev-baile/mylar3/comicvine_api_key }}
