# =============================================================================
# MYLAR3 — Environment Variable Catalogue
# =============================================================================#
# Documents every ${VAR} reference in mylar3/compose.yaml + sidecar.yaml.
#
# USAGE:
#   cp .env.example .env.local
#   edit .env.local with your dev values
#   docker compose --env-file .env.local up -d
#
# For production, Locket resolves all secrets at runtime — no .env needed.
# (See sidecar.yaml + secrets.env.)
# =============================================================================

# =============================================================================
# Mylar3 service
# =============================================================================
MYLAR_PORT=8090
PUID=1000
PGID=1000
TZ=Europe/Dublin
UMASK=022

# Bind-mounted paths (host → container)
# Default to local-relative paths so the stack works out-of-the-box.
# Override to absolute macOS paths for stable storage, e.g.:
#   COMICS_PATH=/Users/cianmacandeisigh/comics
#   DOWNLOADS_PATH=/Users/cianmacandeisigh/Downloads/comics
COMICS_PATH=./comics
DOWNLOADS_PATH=./downloads

# =============================================================================
# Infisical + Locket (canonical 3-way contract)
# =============================================================================#
# The INFISICAL_URL is intentionally pointing at the locally-running
# infisical-backend container (the `infisical` stack). This is correct
# for the bunchloch (MacBook) developer flow.
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity — injected by mise secret run>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch

# Set to a static key=value file if you're running offline
# (otherwise leave as /dev/null so locket falls back to live Infisical).
INFISICAL_FALLBACK_FILE=/dev/null
