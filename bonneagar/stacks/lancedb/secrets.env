# =============================================================================
# LANCEDB - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# Updated for the 2026-08-15-lakehouse-memory-stack change (Phase B):
# - Added `LANCEDB_NAMESPACE_TOKEN` for the Lance Namespace 0.9 contract
#   `header.<name>` context-header prefix (replaces the pre-v0.9
#   `x-lance-ctx-<name>` convention — see indexing-and-cognition R).
# - Added `LANCEDB_S3_REGION` and `LANCEDB_GARAGE_ENDPOINT` for the
#   self-hosted Garage S3 backend (the canonical Cianfhoghlaim profile).
# =============================================================================

# S3/R2 Credentials (for self-hosted storage profile)
AWS_ACCESS_KEY_ID=infisical://dev-baile/cloudflare/r2_access_key
AWS_SECRET_ACCESS_KEY=infisical://dev-baile/cloudflare/r2_secret_key
AWS_ENDPOINT_URL=infisical://dev-baile/cloudflare/r2_endpoint

# LanceDB Cloud (optional)
LANCEDB_API_KEY=infisical://dev-baile/lancedb/api_key
LANCEDB_REGION=us-east-1
LANCEDB_USE_CLOUD=false

# Lance Namespace 0.9 contract (the canonical lakehouse-lance-namespace:8182
# sidecar). The token is required for the v0.9 context-header rename
# (`header.<name>` instead of `x-lance-ctx-<name>`).
LANCEDB_NAMESPACE_TOKEN=infisical://dev-baile/lancedb/namespace_token

# Self-hosted Garage S3 backend (the canonical Cianfhoghlaim Lance profile)
LANCEDB_S3_REGION=eu-west-1
LANCEDB_GARAGE_ENDPOINT=infisical://dev-baile/lancedb/garage_endpoint
