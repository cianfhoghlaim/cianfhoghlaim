# =============================================================================
# LAKEKEEPER - Locket Secrets Template (PlanetScale PG migration)
# =============================================================================
# Per openspec/changes/2026-07-19-planetscale-postgres-migration-phase-b0-v1/
#
# Phase B.0 hard-switch: local `lakekeeper-postgres` container removed.
# Lakekeeper connects directly to PlanetScale PG via Locket.
# All values are Locket-canonical `infisical://dev-baile/lakekeeper/...` URIs
# resolved at container start by the Locket sidecar (see sidecar.yaml).
#
# Pre-requisites (operator creates these via the Infisical dashboard):
#   1. dev-baile/lakekeeper/database_url   → "postgresql://<user>:<pwd>@eu-west-3.pg.psdb.cloud/lakekeeper?sslmode=verify-full"
#   2. dev-baile/lakekeeper/encryption_key → a 64-char hex key (Lakekeeper catalog encryption)
# =============================================================================

# PlanetScale PG — Locket-injected from Infisical
LAKEKEEPER_DATABASE_URL=infisical://dev-baile/lakekeeper/database_url
LAKEKEEPER_ENCRYPTION_KEY=infisical://dev-baile/lakekeeper/encryption_key

# MinIO (UNCHANGED)
MINIO_ROOT_USER=infisical://dev-baile/lakekeeper/minio_root_user
MINIO_ROOT_PASSWORD=infisical://dev-baile/lakekeeper/minio_root_password

# Optional ports (UNCHANGED)
LAKEKEEPER_PORT=8181
LAKEKEEPER_METRICS_PORT=9100
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003
JUPYTER_PORT=8888
LAKEKEEPER_BASE_URI=http://localhost:8181
RUST_LOG=info