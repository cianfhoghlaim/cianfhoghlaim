# =============================================================================
# INFISICAL - .env.dev Template (bunchloch local dev)
# =============================================================================
# Copy this file to .env.dev and fill in the 5 required secrets with
# `openssl rand ...` values. NEVER commit .env.dev.
#
# Quickstart:
#   cd bonneagar/stacks/infisical
#   cp .env.dev.example .env.dev
#   bash ../../../bonneagar/scripts/seed-infisical-vault.sh --env-only
# =============================================================================

# Postgres credentials (db user = `infisical`)
POSTGRES_USER=infisical
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_24
POSTGRES_DB=infisical

# Redis (no password in dev)
REDIS_URL=redis://redis:6379

# Public site URL (use http://localhost:8081 for local; Pangolin host when promoting to arm1-oci)
SITE_URL=http://localhost:8081
HOST=0.0.0.0

# DB connection (Infisical backend reads this to talk to Postgres)
DB_CONNECTION_URI=postgres://infisical:${POSTGRES_PASSWORD}@db:5432/infisical

# Encryption + auth — generate fresh values with:
#   ENCRYPTION_KEY=$(openssl rand -hex 16)
#   AUTH_SECRET=$(openssl rand -base64 32)
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_16
AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32