# =============================================================================
# TINYAUTH - Local Development Environment
# =============================================================================
# Copy this file to .env and edit values as needed for local dev.
# For production, secrets come from Locket/Infisical via sidecar.yaml.
# =============================================================================

# The public URL Tinyauth is reachable at (must be https for OIDC)
APP_URL=https://tinyauth.cianfhoghlaim.ie

# Pocket ID OIDC client credentials (created by `iac:bootstrap-pocketid-admin`)
PROVIDERS_POCKETID_CLIENT_ID=replace-with-bons-iac-client-id
PROVIDERS_POCKETID_CLIENT_SECRET=replace-with-bons-iac-client-secret

# Pocket ID OIDC endpoints
PROVIDERS_POCKETID_AUTH_URL=https://auth.cianfhoghlaim.ie/authorize
PROVIDERS_POCKETID_TOKEN_URL=https://auth.cianfhoghlaim.ie/api/oidc/token
PROVIDERS_POCKETID_USER_INFO_URL=https://auth.cianfhoghlaim.ie/api/oidc/userinfo
PROVIDERS_POCKETID_REDIRECT_URL=https://tinyauth.cianfhoghlaim.ie/api/oauth/callback/pocketid
PROVIDERS_POCKETID_SCOPES=openid email profile groups

# Tinyauth behavior
SECURE_COOKIE=true
SESSION_EXPIRY=86400
LOG_LEVEL=info
DISABLE_ANALYTICS=true

# Infisical (for the Locket sidecar)
INFISICAL_URL=https://infisical.cianfhoghlaim.ie
INFISICAL_PROJECT_ID=f3cff583-b74b-4804-b9d3-db8b68885236
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_FILE=./secrets/infisical_secret
