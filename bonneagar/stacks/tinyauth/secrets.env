# =============================================================================
# TINYAUTH - Locket secret references (Infisical dev-baile vault)
# =============================================================================
# This file is mounted as a tmpfs at /templates inside the Locket sidecar
# (see compose.yaml). Locket reads the resolved values + writes them to
# /run/secrets/locket/secrets.env inside the Tinyauth container.
#
# For Pocket ID OIDC, the bons-iac OIDC client is created by
# `bun run iac:bootstrap-pocketid-admin` and stored in Infisical at
# /tinyauth. So once that's run, Tinyauth picks up the credentials
# automatically on its next Locket refresh.
# =============================================================================

PROVIDERS_POCKETID_CLIENT_ID=infisical://dev-baile/tinyauth/provider_pocketid_client_id
PROVIDERS_POCKETID_CLIENT_SECRET=infisical://dev-baile/tinyauth/provider_pocketid_client_secret
