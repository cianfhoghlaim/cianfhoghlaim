# =============================================================================
# AGENT-OS - Local development environment (no real secrets)
# =============================================================================
# Copy to .env.local and edit. Do NOT commit .env.local.
# =============================================================================

OIDEACHAIS_PORT=7772
CRYPTEOLAS_PORT=7771
BROWSER_PORT=7773
CROILAR_PORT=7774
ALEYUM_PORT=7774  # legacy alias — remove once aleyum-agentos is retired
AGNO_DEFAULT_MODEL=gpt-4o
AGNO_CLAUDE_MODEL=claude-sonnet-4-20250514

# LLM gateway (post-2026-08-16) — the canonical LiteLLM chokepoint.
# The 4 AgentOS instances no longer hit upstream OpenAI/Anthropic directly;
# they route through LITELLM_BASE_URL with LITELLM_MASTER_KEY as the bearer.
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-dev-litellm-master
OPENAI_API_KEY=sk-dev-litellm-master
ANTHROPIC_API_KEY=sk-dev-litellm-master

AGENT_OS_SECRET_KEY=dev-a2a-secret
CIANFHGHLLAIM_DB_URL=sqlite:///./storage/cianfhoghlaim.db
CRYPTEOLAS_DB_URL=sqlite:///./storage/crypteolas.db
BROWSER_DB_URL=sqlite:///./storage/browser.db
CROILAR_DB_URL=sqlite:///./storage/croilar.db
ALEYUM_DB_URL=sqlite:///./storage/aleyum.db  # legacy
X402_ENABLED=true
X402_PAY_TO_ADDRESS=0xDev0000000000000000000000000000000000
X402_NETWORK=base
X402_SKIP_VERIFICATION=true
BROWSERBASE_API_KEY=dev-browserbase-key
BROWSERBASE_PROJECT_ID=dev-browserbase-project
STAGEHAND_ENABLED=true
CRAWL4AI_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-dev-langfuse
LANGFUSE_SECRET_KEY=sk-dev-langfuse
LANGFUSE_HOST=http://localhost:3000
AGNO_DEBUG=true

# ContextEnvelope cross-agent mesh (post-2026-08-16).
# Each AgentOS instance can hand context to openclaw (channel gateway) /
# openchamber (IDE/CLI) / hermes (agent runtime) via the ContextEnvelope
# protocol (agents/contracts/context_envelope.py). The BRIDGE_TOKEN is the
# HTTP Basic auth secret shared across the 4 agent-os + the 3 surfaces.
OPENCLAW_URL=http://openclaw:18789
OPENCHAMBER_URL=http://openchamber:3000
HERMES_URL=http://hermes:9119
CONTEXT_ENVELOPE_BRIDGE_TOKEN=dev-context-envelope-token

# OpenTelemetry fanout (post-2026-08-16).
# The 4 AgentOS instances export OTLP/gRPC traces to the canonical
# logfire-otel collector (the same endpoint the 6 memory/observability
# backends + 3 agent surfaces already use). Protocol is grpc per the
# agent-platform spec; the endpoint resolves to logfire-otel:4317.
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
