# =============================================================================
# AGENT-OS - Locket Secrets Template
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile:
#   agent-os/  agent_os_secret_key, x402_pay_to_address, oideachais_db_url,
#              crypteolas_db_url, browser_db_url, croilar_db_url
#
# CHANGED 2026-07-30 (env-contract-and-observability-fanout-v1):
#   Added OPENAI_API_KEY + ANTHROPIC_API_KEY + LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY
#   so the 4 AgentOS instances (oideachais-agentos, crypteolas-agentos,
#   browser-agentos, croilar-agentos) actually receive their Langfuse + LLM
#   credentials at startup. compose.yaml declares LANGFUSE_* env vars but the
#   shim never injected them before this change.
# =============================================================================

# Shared A2A secret (used by all 4 agents for cross-flow authentication)
AGENT_OS_SECRET_KEY={{ infisical:///agent-os/agent_os_secret_key }}

# x402 micropayment receiving address (crypteolas only, but kept here for symmetry)
X402_PAY_TO_ADDRESS={{ infisical:///agent-os/x402_pay_to_address }}

# Optional per-agent database URLs (default to local SQLite)
OIDEACHAIS_DB_URL={{ infisical:///agent-os/oideachais_db_url }}
CRYPTEOLAS_DB_URL={{ infisical:///agent-os/crypteolas_db_url }}
BROWSER_DB_URL={{ infisical:///agent-os/browser_db_url }}
CROILAR_DB_URL={{ infisical:///agent-os/croilar_db_url }}

# LLM provider keys (consumed by all 4 agents via OPENAI_API_KEY +
# ANTHROPIC_API_KEY env vars in compose.yaml).
OPENAI_API_KEY={{ infisical:///openai/api_key }}
ANTHROPIC_API_KEY={{ infisical:///anthropic/api_key }}

# Langfuse observability — these are declared in compose.yaml but the shim
# never injected them before this change. Now resolved at runtime.
LANGFUSE_HOST={{ infisical:///langfuse/host }}
LANGFUSE_PUBLIC_KEY={{ infisical:///langfuse/public_key }}
LANGFUSE_SECRET_KEY={{ infisical:///langfuse/secret_key }}
