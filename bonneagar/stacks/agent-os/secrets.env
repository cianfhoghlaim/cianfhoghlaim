# =============================================================================
# AGENT-OS - Locket Secrets Template
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile/agent-os/:
#   agent_os_secret_key, x402_pay_to_address, cianfhoghlaim_db_url,
#   crypteolas_db_url, browser_db_url, croilar_db_url,
#   openclaw_url, openchamber_url, hermes_url, context_envelope_bridge_token
# INFISICAL ITEMS TO CREATE UNDER dev-baile/litellm/:
#   master_key, base_url
# INFISICAL ITEMS TO CREATE UNDER dev-baile/logfire/:
#   otel_endpoint
#
# CHANGED 2026-07-30 (env-contract-and-observability-fanout-v1):
#   Added OPENAI_API_KEY + ANTHROPIC_API_KEY + LANGFUSE_HOST/PUBLIC_KEY/SECRET_KEY
#   so the 4 AgentOS instances (cianfhoghlaim-agentos, crypteolas-agentos,
#   browser-agentos, croilar-agentos) actually receive their Langfuse + LLM
#   credentials at startup. compose.yaml declares LANGFUSE_* env vars but the
#   shim never injected them before this change.
#
# CHANGED 2026-08-16 (meaisínfhoghlaim-integration change 1):
#   Added LITELLM_BASE_URL/MASTER_KEY (gateway-only LLM routing) +
#   OPENCLAW_URL/OPENCHAMBER_URL/HERMES_URL (ContextEnvelope cross-agent mesh) +
#   CONTEXT_ENVELOPE_BRIDGE_TOKEN (the ContextEnvelope auth secret) +
#   OTEL_EXPORTER_OTLP_ENDPOINT (gRPC fanout to logfire-otel).
#   All AgentOS instances route through the canonical LiteLLM gateway
#   (no longer hit the upstream OpenAI/Anthropic APIs directly).
# =============================================================================

# Shared A2A secret (used by all 4 agents for cross-flow authentication)
AGENT_OS_SECRET_KEY=infisical://dev-baile/agent-os/agent_os_secret_key

# x402 micropayment receiving address (crypteolas only, but kept here for symmetry)
X402_PAY_TO_ADDRESS=infisical://dev-baile/agent-os/x402_pay_to_address

# Optional per-agent database URLs (default to local SQLite)
CIANFHGHLLAIM_DB_URL=infisical://dev-baile/agent-os/cianfhoghlaim_db_url
CRYPTEOLAS_DB_URL=infisical://dev-baile/agent-os/crypteolas_db_url
BROWSER_DB_URL=infisical://dev-baile/agent-os/browser_db_url
CROILAR_DB_URL=infisical://dev-baile/agent-os/croilar_db_url

# LLM provider keys — now routed through the canonical LiteLLM gateway
# (the M3 chokepoint). The 4 AgentOS instances hit litellm:4000/v1 with
# LITELLM_MASTER_KEY as the API key; the upstream OpenAI/Anthropic keys
# live inside litellm's own secret store (not exposed to agent-os).
LITELLM_MASTER_KEY=infisical://dev-baile/litellm/master_key
LITELLM_BASE_URL=infisical://dev-baile/litellm/base_url
OPENAI_API_KEY=infisical://dev-baile/litellm/master_key
ANTHROPIC_API_KEY=infisical://dev-baile/litellm/master_key

# Langfuse observability — these are declared in compose.yaml but the shim
# never injected them before this change. Now resolved at runtime.
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key

# ContextEnvelope cross-agent mesh (per the agent-mesh change).
# Each AgentOS instance can hand context to openclaw / openchamber / hermes
# via the ContextEnvelope protocol (agents/contracts/context_envelope.py).
# The BRIDGE_TOKEN is the HTTP Basic auth secret shared across the 4 agent-os
# instances + the 3 agent surfaces.
OPENCLAW_URL=infisical://dev-baile/agent-os/openclaw_url
OPENCHAMBER_URL=infisical://dev-baile/agent-os/openchamber_url
HERMES_URL=infisical://dev-baile/agent-os/hermes_url
CONTEXT_ENVELOPE_BRIDGE_TOKEN=infisical://dev-baile/agent-os/context_envelope_bridge_token

# OpenTelemetry fanout — all 4 AgentOS instances export OTLP/gRPC traces
# to the canonical logfire-otel collector (the same endpoint the 6
# memory/observability backends + 3 agent surfaces already use).
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/logfire/otel_endpoint
