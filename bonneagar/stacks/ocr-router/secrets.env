# =============================================================================
# OCR-ROUTER - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the bons-locket-shim (v0.2.0).
#
# Per the 2026-07-30 env-contract-and-observability-fanout-v1 change,
# this file uses the canonical bare `infisical://dev-baile/<svc>/<key>`
# form. The shim's Jinja-template regex is NOT used here.
# =============================================================================

# Router's own API key (clients send `Authorization: Bearer $OCR_ROUTER_API_KEY`)
OCR_ROUTER_API_KEY=infisical://dev-baile/ocr-router/api_key

# OCR completion webhook (per spec delta on BIEP v3). Empty = graceful skip.
OCR_WEBHOOK_URL=infisical://dev-baile/ocr-router/webhook_url
OCR_WEBHOOK_TOKEN=infisical://dev-baile/ocr-router/webhook_token

# Observability (per Change 1 of the env-contract-and-observability-fanout trilogy)
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/logfire/otel_endpoint
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key