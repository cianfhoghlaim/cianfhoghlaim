# OCR Router — Environment Variable Catalogue

# Router port (host binding; 127.0.0.1 only — public access via Pangolin)
OCR_ROUTER_PORT=8090

# Per-request timeout (ms) when calling downstream backends
OCR_ROUTER_TIMEOUT_MS=30000

# =============================================================================
# Infisical + Locket
# =============================================================================
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch

# Backend endpoint URLs (no-secret defaults — resolved by Docker DNS on
# the cianfhoghlaim network; only override if running on a split deploy).
# OCR_PADDLEOCR_URL=http://paddleocr:8000/v1
# OCR_MLX_OMNI_URL=http://mlx-omni:10240/v1
# OCR_OLMOCR_URL=http://olmocr:8003/v1
# OCR_DOCLING_SERVE_URL=http://docling-serve:5001/v1
# OCR_LLAMA_SWAP_URL=http://llama-swap:8080/v1
# OCR_DOTS_OCR_URL=http://dots-ocr:8001/v1

# Observability (per Change 1 of env-contract-and-observability-fanout trilogy)
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4317
LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_PUBLIC_KEY=pk-lf-dev
# LANGFUSE_SECRET_KEY=sk-lf-dev