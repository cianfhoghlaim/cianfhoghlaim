# =============================================================================
# OPENCHAMBER — Local Development Environment
# =============================================================================
# Copy this file to .env.local and edit values as needed.
# For production, secrets come from Locket/Infisical via sidecar.yaml.
#
# Usage: cp .env.example .env.local
# Then: docker compose \
#         -f stacks/openchamber/compose.yaml \
#         -f stacks/openchamber/sidecar.yaml \
#         -f stacks/openchamber/compose.dev.yaml \
#         up -d
#
# All values that resolve to "infisical://dev-baile/..." URIs are populated
# at runtime by the Locket sidecar. Only put non-secret defaults here.
#
# SECRET HYGIENE (per task 5.1 of the
# `2026-07-28-openchamber-bunchloch-dev-parity-v1` openspec change):
#   This file MUST NOT contain any plaintext secret value. Use
#   infisical://dev-baile/... URIs in production secrets.env and
#   operate from the mise-hydrated `../../../.env` (gitignored) in
#   local dev. Any operator adding a real secret here will be
#   rejected by the stack-doctor `secrets.env` validator.
# =============================================================================

# =============================================================================
# UI (non-secret defaults)
# =============================================================================
OPENCHAMBER_PORT=3000
OPENCHAMBER_THEME=cianfhoghlaim-dark
OPENCHAMBER_LOG_LEVEL=info

# =============================================================================
# External OpenCode mode (Bunchloch dev contract — per task 3.1)
# =============================================================================
# The Bunchloch development surface (compose.dev.yaml) routes OpenChamber
# at the host's mise-managed OpenCode 1.17.9 server. All three vars MUST
# be set together so the env-config resolver skips the bundled runtime.
#
#   OPENCODE_HOST       http://host.docker.internal:4096
#                       (must include explicit port + http(s) scheme)
#   OPENCODE_PORT       4096
#   OPENCODE_SKIP_START true
OPENCODE_HOST=http://host.docker.internal:4096
OPENCODE_PORT=4096
OPENCODE_SKIP_START=true

# =============================================================================
# Public hostname (used by pangolin.yaml blueprint — arm1-oci only)
# =============================================================================
# Bunchloch dev does NOT publish through Pangolin — the dev surface
# binds loopback to 127.0.0.1:13000 only. Set this only if you want
# Komodo to publish the arm1-oci production route.
PANGOLIN_DOMAIN=openchamber.cianfhoghlaim.ie

# =============================================================================
# Production-only (uncomment + populate in the arm-oci .env)
# =============================================================================
# Cloudflare tunnel mode (bypass Pangolin, expose publicly):
# OPENCHAMBER_TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Cross-agent context handoff (per 2026-07-31-agentic-mesh-and-ocr-pipeline-coherence-v1)
# =============================================================================
# openchamber can hand context to openclaw (channel fanout) or hermes
# (agent runtime) via the ContextEnvelope protocol.
OPENCHAMBER_OPENCLAW_URL=http://openclaw:18789
OPENCHAMBER_OPENCLAW_BRIDGE_TOKEN=not-needed-in-dev
OPENCHAMBER_HERMES_URL=http://hermes:9119
OPENCHAMBER_HERMES_BRIDGE_TOKEN=not-needed-in-dev
