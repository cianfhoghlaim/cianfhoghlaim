# =============================================================================
# CONTROL-PLANE STACK — Local dev env (copy to .env.local)
# =============================================================================
# This is the bootstrap-mode env vars (used by docker-compose on first
# deploy). After the stack is up, the bons IaC's `iac:bootstrap-infisical`
# moves these secrets into Infisical. On subsequent deploys, the Locket
# sidecar materializes them from Infisical (see secrets.env).
# =============================================================================

# Infisical
INFISICAL_URL=http://localhost:8081
INFISICAL_PROJECT_ID=f3cff583-b74b-4804-b9d3-db8b68885236
INFISICAL_DEFAULT_ENVIRONMENT=dev

# Infisical bootstrap secrets (first-deploy only — Locket will fetch from Infisical after)
INFISICAL_ENCRYPTION_KEY=change-me-in-production
INFISICAL_AUTH_SECRET=change-me-in-production
INFISICAL_POSTGRES_PASSWORD=change-me-in-production

# Pocket ID
POCKETID_URL=https://auth.cianfhoghlaim.ie
POCKETID_ENCRYPTION_KEY=change-me-in-production

# Pangolin
PANGOLIN_URL=https://pangolin.cianfhoghlaim.ie
PANGOLIN_POSTGRES_PASSWORD=change-me-in-production
PANGOLIN_SIGNING_KEY=change-me-in-production
PANGOLIN_LICENCE=PER-D09BF259-59C1-48A5-9E66-CA56DEDF92EC

# Komodo
KOMODO_URL=https://komodo.cianfhoghlaim.ie
KOMODO_POSTGRES_PASSWORD=change-me-in-production
KOMODO_ADMIN_USERNAME=admin
KOMODO_ADMIN_PASSWORD=change-me-in-production

# Tinyauth
TINYAUTH_URL=https://tinyauth.cianfhoghlaim.ie

# Locket mode (watch = hot-reload, one-shot = run + exit, park = stay alive for healthcheck)
LOCKET_MODE=watch

# TLS (Let's Encrypt via Traefik)
ACME_EMAIL=admin@cianfhoghlaim.ie

# OIDC client IDs + secrets (populated by `iac:bootstrap-pocketid-admin` + `iac:wire-pocketid-as-oidc`)
# INFISICAL_CLIENT_ID=                        # populated by iac:bootstrap-infisical
# INFISICAL_CLIENT_SECRET_FILE=/run/secrets/infisical/client_secret
# POCKETID_KOMODO_CLIENT_ID=                  # populated by iac:wire-pocketid-as-oidc
# POCKETID_KOMODO_CLIENT_SECRET=              # populated by iac:wire-pocketid-as-oidc
# POCKETID_TINYAUTH_CLIENT_ID=                # populated by iac:bootstrap-pocketid-admin
# POCKETID_TINYAUTH_CLIENT_SECRET=            # populated by iac:bootstrap-pocketid-admin
