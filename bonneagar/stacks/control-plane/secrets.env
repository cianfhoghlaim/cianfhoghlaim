# =============================================================================
# CONTROL-PLANE STACK — secrets.env
# =============================================================================
# Each service's secrets are fetched from Infisical via Locket sidecars.
# The Locket pattern:
#   1. service secrets.env has the {{ infisical:///SECRET }} URIs
#   2. locket sidecar reads templates:/templates/secrets.env + resolves
#   3. materializes to /run/secrets/locket/secrets.env (tmpfs)
#   4. service env_file: /run/secrets/locket/secrets.env
#
# All Infisical refs resolve from the dev-baile project on the canonical
# Infisical vault. The bons IaC's iac:bootstrap-infisical command seeded
# all 8 required machine identities before this stack is deployed.
# =============================================================================

# ---- Infisical vault location ----
INFISICAL_URL=https://infisical.cianfhoghlaim.ie
INFISICAL_PROJECT_ID={{ infisical:////project_id }}
INFISICAL_DEFAULT_ENVIRONMENT=dev

# ---- Infisical auth (uses the bons-iac machine identity) ----
INFISICAL_CLIENT_ID={{ infisical:////bons-iac/client_id }}
# INFISICAL_CLIENT_SECRET is injected via Docker secrets (file mount):
#   file:/run/secrets/infisical/client_secret

# ---- Infisical bootstrap secrets (first-deploy only) ----
# After iac:bootstrap-infisical runs, these are rotated to Infisical
# values via Locket. For the very first deploy, they're hardcoded.
INFISICAL_ENCRYPTION_KEY={{ infisical:////infisical/encryption_key }}
INFISICAL_AUTH_SECRET={{ infisical:////infisical/auth_secret }}
INFISICAL_POSTGRES_PASSWORD={{ infisical:////infisical/postgres_password }}

# ---- Pocket ID ----
POCKETID_URL=https://auth.cianfhoghlaim.ie
POCKETID_ENCRYPTION_KEY={{ infisical:////pocket-id/encryption_key }}

# ---- Pangolin ----
PANGOLIN_URL=https://pangolin.cianfhoghlaim.ie
PANGOLIN_POSTGRES_PASSWORD={{ infisical:////pangolin/postgres_password }}
PANGOLIN_SIGNING_KEY={{ infisical:////pangolin/signing_key }}
PANGOLIN_LICENCE=PER-D09BF259-59C1-48A5-9E66-CA56DEDF92EC
POCKETID_KOMODO_CLIENT_ID={{ infisical:////pocket-id/komodo_client_id }}
POCKETID_KOMODO_CLIENT_SECRET={{ infisical:////pocket-id/komodo_client_secret }}

# ---- Komodo ----
KOMODO_URL=https://komodo.cianfhoghlaim.ie
KOMODO_POSTGRES_PASSWORD={{ infisical:////komodo/postgres_password }}
KOMODO_ADMIN_USERNAME=cianfhoghlaim
KOMODO_ADMIN_PASSWORD={{ infisical:////komodo/admin_password }}

# ---- Tinyauth ----
TINYAUTH_URL=https://tinyauth.cianfhoghlaim.ie
POCKETID_TINYAUTH_CLIENT_ID={{ infisical:////pocket-id/tinyauth_client_id }}
POCKETID_TINYAUTH_CLIENT_SECRET={{ infisical:////pocket-id/tinyauth_client_secret }}

# ---- TLS (Let's Encrypt via Traefik) ----
ACME_EMAIL=admin@cianfhoghlaim.ie
