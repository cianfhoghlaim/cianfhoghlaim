VIKUNJA_DB_PASSWORD=infisical://dev-baile/vikunja/db_password
VIKUNJA_JWT_SECRET=infisical://dev-baile/vikunja/jwt_secret
VIKUNJA_MAILER_PASSWORD=infisical://dev-baile/vikunja/mailer_password
VIKUNJA_ADMIN_PASSWORD=infisical://dev-baile/vikunja/admin_password
POCKETID_TEAM_WORKFLOW_CLIENT_ID=pocketid-team-workflow
POCKETID_TEAM_WORKFLOW_CLIENT_SECRET=infisical://dev-baile/pocketid-team-workflow/client_secret
# NOTE: the DATABASE_URL + FALLBACK_DATABASE_URL lines below contain
# embedded-substring secrets. The bons-locket-shim's REF_RE only matches
# the Jinja form `{{ infisical:///KEY?path=/X }}` — it does NOT match the
# canonical `infisical://dev-baile/...` form for substring substitution.
# Therefore these lines MUST stay in the Jinja form so Locket can
# resolve the username/password at container start. The 2026-08-15
# normalize-script pass intentionally skipped them.
DATABASE_URL=postgresql://{{ infisical:///username?path=/planetscale }}:{{ infisical:///password?path=/planetscale }}@eu-west-3.pg.psdb.cloud:5432/bunchloch?sslmode=require&options=-c%20search_path%3Dvikunja
FALLBACK_DATABASE_URL=postgresql://vikunja:{{ infisical:///db_password?path=/vikunja }}@infisical-db:5432/vikunja
