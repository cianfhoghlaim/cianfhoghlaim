# and register the value in the dev-baile Infisical project
# (path `/audiobookshelf`).
# =============================================================================

# NOTE: Audiobookshelf compose.yaml has no environment variables.
# All configuration is done through the web UI after first launch.

LOCKET_MODE=watch
