# FalkorDB dev secrets (dev mode only — NEVER commit anything other than dev values)
FALKORDB_PASSWORD=devpassword
# Run falkordb on :6380 (per the runbook) to avoid the port conflict with
# dragonfly which is on :6379. The 6380 is exposed only on 127.0.0.1.
FALKORDB_PORT=6380
FALKORDB_UI_PORT=3001
