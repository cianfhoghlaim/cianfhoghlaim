# =============================================================================
# FALKORDB - Locket Secrets Template
# =============================================================================
# All values are Locket-canonical `infisical://dev-baile/<svc>/<key>` URIs
# resolved at container start by the Locket sidecar (see sidecar.yaml).
# Migrated from the legacy Jinja `{{ infisical:///... }}` form by the
# `consolidate-observability-and-graph` openspec change (2026-06-26).
#
# Updated for the 2026-08-15-lakehouse-memory-stack change (Phase B):
# - Added `vector_module_url` so the `vector.so` loadmodule flag in
#   compose.yaml can be wired without hardcoding the upstream URL.
# - Added `cluster_mode` for the optional single-node vs cluster toggle
#   (default: single-node — see `FALKORDB_ARGS=--cluster-enabled no`).
# =============================================================================

FALKORDB_PASSWORD=infisical://dev-baile/falkordb/password

# Path to the bundled vector module (loaded via `falkordb --loadmodule`)
VECTOR_MODULE_URL=infisical://dev-baile/falkordb/vector_module_url

# Cluster mode toggle: "no" (single-node, dev default) | "yes" (cluster)
CLUSTER_MODE=infisical://dev-baile/falkordb/cluster_mode
