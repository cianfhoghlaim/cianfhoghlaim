# =============================================================================
# CRAWL4AI - Locket Secrets Template
# =============================================================================
# Template file for Locket secret injection.
# Uses Infisical references (infisical:///<SECRET_KEY>).
#
# USAGE:
#   locket exec --provider infisical \
#     --connect.host http://132.145.27.89:8080 \
#     --connect.token-file /path/to/token \
#     --env-file secrets.env \
#     -- docker compose -f compose.yaml up -d
#
# INFISICAL SECRETS TO CREATE:
#   - crawl4ai-llm: openai_api_key, deepseek_api_key, anthropic_api_key,
#       groq_api_key, together_api_key, mistral_api_key, gemini_api_token
#   - crawl4ai-jwt-secret: the v0.9.x JWT bearer token (added 2026-08-21
#     per openspec/changes/2026-08-21-complete-browserbase-archive-and-crawl4ai-mcp-v1)
# =============================================================================

# =============================================================================
# LLM Provider API Keys
# =============================================================================
OPENAI_API_KEY=infisical://dev-baile/crawl4ai/openai_api_key 
DEEPSEEK_API_KEY=infisical://dev-baile/crawl4ai/deepseek_api_key 
ANTHROPIC_API_KEY=infisical://dev-baile/crawl4ai/anthropic_api_key 
GROQ_API_KEY=infisical://dev-baile/crawl4ai/groq_api_key 
TOGETHER_API_KEY=infisical://dev-baile/crawl4ai/together_api_key 
MISTRAL_API_KEY=infisical://dev-baile/crawl4ai/mistral_api_key 
GEMINI_API_TOKEN=infisical://dev-baile/crawl4ai/gemini_api_token 

# =============================================================================
# v0.9.x MCP Auth (per openspec/changes/2026-08-21-complete-browserbase-archive-and-crawl4ai-mcp-v1)
# JWT bearer token that unlocks the MCP server from loopback binding
# and authenticates all 7 MCP tool calls (md, html, screenshot, pdf,
# execute_js, crawl, ask). Sourced from Infisical dev-baile vault.
# =============================================================================
CRAWL4AI_JWT_SECRET=infisical://dev-baile/cianfhoghlaim/crawl4ai-jwt-secret 