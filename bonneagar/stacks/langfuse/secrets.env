# =============================================================================
# LANGFUSE - Locket Secrets Template (dev-baile vault)
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
# The folder path is a query param (locket v0.17+ / Infisical v0.161+ model).
#
# Updated for the `centralise-data-plane` rewrite (2026-07-30):
# - DATABASE_URL, POSTGRES_USER, POSTGRES_PASSWORD come from the lakehouse
#   stack (shared via the cianfhoghlaim bridge network).
# - The standalone POSTGRES_PASSWORD, MINIO_ROOT_USER/PASSWORD,
#   CLICKHOUSE_USER/PASSWORD, REDIS_AUTH, and per-bucket
#   S3 access/secret keys were dropped — they now come from the
#   .env file at ~/.komodo-stacks/langfuse/.env.
# - Per-bucket S3 access keys are now the SHARED garage credentials
#   (GARAGE_ACCESS_KEY_ID / GARAGE_SECRET_ACCESS_KEY).
# - Langfuse-specific secrets that stay here: SALT, ENCRYPTION_KEY,
#   public_key, secret_key, host.
#
# Updated for the 2026-08-15-lakehouse-memory-stack change (Phase B):
# - Added OTEL_EXPORTER_OTLP_ENDPOINT (the logfire-otel fan-out)
# - Added CLICKHOUSE_URL + REDIS_URL for the centralised data plane
# - Added PLANETSCALE_DATABASE_URL (the opt-in PlanetScale PG override)
# =============================================================================

# Auth (Langfuse v3 requires these in the locket volume)
SALT=infisical://dev-baile/langfuse/salt
ENCRYPTION_KEY=infisical://dev-baile/langfuse/encryption_key

# Observability
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key
LANGFUSE_HOST=infisical://dev-baile/langfuse/host

# OpenTelemetry fan-out (added 2026-08-15-lakehouse-memory-stack Phase B)
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/logfire/otel_endpoint

# Centralised data plane (added 2026-08-15-lakehouse-memory-stack Phase B)
CLICKHOUSE_URL=infisical://dev-baile/langfuse/clickhouse_url
REDIS_URL=infisical://dev-baile/langfuse/redis_url

# PlanetScale PG override (added 2026-08-15-lakehouse-memory-stack Phase B
# per the umbrella `planetscale-postgres-data-strategy` R7)
PLANETSCALE_DATABASE_URL=infisical://dev-baile/langfuse/planetscale_database_url
# ADDED 2026-08-22 (lakehouse-observability-stacks-modernization-v1):
# Critical security env vars required by Langfuse self-hosting docs.
# All `openssl rand -base64 32` (or `-hex 32` for ENCRYPTION_KEY).
NEXTAUTH_SECRET=infisical://dev-baile/langfuse/nextauth_secret
HOSTNAME=0.0.0.0
LANGFUSE_LOG_FORMAT=json
CLICKHOUSE_LIGHTWEIGHT_DELETE_MODE=lightweight_update
CLICKHOUSE_USE_LIGHTWEIGHT_UPDATE=true
LANGFUSE_CLICKHOUSE_DELETION_TIMEOUT_MS=1200000
OTEL_TRACE_SAMPLING_RATIO=1.0
