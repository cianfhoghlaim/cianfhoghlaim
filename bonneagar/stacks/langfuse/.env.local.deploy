# Lakehouse Postgres (db=langfuse)
# Per the lakehouse-multi-subject-multi-model-rollout change: this used
# to carry a real, leaked Postgres password committed to git. Replaced
# with the same dev-fallback placeholder
# bonneagar/stacks/lakehouse/.env.example already establishes.
# IMPORTANT: because this file is loaded directly via `docker compose
# --env-file .env.local.deploy up -d` (not just for schema validation),
# (re)creating the langfuse container with this placeholder will fail
# Postgres auth until the real password is supplied out-of-band -- same
# manual follow-up already flagged for mlflow/.env.local.deploy.
DATABASE_URL=postgresql://lakekeeper:devpassword@lakehouse-postgres:5432/langfuse
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword

# Lakehouse Redis (internal port is 6379, NOT the host-mapped 6381)
REDIS_HOST=lakehouse-redis
REDIS_PORT=6379
REDIS_AUTH=c9f2e6ea1204a94234d7fba213dc7a7b
REDIS_PASSWORD=c9f2e6ea1204a94234d7fba213dc7a7b

# Lakehouse ClickHouse (user is "clickhouse", NOT "cianfhoghlaim")
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:ae57586ac13250297988258bf39a0365@lakehouse-clickhouse:9000
CLICKHOUSE_URL=http://clickhouse:ae57586ac13250297988258bf39a0365@lakehouse-clickhouse:8123
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=ae57586ac13250297988258bf39a0365
