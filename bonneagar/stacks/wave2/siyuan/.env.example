# SiYuan server
SIYUAN_PORT=6806
# Optional auth code (leave empty for no auth in trusted networks)
# SIYUAN_ACCESS_AUTH_CODE=

# Infisical + Locket
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
