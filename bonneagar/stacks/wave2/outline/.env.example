# =============================================================================
# OUTLINE - Environment Variable Catalogue
# =============================================================================
# Documents every ${VAR} reference in outline/compose.yaml.
# =============================================================================

# Outline server
OUTLINE_PORT=3000
OUTLINE_URL=https://outline.cianfhoghlaim.ie

# Centralised Postgres + Redis (from lakehouse/* vault; resolved via Locket)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword-change-me
REDIS_PASSWORD=devpassword-change-me

# Application secrets (real values come from Locket)
# OUTLINE_SECRET_KEY=<set in Locket>
# OUTLINE_UTILS_SECRET=<set in Locket>

# OIDC SSO (Pocket ID)
OUTLINE_OIDC_AUTH_URI=https://auth.cianfhoghlaim.ie
# OUTLINE_OIDC_CLIENT_ID=<set in Locket>
# OUTLINE_OIDC_CLIENT_SECRET=<set in Locket>
# OUTLINE_OIDC_TOKEN_URI=<set in Locket>
# OUTLINE_OIDC_USERINFO_URI=<set in Locket>

# Infisical + Locket
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
