# =============================================================================
# OUTLINE - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
# =============================================================================

# Postgres (centralised lakehouse)
POSTGRES_PASSWORD=infisical://dev-baile/lakehouse/postgres_password

# Redis (centralised lakehouse)
REDIS_PASSWORD=infisical://dev-baile/lakehouse/redis_password

# Application secrets
OUTLINE_SECRET_KEY=infisical://dev-baile/outline/secret_key
OUTLINE_UTILS_SECRET=infisical://dev-baile/outline/utils_secret

# OIDC SSO (Pocket ID)
OUTLINE_OIDC_CLIENT_ID=infisical://dev-baile/outline/oidc_client_id
OUTLINE_OIDC_CLIENT_SECRET=infisical://dev-baile/outline/oidc_client_secret
OUTLINE_OIDC_TOKEN_URI=infisical://dev-baile/outline/oidc_token_uri
OUTLINE_OIDC_USERINFO_URI=infisical://dev-baile/outline/oidc_userinfo_uri
