# =============================================================================
# KHOJ - Environment Variable Catalogue
# =============================================================================
# Documents every ${VAR} reference in khoj/compose.yaml.
# =============================================================================

# Khoj server
KHOJ_PORT=42110
KHOJ_DOMAIN=https://khoj.cianfhoghlaim.ie

# Centralised Postgres (from lakehouse/* vault; resolved via Locket at runtime)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword-change-me

# LLM (LiteLLM is the M3 chokepoint)
OPENAI_API_BASE=http://litellm:4000/v1
OPENAI_API_KEY=sk-dev-placeholder

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire:4317

# Infisical + Locket
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
