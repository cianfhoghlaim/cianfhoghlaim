# =============================================================================
# IMMICH - Environment Variable Catalogue
# =============================================================================
# Documents every ${VAR} reference in immich/compose.yaml.
# =============================================================================

# Immich server
IMMICH_PORT=2283

# Centralised Postgres + Redis (from lakehouse/* vault; resolved via Locket)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword-change-me
REDIS_PASSWORD=devpassword-change-me

# Infisical + Locket
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
