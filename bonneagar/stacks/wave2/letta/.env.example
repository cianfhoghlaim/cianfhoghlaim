# =============================================================================
# LETTA - Environment Variable Catalogue
# =============================================================================
# Documents every ${VAR} reference in letta/compose.yaml.
# =============================================================================

# Letta server
LETTA_PORT=8283
LETTA_LLM_MODEL=minimax-m3
LETTA_LLM_API_BASE=http://litellm:4000/v1
LETTA_LLM_API_KEY=sk-dev-placeholder
LETTA_EMBEDDING_MODEL=text-embedding-3-small
LETTA_EMBEDDING_API_BASE=http://litellm:4000/v1
LETTA_EMBEDDING_API_KEY=sk-dev-placeholder

# Centralised Postgres (from lakehouse/* vault; resolved via Locket at runtime)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword-change-me

# Observability endpoints
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-dev-placeholder
LANGFUSE_SECRET_KEY=sk-dev-placeholder
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire:4317

# Infisical + Locket
INFISICAL_URL=http://132.145.27.89:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
