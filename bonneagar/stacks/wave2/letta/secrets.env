# =============================================================================
# LETTA - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
# =============================================================================

# Postgres (centralised lakehouse)
LETTA_PG_URI=infisical://dev-baile/letta/pg_uri

# LLM (LiteLLM is the M3 chokepoint)
LETTA_LLM_API_KEY=infisical://dev-baile/litellm/master_key

# Embedding
LETTA_EMBEDDING_API_KEY=infisical://dev-baile/litellm/master_key

# Observability
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key
