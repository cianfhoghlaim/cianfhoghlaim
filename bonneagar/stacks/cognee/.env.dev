# Cognee dev secrets (dev mode only — NEVER commit anything other than dev values)
#
# Cognee uses the lakehouse-postgres (db=cognee_cianfhoghlaim) for storage
# + the lakehouse-lance-namespace for vector storage.

# Cognee Postgres backend (lakehouse shared PG, db=cognee_cianfhoghlaim)
COGNEE_POSTGRES_HOST=cognee-postgres
COGNEE_POSTGRES_PORT=5432
COGNEE_POSTGRES_USER=cognee
COGNEE_POSTGRES_PASSWORD=devpassword
COGNEE_POSTGRES_DB=cognee_cianfhoghlaim

# DB_* mirrors (per the cianfhoghlaim/cognee_config.py:USE_UNIFIED_PROVIDER=pghybrid path)
DB_PROVIDER=postgres
DB_HOST=cognee-postgres
DB_PORT=5432
DB_NAME=cognee_cianfhoghlaim
DB_USERNAME=cognee
DB_PASSWORD=devpassword

# LanceDB (lakehouse-lance-namespace)
LANCEDB_URI=rest://lakehouse-lance-namespace:8182
LANCEDB_API_KEY=devtoken

# LLM via litellm gateway (no real key needed — litellm has its own)
LLM_API_KEY=no-key-needed
EMBEDDING_API_KEY=no-key-needed

# LLM model selection
COGNEE_LLM_MODEL=deepseek/deepseek-chat
COGNEE_EMBEDDING_MODEL=openai/text-embedding-3-small

# Disable auth in dev
REQUIRE_AUTHENTICATION=false
ENABLE_BACKEND_ACCESS_CONTROL=false

# Standard
ENVIRONMENT=development
LOG_LEVEL=INFO
