N8N_ENCRYPTION_KEY=infisical://dev-baile/n8n/encryption_key
N8N_JWT_SECRET=infisical://dev-baile/n8n/jwt_secret
N8N_DB_PASSWORD=infisical://dev-baile/n8n/db_password
N8N_WEBHOOK_URL=https://n8n.cianfhoghlaim.ie/
N8N_API_KEY=infisical://dev-baile/n8n/api_key
OPENAI_API_KEY=infisical://dev-baile/litellm/master_key
OPENAI_BASE_URL=http://litellm:4000/v1
DEEPSEEK_API_KEY=infisical://dev-baile/deepseek/api_key
# OIDC / SSO (requires Enterprise license)
POCKETID_TEAM_WORKFLOW_CLIENT_SECRET=infisical://dev-baile/pocketid-team-workflow/client_secret
# NOTE: the DATABASE_URL + FALLBACK_DATABASE_URL lines below contain
# embedded-substring secrets. The bons-locket-shim's REF_RE only matches
# the Jinja form `{{ infisical:///KEY?path=/X }}` — it does NOT match the
# canonical `infisical://dev-baile/...` form for substring substitution.
# Therefore these lines MUST stay in the Jinja form so Locket can
# resolve the username/password at container start. The 2026-08-15
# normalize-script pass intentionally skipped them.
DATABASE_URL=postgresql://{{ infisical:///username?path=/planetscale }}:{{ infisical:///password?path=/planetscale }}@eu-west-3.pg.psdb.cloud:5432/bunchloch?sslmode=require&options=-c%20search_path%3Dn8n
FALLBACK_DATABASE_URL=postgresql://n8n:{{ infisical:///db_password?path=/n8n }}@infisical-db:5432/n8n
