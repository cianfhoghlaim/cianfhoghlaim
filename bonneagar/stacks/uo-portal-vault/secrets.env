# =============================================================================
# UO-PORTAL-VAULT secrets.env
# =============================================================================
# Per the 6-file GOLD_STANDARD pattern. Every value is an Infisical
# `infisical://dev-baile/...` reference — no raw secrets committed.
# The Locket sidecar hydrates the values at runtime.
# =============================================================================

# The active user (templated via UO_PORTAL_USER)
UO_PORTAL_USER=${UO_PORTAL_USER:-default}

# The per-user regexam.nuigalway.ie credentials
REGEXAM_NUIG_USERNAME=infisical://dev-baile/cianfhoghlaim/regexam-nuig/${UO_PORTAL_USER}/username
REGEXAM_NUIG_PASSWORD=infisical://dev-baile/cianfhoghlaim/regexam-nuig/${UO_PORTAL_USER}/password

# The per-user Canvas credentials (username + password + optional PAT)
CANVAS_NUIG_USERNAME=infisical://dev-baile/cianfhoghlaim/canvas-nuig/${UO_PORTAL_USER}/username
CANVAS_NUIG_PASSWORD=infisical://dev-baile/cianfhoghlaim/canvas-nuig/${UO_PORTAL_USER}/password
CANVAS_NUIG_PAT=infisical://dev-baile/cianfhoghlaim/canvas-nuig/${UO_PORTAL_USER}/pat

# The vault's own binding
UO_PORTAL_VAULT_DIR=/stedding/user_profiles
CANVAS_NUIG_BASE_URL=https://canvas.universityofgalway.ie
