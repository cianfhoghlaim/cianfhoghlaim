# =============================================================================
# UO-PORTAL-VAULT .env.example
# =============================================================================
# Template for the per-user Infisical secret paths. Copy to .env
# and fill in the actual values via `infisical secrets set ...`.
# =============================================================================

# The active user (templated via UO_PORTAL_USER)
UO_PORTAL_USER=default

# The per-user regexam.nuigalway.ie credentials
REGEXAM_NUIG_USERNAME=staffid@universityofgalway.ie
REGEXAM_NUIG_PASSWORD=__set_via_infisical__

# The per-user Canvas credentials
CANVAS_NUIG_USERNAME=a.oconnor1@universityofgalway.ie
CANVAS_NUIG_PASSWORD=__set_via_infisical__
CANVAS_NUIG_PAT=__set_via_infisical__  # self-service at /profile/settings

# Vault config
UO_PORTAL_VAULT_DIR=/stedding/user_profiles
CANVAS_NUIG_BASE_URL=https://canvas.universityofgalway.ie
