# =============================================================================
# QBITTORRENT-GLUETUN — Locket Secrets Template
# =============================================================================#
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile/qbittorrent-gluetun/:
#   wireguard_private_key     — same key as the main gluetun stack
#   wireguard_preshared_key   — same key as the main gluetun stack
#   wireguard_addresses       — e.g. "10.x.x.x/32" (your tunnel IP)
#   wireguard_pubkey          — the VPN server's public key
#   wireguard_endpoint        — e.g. "vpn.example.com:51820"
#   webui_password            — qBittorrent WebUI admin password
#
# Reuse the same WireGuard key as the existing gluetun stack if you want
# both containers to egress from the same tunnel IP. Most providers allow
# multiple simultaneous connections per key.
# =============================================================================

WIREGUARD_PRIVATE_KEY={{ infisical://dev-baile/qbittorrent-gluetun/wireguard_private_key }}
WIREGUARD_PRESHARED_KEY={{ infisical://dev-baile/qbittorrent-gluetun/wireguard_preshared_key }}
WIREGUARD_ADDRESSES={{ infisical://dev-baile/qbittorrent-gluetun/wireguard_addresses }}
WIREGUARD_PUBKEY={{ infisical://dev-baile/qbittorrent-gluetun/wireguard_pubkey }}
WIREGUARD_ENDPOINT={{ infisical://dev-baile/qbittorrent-gluetun/wireguard_endpoint }}

# qBittorrent WebUI credentials — referenced by Mylar3 + Kapowarr as the
# download client. Set in the qBittorrent WebUI after first start; or
# pre-seed by injecting via the qBittorrent config volume.
WEBUI_USERNAME=admin
WEBUI_PASSWORD={{ infisical://dev-baile/qbittorrent-gluetun/webui_password }}
