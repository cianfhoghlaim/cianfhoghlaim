# =============================================================================
# QBITTORRENT-GLUETUN — Environment Variable Catalogue
# =============================================================================#
# Documents every ${VAR} reference in compose.yaml + sidecar.yaml.
#
# USAGE:
#   cp .env.example .env.local
#   edit .env.local with your dev values
#   docker compose --env-file .env.local up -d
# =============================================================================

# =============================================================================
# qBittorrent WebUI
# =============================================================================
QBITTORRENT_WEBUI_PORT=8080

# =============================================================================
# Filesystem (host → container)
# =============================================================================
# Default to local-relative paths so the stack works out-of-the-box.
# Override to absolute macOS paths for stable storage, e.g.:
#   DOWNLOADS_PATH=/Users/cianmacandeisigh/Downloads
#   COMICS_STAGING_PATH=/Users/cianmacandeisigh/Downloads/comics
DOWNLOADS_PATH=./downloads
COMICS_STAGING_PATH=./downloads/comics

# UID/GID for file ownership — match the host user
PUID=1000
PGID=1000
TZ=Europe/Dublin
UMASK=022

# =============================================================================
# WireGuard (placeholder dev values — replaced by Locket at runtime)
# =============================================================================#
# For real dev, copy these from the existing `gluetun` stack's .env
# (or from Infisical dev-baile/gluetun/*).
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PUBKEY=
WIREGUARD_ENDPOINT=
VPN_PORT_FORWARDING=off
VPN_PORT_FORWARDING_PROVIDER=

# =============================================================================
# Infisical + Locket (canonical 3-way contract)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
INFISICAL_FALLBACK_FILE=/dev/null
