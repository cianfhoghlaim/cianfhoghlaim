# =============================================================================
# LAKEHOUSE - Empty-Value Env Template
# =============================================================================
# CHANGED 2026-08-22 (lakehouse-config-and-env-var-hardening-v1):
#   .env.dev is now an EMPTY-VALUE TEMPLATE — same keys + comments as before,
#   but all secret values are blank.
#
#   Plaintext secrets live in `.env.local` (gitignored per `.gitignore:177`).
#   This file is safe to commit because it contains no real secrets.
#
# USAGE (local dev):
#   1. Run `mise run secrets:init` to populate `.env.local` from Infisical
#   2. OR manually copy `.env.example` → `.env.local` and fill in from Infisical vault
#   3. Run `docker compose -f compose.yaml -f sidecar.yaml up -d`
#
# USAGE (CI / production):
#   - Locket resolves all secrets from `infisical://dev-baile/lakehouse/...` URIs
#     in `secrets.env` at container start. No `.env.local` needed.
#   - The `INFISICAL_SECRET_FILE` env var (see `sidecar.yaml`) defaults to
#     `./infisical_secret` and can be overridden for CI runners.
#
# To regenerate this file from the live vault, see:
#   scripts/init-vault.ts
# =============================================================================

# =============================================================================
# Centralised Postgres (lakehouse-postgres) — 14 databases
# =============================================================================
# POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB: real values come
# from infisical://dev-baile/lakehouse/* via Locket. Populate in
# `.env.local` for local dev.
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=
POSTGRES_DB=lakekeeper

# =============================================================================
# ClickHouse (consumed by langfuse)
# =============================================================================
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=cianfhoghlaim

# =============================================================================
# Redis (consumed by langfuse)
# =============================================================================
REDIS_PASSWORD=
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_PORT=6381

# =============================================================================
# Garage S3 (8 buckets total)
# =============================================================================
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_ACCESS_KEY_ID=
GARAGE_SECRET_ACCESS_KEY=

# =============================================================================
# Lakekeeper (Iceberg REST Catalog)
# =============================================================================
LAKEKEEPER_ENCRYPTION_KEY=
LAKEKEEPER_SSL_MODE=prefer

# =============================================================================
# Nimtable + Olake + LanceDB Viewer (all Locket-resolved)
# =============================================================================
NIMTABLE_JDBC_PASSWORD=
NIMTABLE_DASHBOARD_SECRET=
OLAKE_JDBC_PASSWORD=
OLAKE_SOURCE_PG_PASSWORD=
OLAKE_WRITER_S3_SECRET_KEY=
LANCEDB_VIEWER_ADMIN_TOKEN=

# =============================================================================
# Network ports (overridable)
# =============================================================================
LANCEDB_VIEWER_PORT=8081
