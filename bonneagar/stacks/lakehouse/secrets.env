# =============================================================================
# LAKEHOUSE - Locket Secrets Template
# =============================================================================
# All values are Locket-canonical `infisical://dev-baile/<svc>/<key>` URIs
# resolved at container start by the Locket sidecar (see sidecar.yaml).
# Migrated from the legacy Jinja `infisical://dev-baile/lakehouse/... ` form by the
# `consolidate-observability-and-graph` openspec change (2026-06-26).
# Updated for the `centralise-data-plane` rewrite (2026-07-30): added
# POSTGRES_PASSWORD + CLICKHOUSE_PASSWORD + REDIS_PASSWORD + the 4 new
# Garage service buckets are auto-created by the updated garage-init.
# =============================================================================

# =============================================================================
# PlanetScale PostgreSQL (OPTIONAL override for managed deployments)
# =============================================================================
# PLANETSCALE_DATABASE_URL is now an OVERRIDE only — when unset, Lakekeeper
# uses the centralised lakehouse-postgres container (the recommended path
# for both dev and prod on bunchloch).
# Connection URL format: postgresql://user:password@host:port/database?sslmode=require
PLANETSCALE_DATABASE_URL=infisical://dev-baile/lakehouse/database_url

# Component-specific PlanetScale creds (added by 2026-08-15-lakehouse-memory-stack
# Phase B so the cognee / langfuse / mlflow / logfire-otel stacks can each
# point at the same managed PG with their own schema).
PLANETSCALE_USERNAME=infisical://dev-baile/lakehouse/planetscale_username
PLANETSCALE_HOST=infisical://dev-baile/lakehouse/planetscale_host

# =============================================================================
# Centralised Postgres (lakehouse-postgres) — 12 databases
# =============================================================================
# Superuser password (the existing `lakekeeper` user). Used by:
#   - Lakekeeper (ducklake_* databases)
#   - Dagster (dagster_local database)
#   - Olake (olake_state database)
#   - Nimtable (nimtable database)
#   - langfuse (lakehouse.langfuse database) — auth via DATABASE_URL
#   - mlflow (lakehouse.mlflow database) — auth via MLFLOW_BACKEND_STORE_URI
#   - litellm (lakehouse.litellm database) — auth via DATABASE_URL
POSTGRES_USER=infisical://dev-baile/lakehouse/postgres_user
POSTGRES_PASSWORD=infisical://dev-baile/lakehouse/postgres_password
POSTGRES_DB=infisical://dev-baile/lakehouse/postgres_db

# =============================================================================
# Lakekeeper Configuration
# =============================================================================
# 64-character hex encryption key for Lakekeeper secrets storage
LAKEKEEPER_ENCRYPTION_KEY=infisical://dev-baile/lakehouse/encryption_key

# SSL mode for the lakehouse-postgres connection (should be 'prefer' for
# local dev, 'require' for managed Postgres)
LAKEKEEPER_SSL_MODE=prefer

# CHANGED 2026-08-23 (lakehouse-production-config-and-lance-sidecar-modernization-v1):
# Production env vars per official Lakekeeper config docs. These are all
# optional (defaults to single-postgres + sane cache settings).
# ADDED 2026-08-23:
LAKEKEEPER__PG_HOST_R=infisical://dev-baile/lakehouse/pg_host_r  # read replica (optional; defaults to postgres)
LAKEKEEPER__PG_HOST_W=infisical://dev-baile/lakehouse/pg_host_w  # write DB (optional; defaults to postgres)
LAKEKEEPER_METRICS_PORT=9100
LAKEKEEPER_PAGINATION_SIZE_DEFAULT=1024
LAKEKEEPER_PAGINATION_SIZE_MAX=2048

# Production-only (off by default; operator opt-in):
# LAKEKEEPER__OPENID_PROVIDER_URI=infisical://dev-baile/lakehouse/openid_provider_uri
# LAKEKEEPER__OPENFGA__ENDPOINT=infisical://dev-baile/lakehouse/openfga_endpoint
# LAKEKEEPER__OPENFGA__STORE_NAME=lakekeeper

# =============================================================================
# Garage S3 Storage
# =============================================================================
# RPC secret for internal Garage communication (64+ char random string)
GARAGE_RPC_SECRET=infisical://dev-baile/lakehouse/rpc_secret

# Admin API token for Garage management
GARAGE_ADMIN_TOKEN=infisical://dev-baile/lakehouse/admin_token

# S3 access credentials
GARAGE_ACCESS_KEY_ID=infisical://dev-baile/lakehouse/access_key_id
GARAGE_SECRET_ACCESS_KEY=infisical://dev-baile/lakehouse/secret_access_key

# =============================================================================
# Lance Namespace Sidecar (Optional)
# =============================================================================
# Auth token for Lakekeeper (if authentication is enabled)
# LANCE_ICEBERG_AUTH_TOKEN=infisical://dev-baile/lakehouse/service_token

# =============================================================================
# Cloudflare R2 (Remote Object Storage)
# =============================================================================
# S3-compatible cloud storage for production deployments
R2_ACCESS_KEY_ID=infisical://dev-baile/lakehouse/access_key_id
R2_SECRET_ACCESS_KEY=infisical://dev-baile/lakehouse/secret_access_key
R2_ACCOUNT_ID=infisical://dev-baile/lakehouse/account_id
R2_BUCKET_NAME=lakehouse

# =============================================================================
# MotherDuck (Remote Query Engine)
# =============================================================================
# CHANGED 2026-08-01 (lakehouse-and-reproducible-deploy-v1):
#   Removed the duplicate `lakehouse/token` path. The canonical path
#   is `dev-baile/motherduck/token` (also exported by oideachais).
#   This single-token path prevents the BIEP v3 MotherDuck Flights from
#   racing between two Infisical entries.
#
# Cloud-hosted DuckDB for production analytics
MOTHERDUCK_TOKEN=infisical://dev-baile/motherduck/token

# MotherDuck hosting-mode knobs (per openspec/specs/infrastructure-stacks
# Requirement "MotherDuck hosting-mode env contract"). Defaults work in dev;
# operators override these in .env.local for the managed MotherDuck hosting
# migration (the 2026-08-12-biep-v3-motherduck-flights-v1 change).
MOTHERDUCK_MODE=byob
MOTHERDUCK_DATABASE=cianfhoghlaim
MOTHERDUCK_S3_BUCKET=ducklake-cianfhoghlaim
MOTHERDUCK_S3_ENDPOINT=http://lakehouse-garage:3900

# Canonical embedder env vars (per openspec/specs/cianfhoghlaim-pipeline
# Requirement "Embedder env-var contract"). Read by
# cocoindex/_shared/_lifespan.py at module load. Operators override
# for OCR-HTR / domain-adaptation experiments.
CIANFHOGHLAIM_EMBED_MODEL=BAAI/bge-m3
CIANFHOGHLAIM_EMBED_DIM=1024

# Canonical DuckLake bucket name (matches the garage-init 1-shot service
# bucket creation at lakehouse/compose.yaml:158)
DUCKLAKE_BUCKET=ducklake

# =============================================================================
# Nimtable Iceberg Catalog UI (extend-lakehouse-with-nimtable-olake-lancedb)
# =============================================================================
# JDBC password for the Spring Boot DataSource
NIMTABLE_JDBC_PASSWORD=infisical://dev-baile/lakehouse/jdbc_password
# Dashboard secret (CSRF token)
NIMTABLE_DASHBOARD_SECRET=infisical://dev-baile/lakehouse/dashboard_secret

# =============================================================================
# Olake CDC Engine (extend-lakehouse-with-nimtable-olake-lancedb)
# =============================================================================
# JDBC password for the olake_state database
OLAKE_JDBC_PASSWORD=infisical://dev-baile/lakehouse/jdbc_password
# Source Postgres password (the DB being replicated FROM)
OLAKE_SOURCE_PG_PASSWORD=infisical://dev-baile/lakehouse/source_pg_password
# Iceberg writer S3 secret key (for writing to Garage)
OLAKE_WRITER_S3_SECRET_KEY=infisical://dev-baile/lakehouse/writer_s3_secret_key

# =============================================================================
# LanceDB Viewer (extend-lakehouse-with-nimtable-olake-lancedb)
# =============================================================================
# Admin token for the LanceDB viewer
LANCEDB_VIEWER_ADMIN_TOKEN=infisical://dev-baile/lakehouse/lancedb_viewer_admin_token

# =============================================================================
# ClickHouse (Centralised Columnar Engine — added 2026-07, centralise-data-plane)
# =============================================================================
# Consumed by the langfuse stack for trace analytics + batch export.
CLICKHOUSE_USER=infisical://dev-baile/lakehouse-clickhouse/user
CLICKHOUSE_PASSWORD=infisical://dev-baile/lakehouse-clickhouse/password
CLICKHOUSE_DB=infisical://dev-baile/lakehouse-clickhouse/db

# ClickHouse TLS cert (added 2026-08-15-lakehouse-memory-stack Phase B for the
# managed-cloud path; the local container doesn't need it).
CLICKHOUSE_TLS_CERT=infisical://dev-baile/lakehouse-clickhouse/tls_cert

# =============================================================================
# Redis (Centralised Queue/Cache — added 2026-07, centralise-data-plane)
# =============================================================================
# Consumed by the langfuse stack for ingestion queue + cache.
REDIS_PASSWORD=infisical://dev-baile/lakehouse-redis/password
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Redis TLS cert (added 2026-08-15-lakehouse-memory-stack Phase B for the
# managed-cloud path; the local container doesn't need it).
REDIS_TLS_CERT=infisical://dev-baile/lakehouse-redis/tls_cert

# Cloudflare R2 endpoint (added 2026-08-15-lakehouse-memory-stack Phase B so
# the BIEP Flights + Dagster assets can write to R2 directly when the
# operator has not configured the local Garage S3 backend).
R2_ENDPOINT_URL=infisical://dev-baile/lakehouse/r2_endpoint_url

# =============================================================================
# COGNEE - Knowledge Graph Builder (added 2026-08-15-lakehouse-unified-data-plane-v1)
# =============================================================================
# Cognee uses the SHARED lakehouse-postgres at database `cognee_cianfhoghlaim`
# (created in init-db.sql) via a dedicated `cognee` user (created by
# init-cognee-user.sh — added 2026-08-23). The cognee user has permissions
# ONLY on cognee_cianfhoghlaim (not the other 13 databases) for security
# best-practice.
#
# LLM is provided by the LiteLLM proxy (bonneagar/stacks/litellm at :4000).
# cognee's openai client sends LLM_API_KEY in the Authorization header;
# LiteLLM forwards it as the upstream API key (which DeepSeek rejects).
# Solution: LLM_API_KEY=no-key-needed so litellm falls back to its own
# DEEPSEEK_API_KEY env var.
COGNEE_POSTGRES_USER=cognee  # ADDED 2026-08-23 (was: shared POSTGRES_USER=lakekeeper)
COGNEE_POSTGRES_PASSWORD=infisical://dev-baile/lakehouse/cognee_postgres_password  # ADDED 2026-08-23
COGNEE_LLM_API_KEY=infisical://dev-baile/cognee/llm_api_key
COGNEE_EMBEDDING_API_KEY=infisical://dev-baile/cognee/embedding_api_key
COGNEE_LLM_MODEL=infisical://dev-baile/cognee/llm_model
COGNEE_EMBEDDING_MODEL=infisical://dev-baile/cognee/embedding_model
# LANCEDB_API_KEY is the Lance Namespace API key (cognee writes embedding
# vectors to Lance Namespace at lakehouse-lance-namespace:8182).
LANCEDB_API_KEY=infisical://dev-baile/lancedb/api_key
# LANCEDB_NAMESPACE_TOKEN is the Lance Namespace 0.9 contract token
# (the `header.<name>` context-header prefix replaces the pre-v0.9
# `x-lance-ctx-<name>` convention).
LANCEDB_NAMESPACE_TOKEN=infisical://dev-baile/lancedb/namespace_token
# Observability (OTEL → logfire-otel:4317 fan-out → logfire cloud + langfuse)
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/logfire/otel_endpoint
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key
# Optional: override the LiteLLM model alias (default: deepseek/deepseek-chat)
# COGNEE_LLM_MODEL=extract              # Gemini 2.5 Pro → GLM 4.6 → Gemini Flash (blocked)
# COGNEE_LLM_MODEL=local/irish/uccix    # Local GGUF Irish
# COGNEE_LLM_MODEL=openai/glm-4.6       # Cloud GLM 4.6
# Galileo AI observability (optional — token-pricing + drift alerts)
GALILEO_API_KEY=infisical://dev-baile/cognee/galileo_api_key
# PlanetScale PG override (optional — opt-in to managed PG instead of
# local lakehouse-postgres)
PLANETSCALE_DATABASE_URL=infisical://dev-baile/cognee/planetscale_database_url
# Authentication toggles (set both to true in production behind Pocket ID SSO)
REQUIRE_AUTHENTICATION=false
ENABLE_BACKEND_ACCESS_CONTROL=false
# Port (default: 8000; hosts map 8000:8000)
COGNEE_PORT=8000
# 6 canonical datasets (aistear + primary + JC + SC + tertiary + cross_stage)
COGNEE_DATABASES=cianfhoghlaim.education.aistear,cianfhoghlaim.education.primary,cianfhoghlaim.education.junior_cycle,cianfhoghlaim.education.senior_cycle,cianfhoghlaim.education.tertiary,cianfhoghlaim.education.cross_stage

# =============================================================================
# GRAPHITI - Bi-temporal Knowledge Graph (added 2026-08-15-lakehouse-unified-data-plane-v1)
# =============================================================================
# Graphiti uses the SHARED falkordb container (Redis protocol at falkordb:6379).
# Neo4j backend was REMOVED (no Neo4j stack exists in KCG).
FALKORDB_PASSWORD=infisical://dev-baile/falkordb/password
FALKORDB_GRAPHITI_DB=infisical://dev-baile/graphiti/falkordb_database
# Port (default: 8001; hosts map 8001:8000 — cognee already uses 8000)
GRAPHITI_PORT=8001
# LLM key (canonical backbone is LiteLLM at http://litellm:4000/v1).
# Graphiti uses OpenAI-compatible client; OPENAI_BASE_URL points at LiteLLM.
OPENAI_API_KEY=infisical://dev-baile/graphiti/openai_api_key
OPENAI_BASE_URL=infisical://dev-baile/graphiti/openai_base_url
# Langfuse SDK-side traces
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key

# =============================================================================
# FALKORDB - Graph DB + vector.so (added 2026-08-15-lakehouse-unified-data-plane-v1)
# =============================================================================
# Production-tuned per the official FalkorDB Docker best practices.
# The unified falkordb container serves BOTH graphiti (at falkordb:6379)
# AND any standalone client (the deprecated falkordb stack is gone).
FALKORDB_PORT=6379
FALKORDB_UI_PORT=3000
# Path to the bundled vector module (loaded via `falkordb --loadmodule`).
# VECTOR_MODULE_URL is the runtime-resolvable URL (e.g. file:// path).
VECTOR_MODULE_URL=infisical://dev-baile/falkordb/vector_module_url
# Cluster mode toggle: "no" (single-node, dev default) | "yes" (cluster)
CLUSTER_MODE=no
# Production args (THREAD_COUNT 8 + CACHE_SIZE 50 + TIMEOUT_MAX 60000)
FALKORDB_ARGS=THREAD_COUNT 8 CACHE_SIZE 50 TIMEOUT_MAX 60000

# =============================================================================
# MEMGRAPH - In-Memory Graph DB + MAGE (added 2026-08-15-lakehouse-unified-data-plane-v1)
# =============================================================================
# Bolt protocol + in-memory storage. NO Postgres needed (Bolt uses TCP/7687).
MEMGRAPH_BOLT_PORT=7687
MEMGRAPH_HTTP_PORT=7444
MEMGRAPH_LAB_PORT=3001
MEMGRAPH_USER=infisical://dev-baile/memgraph/username
MEMGRAPH_PASSWORD=infisical://dev-baile/memgraph/password
# Memgraph 3.x Enterprise license (optional; CE works without it)
MEMGRAPH_LICENSE_FILE_PATH=infisical://dev-baile/memgraph/license_file_path
# Log verbosity (default: WARNING)
MEMGRAPH_LOG_LEVEL=WARNING

# =============================================================================
# OBSERVABILITY (added 2026-08-25-lakehouse-observability-and-cross-stack-integration-v1)
# =============================================================================
# Per the user preference: prioritize Langfuse + MLflow + Logfire (NOT
# Prometheus/Grafana). The 16 lakehouse services emit OTLP traces to either
# the local otel-collector (profile `otel`) or the existing logfire-otel
# cross-stack collector. Both fan out to Langfuse + Logfire + MLflow.

# MLflow tracking URI (the lakehouse-postgres `mlflow` database is auto-created)
MLFLOW_TRACKING_URI=infisical://dev-baile/lakehouse/mlflow_tracking_uri
# MLflow artifact root (uses Garage S3)
MLFLOW_DEFAULT_ARTIFACT_ROOT=infisical://dev-baile/lakehouse/mlflow_default_artifact_root

# Langfuse SDK auth (used by Cognee + Graphiti for trace submission)
# These are DUPLICATED in .infisical.env.observability for clarity.
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key

# Logfire cloud (SaaS) — required for OTLP fan-out to logfire.pydantic.dev
LOGFIRE_TOKEN=infisical://dev-baile/pydantic-logfire/write_token
LOGFIRE_PROJECT_NAME=infisical://dev-baile/pydantic-logfire/project_name
LOGFIRE_ENVIRONMENT=infisical://dev-baile/pydantic-logfire/environment

# Langfuse Basic auth header (base64-encoded "PUBLIC_KEY:SECRET_KEY")
# Constructed by Locket sidecar from LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY.
LANGFUSE_AUTH_HEADER=infisical://dev-baile/langfuse/auth_header
