# =============================================================================
# RYBBIT - Environment Variable Catalogue
# =============================================================================
# Generated by scripts/generate-stack-env-example.ts on 2026-07-08T17:46:34.719Z
#
# Documents every ${VAR} reference in rybbit/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     docker compose -f compose.yaml -f sidecar.yaml up -d
#   For production: rely on Locket (no .env needed).
#
# The real values are stored in the dev-baile Infisical vault;
# the Locket sidecar injects them at container runtime.
# =============================================================================

# =============================================================================
# RYBBIT secrets (Locket resolves these at container runtime)
# =============================================================================

# POSTGRES_USER=<dev-baile value>
POSTGRES_USER=

# POSTGRES_PASSWORD=<dev-baile value>
POSTGRES_PASSWORD=

# CLICKHOUSE_PASSWORD=<dev-baile value>
CLICKHOUSE_PASSWORD=

# BETTER_AUTH_SECRET=<dev-baile value>
BETTER_AUTH_SECRET=

# MAPBOX_TOKEN=<dev-baile value>
MAPBOX_TOKEN=

# DOMAIN_NAME=<dev-baile value>
DOMAIN_NAME=

# BASE_URL=<dev-baile value>
BASE_URL=

# DISABLE_SIGNUP=<dev-baile value>
DISABLE_SIGNUP=

# DISABLE_TELEMETRY=<dev-baile value>
DISABLE_TELEMETRY=

# =============================================================================
# Infisical + Locket (canonical)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
