# =============================================================================
# HERMES — Locket Secrets Template
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile/hermes/ (9 total):
#   api_server_key              — admin API token (random 32-char hex)
#   openai_api_key              — LITELLM_MASTER_KEY (re-keyed at the Infisical layer)
#   openai_base_url             — http://litellm:4000/v1
#   langfuse_public_key         — Langfuse public key
#   langfuse_secret_key         — Langfuse secret key
#   langfuse_base_url           — Langfuse public URL
#   telegram_bot_token          — Telegram BotFather bot token (separate from openclaw)
#   discord_bot_token           — Discord bot token (separate from openclaw)
#   operator_pocket_id_subject  — The operator's Pocket ID subject (for day-one allowlist)
# =============================================================================

# Admin API token (used to call /api/users/allowlist/* and /api/sessions/*)
HERMES_API_SERVER_KEY={{ infisical:///hermes/api_server_key }}

# LLM provider — LiteLLM chokepoint (M3 plan)
OPENAI_API_KEY={{ infisical:///hermes/openai_api_key }}
OPENAI_BASE_URL={{ infisical:///hermes/openai_base_url }}

# Langfuse observability
LANGFUSE_PUBLIC_KEY={{ infisical:///hermes/langfuse_public_key }}
LANGFUSE_SECRET_KEY={{ infisical:///hermes/langfuse_secret_key }}
LANGFUSE_BASE_URL={{ infisical:///hermes/langfuse_base_url }}

# Channel credentials (resolved at startup; missing values just disable the channel)
TELEGRAM_BOT_TOKEN={{ infisical:///hermes/telegram_bot_token }}
DISCORD_BOT_TOKEN={{ infisical:///hermes/discord_bot_token }}

# Operator's Pocket ID subject (for day-one allowlist population)
HERMES_OPERATOR_POCKET_ID_SUBJECT={{ infisical:///hermes/operator_pocket_id_subject }}

# Observability — Langfuse OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT={{ infisical:///hermes/otel_exporter_otlp_endpoint }}
