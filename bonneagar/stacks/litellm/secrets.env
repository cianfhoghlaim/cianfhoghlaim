# =============================================================================
# LITELLM — Locket Secrets Template
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
# The folder path is a query param (locket v0.17+ / Infisical v0.161+ model).
# =============================================================================

# Gateway
LITELLM_MASTER_KEY={{ infisical:///master_key?path=/litellm }}
LITELLM_SALT_KEY={{ infisical:///salt_key?path=/litellm }}

# Database — uses the lakehouse shared postgres
LITELLM_DATABASE_URL={{ infisical:///litellm_database_url?path=/litellm }}
LITELLM_POSTGRES_USER={{ infisical:///postgres_user?path=/litellm }}
LITELLM_POSTGRES_PASSWORD={{ infisical:///postgres_password?path=/litellm }}
LITELLM_POSTGRES_DB={{ infisical:///postgres_db?path=/litellm }}

# Cloud LLM providers
DEEPSEEK_API_KEY={{ infisical:///api_key?path=/deepseek }}
GEMINI_API_KEY={{ infisical:///api_key?path=/gemini }}
ANTHROPIC_API_KEY={{ infisical:///api_key?path=/anthropic }}
OPENAI_API_KEY={{ infisical:///api_key?path=/openai }}
Z_AI_API_KEY={{ infisical:///api_key?path=/zai }}
ZAI_API_KEY={{ infisical:///api_key?path=/zai }}
# OpenCode Go — canonical key + 3 parallel slots for round-robin
OPENCODE_GO_API_KEY={{ infisical:///api_key?path=/opencode-go }}
OPENCODE_GO_API_KEY_0={{ infisical:///api_key_slot0?path=/opencode-go }}
OPENCODE_GO_API_KEY_1={{ infisical:///api_key_slot1?path=/opencode-go }}
OPENCODE_GO_API_KEY_2={{ infisical:///api_key_slot2?path=/opencode-go }}

# HuggingFace
HF_TOKEN={{ infisical:///token?path=/huggingface }}
HUGGINGFACE_HUB_TOKEN={{ infisical:///token?path=/huggingface }}
HUGGINGFACE_TOKEN={{ infisical:///token?path=/huggingface }}

# Observability (consumers)
LANGFUSE_HOST={{ infisical:///host?path=/langfuse }}
LANGFUSE_PUBLIC_KEY={{ infisical:///public_key?path=/langfuse }}
LANGFUSE_SECRET_KEY={{ infisical:///secret_key?path=/langfuse }}
MLFLOW_TRACKING_URI={{ infisical:///tracking_uri?path=/mlflow }}
LANCEDB_API_KEY={{ infisical:///api_key?path=/lancedb }}