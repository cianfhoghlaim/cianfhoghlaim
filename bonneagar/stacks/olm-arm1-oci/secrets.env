# =============================================================================
# OLM (Pangolin Tunnel Client) — Locket secrets template
# =============================================================================# Placeholders use Infisical's URI scheme per locket docs (see
# stacks/pangolin/secrets.env for the canonical pattern):
#   infisical:///<secret-name>?path=<folder>
#
# Locket resolves these to real values from the Infisical vault
# (vault: dev-baile, path: /olm-arm1-oci) and writes the rendered
# file to /run/secrets/locket/secrets.env inside the container.
# =============================================================================

# OLM site credentials (created via Pangolin UI -> Sites -> Create Site -> OLM)
OLM_ID=infisical://dev-baile/olm-arm1-oci/id
OLM_SECRET=infisical://dev-baile/olm-arm1-oci/secret
