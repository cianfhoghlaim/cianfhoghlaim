# OLM (Pangolin Tunnel Client) - ARM1-OCI — environment variables
# These are dev defaults. In production, all values are resolved by Locket
# from the Infisical vault (dev-baile, path: /olm-arm1-oci).

# Pangolin endpoint
PANGOLIN_ENDPOINT=https://pangolin.cianfhoghlaim.ie

# OLM site credentials (set via Pangolin UI after creating the OLM site)
OLM_ID=
OLM_SECRET=
