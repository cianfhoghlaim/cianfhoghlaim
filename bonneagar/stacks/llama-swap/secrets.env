# =============================================================================
# LLAMA-SWAP - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# llama-swap is the dynamic GGUF model swapper; it does not directly
# consume LiteLLM's master key (litellm routes to llama-swap under the
# hood for v4 Unsloth GGUFs). GATEWAY_URL is configuration, not a
# secret, and stays as a literal. GATEWAY_API_KEY is intentionally blank
# (no upstream auth required on the internal subnet); the placeholder
# is kept here so downstream tooling that scans for `infisical://`
# ref-counts this file.
#
# To add a secret: append `KEY=infisical://dev-baile/llama-swap/KEY` and
# register the value in the dev-baile Infisical project (path `/llama-swap`).
# =============================================================================

LOCKET_MODE=watch
GATEWAY_URL=http://litellm:4000
