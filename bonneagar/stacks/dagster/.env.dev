# Dagster dev secrets (dev mode only — NEVER commit anything other than dev values)
#
# The dagster webserver + daemon use the lakehouse as their data plane.
# All DUCKLAKE_* + AWS_* + LITELLM_* + LANGFUSE_* env vars match the
# lakehouse stack's centralized config.

# Lakehouse DuckLake (Postgres backend for Dagster run/event/schedule storage)
DUCKLAKE_POSTGRES_HOST=lakehouse-postgres
DUCKLAKE_POSTGRES_PORT=5432
DUCKLAKE_POSTGRES_USER=lakekeeper
DUCKLAKE_POSTGRES_PASSWORD=devpassword
USE_DUCKLAKE=true
DLT_ENVIRONMENT=development

# Lakehouse Garage S3 (artifact store)
AWS_ACCESS_KEY_ID=GK1601dev
AWS_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
AWS_ENDPOINT_URL=http://lakehouse-garage:3900
AWS_REGION=garage
AWS_DEFAULT_REGION=garage

# LLM (consumed by BAML + agents that Dagster orchestrates)
ANTHROPIC_API_KEY=not-needed-in-dev
OPENAI_API_KEY=sk-1234

# LiteLLM gateway (the canonical LLM chokepoint)
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-1234

# Langfuse observability
LANGFUSE_PUBLIC_KEY=pk-lf-dev
LANGFUSE_SECRET_KEY=sk-lf-dev
LANGFUSE_HOST=http://langfuse:3000

# Logfire (OTel collector for self-hosted trace sink)
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire:4317

# LanceDB (the lakehouse-lance-namespace REST adapter)
LANCEDB_URI=rest://lakehouse-lance-namespace:8182

# Dagster home (persistent volume mount)
DAGSTER_HOME=/opt/dagster/home
