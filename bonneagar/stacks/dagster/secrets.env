# =============================================================================
# DAGSTER UNIFIED - Locket Secrets Template (PlanetScale PG migration)
# =============================================================================
# Template file for Locket secret injection.
# Uses canonical Infisical URI references (infisical://dev-baile/<svc>/<key>).
#
# Per openspec/changes/2026-07-19-planetscale-postgres-migration-phase-b0-v1/
# Phase B.0 ships Dagster as an ENV SWAP ONLY (not a hard switch). The
# local `dagster-postgres` container remains in compose.yaml as a fallback
# (retired in Phase B.1).
#
# LOCKET USAGE:
#   locket exec --provider infisical \
#     --connect.host http://132.145.27.89:8080 \
#     --connect.token-file /path/to/token \
#     --env-file secrets.env \
#     -- docker compose -f compose.yaml -f sidecar.yaml up -d
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile (Phase B.0):
#   dagster/  database_url (NEW for PlanetScale PG), garage_access_key,
#             garage_secret_key, anthropic_api_key, openai_api_key,
#             langfuse_public_key, langfuse_secret_key
#
# DUCKLAKE_POSTGRES_PASSWORD is RETAINED for the local `dagster-postgres`
# fallback (Phase B.1 retires it).
#
# CHANGED 2026-07-30 (env-contract-and-observability-fanout-v1):
#   Migrated from mixed bare + Jinja forms to canonical bare
#   `infisical://dev-baile/<svc>/<key>` form. See spec delta
#   openspec/changes/2026-07-30-.../specs/infrastructure-stacks/spec.md.
# =============================================================================

# PlanetScale PG — Locket-injected from Infisical (Phase B.0 env swap)
DUCKLAKE_POSTGRES_HOST=infisical://dev-baile/dagster/database_url
DUCKLAKE_POSTGRES_PORT=5432
DUCKLAKE_POSTGRES_USER=planetscale_user_dagster
DUCKLAKE_POSTGRES_PASSWORD=infisical://dev-baile/dagster/database_password
DUCKLAKE_POSTGRES_DB=dagster_state
DUCKLAKE_POSTGRES_SSLMODE=require

# Local `dagster-postgres` fallback (Phase B.1 retires it)
DUCKLAKE_POSTGRES_LOCAL_PASSWORD=infisical://dev-baile/dagster/ducklake_postgres_password

# Garage S3 (shared with lakehouse stack)
AWS_ACCESS_KEY_ID=infisical://dev-baile/dagster/garage_access_key
AWS_SECRET_ACCESS_KEY=infisical://dev-baile/dagster/garage_secret_key

# LLM API Keys (reused from opencode + openai items in dev-baile)
ANTHROPIC_API_KEY=infisical://dev-baile/anthropic/api_key
OPENAI_API_KEY=infisical://dev-baile/openai/api_key

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key
LANGFUSE_HOST=infisical://dev-baile/langfuse/host

# MotherDuck hosting-mode knobs (per openspec spec delta on
# infrastructure-stacks Requirement "MotherDuck hosting-mode env contract").
# Defaults work in dev; operators override for the managed hosting migration.
MOTHERDUCK_MODE=byob
MOTHERDUCK_DATABASE=cianfhoghlaim
MOTHERDUCK_S3_BUCKET=ducklake-cianfhoghlaim
MOTHERDUCK_S3_ENDPOINT=http://lakehouse-garage:3900
MOTHERDUCK_TOKEN=infisical://dev-baile/motherduck/token

# Canonical embedder env vars (per openspec spec delta on
# cianfhoghlaim-pipeline Requirement "Embedder env-var contract").
# Read by cocoindex/_shared/_lifespan.py at module load.
CIANFHOGHLAIM_EMBED_MODEL=BAAI/bge-m3
CIANFHOGHLAIM_EMBED_DIM=1024

# Canonical DuckLake bucket name (matches garage-init bucket creation)
DUCKLAKE_BUCKET=ducklake-cianfhoghlaim