# Template env file for the tuatha-media-intel stack.
# Copy to `.env` and either fill in dev values OR ensure the Locket
# sidecar hydrates every value from Infisical (recommended for prod).

# --- LLM / VLM routing ---
LLAMASWAP_URL=http://llamaswap.cianfhoghlaim.lan:8080/v1
LLAMASWAP_API_KEY=sk-dev-llamaswap-no-real-secret
LITELLM_URL=http://litellm.cianfhoghlaim.lan:4000/v1
LITELLM_API_KEY=sk-dev-litellm-no-real-secret

# Resolved via MODEL_REGISTRY at runtime. Defaults point at the dev/local
# GGUF builds loaded into llama-swap.
VISION_MODEL_HADES=qwen3-vl-8b
VISION_MODEL_COMIC=qwen3-vl-8b
VISION_MODEL_GBA=qwen3-vl-4b
TEXT_MODEL_DEFAULT=minimax-m3

# --- Storage ---
TUATHA_LANCE_URI=file:///data/tuatha_lance
TUATHA_RAW_HADES_BUCKET=s3://cianfhoghlaim-tuatha-raw/hades
TUATHA_RAW_COMIC_BUCKET=s3://cianfhoghlaim-tuatha-raw/comic
TUATHA_RAW_GBA_BUCKET=s3://cianfhoghlaim-tuatha-raw/gba

# --- Observability ---
MLFLOW_TRACKING_URI=http://mlflow.cianfhoghlaim.lan:5000
MLFLOW_TRACKING_TOKEN=mlflow-dev-no-real-token
LANGFUSE_SECRET_KEY=lfs-dev-secret
LANGFUSE_PUBLIC_KEY=lfp-dev-public
LANGFUSE_HOST=http://langfuse.cianfhoghlaim.lan:3000

# --- BAML ---
BAML_LICENSE_KEY=baml-dev-no-real-key

# --- Locket ---
LOCKET_INFISICAL_TOKEN=infisical-dev-no-real-token
LOCKET_PROJECT_ID=tuatha-media-intel

# --- Monorepo root (mounted read-only into cocoindex-runner) ---
TUATHA_MONOREPO_ROOT=/Users/cianmacandeisigh/dev/cianfhoghlaim
TUATHA_EMBED_DEVICE=cpu
