# Secrets for the tuatha-media-intel stack.
# Every value is sourced from Infisical via Locket at runtime — never check
# a real secret into this file. The values below are the Infisical URI
# template + the destination env var that the stack expects.

# --- LLM / VLM routing (resolved via MODEL_REGISTRY at runtime) -------------
LLAMASWAP_URL=infisical://dev-baile/tuatha-media-intel/llamaswap-url
LLAMASWAP_API_KEY=infisical://dev-baile/tuatha-media-intel/llamaswap-api-key
LITELLM_URL=infisical://dev-baile/tuatha-media-intel/litellm-url
LITELLM_API_KEY=infisical://dev-baile/tuatha-media-intel/litellm-api-key

# Model names — never hardcoded in extractor code. Resolved at runtime
# via MODEL_REGISTRY.resolve("ocr_vision", "tier2_medium") etc.
VISION_MODEL_HADES=infisical://dev-baile/tuatha-media-intel/vision-model-hades
VISION_MODEL_COMIC=infisical://dev-baile/tuatha-media-intel/vision-model-comic
VISION_MODEL_GBA=infisical://dev-baile/tuatha-media-intel/vision-model-gba
TEXT_MODEL_DEFAULT=infisical://dev-baile/tuatha-media-intel/text-model-default

# --- Storage (the Pangolin-private tuatha bucket) ---------------------------
TUATHA_LANCE_URI=infisical://dev-baile/tuatha-media-intel/lance-uri
TUATHA_RAW_HADES_BUCKET=infisical://dev-baile/tuatha-media-intel/raw-hades-bucket
TUATHA_RAW_COMIC_BUCKET=infisical://dev-baile/tuatha-media-intel/raw-comic-bucket
TUATHA_RAW_GBA_BUCKET=infisical://dev-baile/tuatha-media-intel/raw-gba-bucket

# --- Observability -----------------------------------------------------------
MLFLOW_TRACKING_URI=infisical://dev-baile/tuatha-media-intel/mlflow-tracking-uri
MLFLOW_TRACKING_TOKEN=infisical://dev-baile/tuatha-media-intel/mlflow-tracking-token
LANGFUSE_SECRET_KEY=infisical://dev-baile/tuatha-media-intel/langfuse-secret-key
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/tuatha-media-intel/langfuse-public-key
LANGFUSE_HOST=infisical://dev-baile/tuatha-media-intel/langfuse-host

# --- BAML --------------------------------------------------------------------
BAML_LICENSE_KEY=infisical://dev-baile/tuatha-media-intel/baml-license-key

# --- Locket ------------------------------------------------------------------
LOCKET_INFISICAL_TOKEN=infisical://dev-baile/tuatha-media-intel/locket-infisical-token
LOCKET_PROJECT_ID=infisical://dev-baile/tuatha-media-intel/locket-project-id

# --- Monorepo root (the local path the CocoIndex runner reads from) ---------
TUATHA_MONOREPO_ROOT=infisical://dev-baile/tuatha-media-intel/monorepo-root
