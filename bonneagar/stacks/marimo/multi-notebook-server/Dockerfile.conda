# syntax=docker/dockerfile:1.4
# =============================================================================
# Marimo Multi-Notebook FastAPI Server (conda-forge base)
# =============================================================================
# Builds on continuumio/miniconda3:latest (Python 3.13 base). Uses
# conda + pip to install the marimo + FastAPI dependencies.
#
# Build:
#   docker build -t marimo-multinb:latest \
#     -f multi-notebook-server/Dockerfile.conda \
#     multi-notebook-server/
# =============================================================================

FROM continuumio/miniconda3:latest

WORKDIR /app

# Install marimo + FastAPI dependencies via pip (conda is too slow).
# duckdb is pinned explicitly rather than relying on the ibis extra: DuckLake
# 1.0 requires DuckDB >= 1.5.2, and the transitive pin is not guaranteed to
# satisfy that.
RUN pip install --no-cache-dir \
    'marimo>=0.13.0,<1.0.0' \
    'fastapi>=0.110.0' \
    'uvicorn[standard]>=0.27.0' \
    'duckdb>=1.5.2' \
    'ibis-framework[duckdb]>=9.0.0' \
    'pandas>=2.2.0' \
    'pyarrow>=15.0.0' \
    'litellm>=1.50.0'

# -----------------------------------------------------------------------------
# DuckDB extensions for the lakehouse
# -----------------------------------------------------------------------------
# This notebook server is the centralised entrypoint to the lakehouse, so the
# extensions that make that possible are baked into the image rather than
# installed on first use:
#
#   ducklake  — ATTACH 'ducklake:postgres:…' (the lakehouse table format)
#   postgres  — the DuckLake *catalog* lives in lakehouse-postgres
#   httpfs    — the DuckLake *data path* lives in Garage S3
#
# DuckLake needs BOTH the catalog and the storage extension; either alone is
# useless. Baking them in also avoids a runtime download on every cold start,
# and matters because HOME here is /root while the persistent volume is
# mounted at /home/marimo — runtime-installed extensions would NOT survive a
# container recreate.
RUN python -c "\
import duckdb; c = duckdb.connect(); \
[c.execute(f'INSTALL {e};') for e in ('ducklake', 'postgres', 'httpfs')]; \
print('installed:', [r[0] for r in c.execute(\
\"select extension_name from duckdb_extensions() where installed\").fetchall()])"

# Copy the FastAPI + marimo app
COPY main.py .

# Mount point for the notebooks (read-only)
RUN mkdir -p /notebooks

EXPOSE 2718

# Health check. Uses python, not curl: curl is NOT present in the
# miniconda base image, so a curl-based check reports the container
# permanently unhealthy while the app is in fact serving fine.
HEALTHCHECK --interval=30s --timeout=5s \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:2718/health', timeout=4).status==200 else 1)" || exit 1

# Entrypoint
CMD ["uvicorn", "main:api", "--host", "0.0.0.0", "--port", "2718"]
