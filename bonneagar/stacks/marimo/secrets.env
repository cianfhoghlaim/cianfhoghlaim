# =============================================================================
# MARIMO - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# marimo is the BCV notebook UI; it does not declare any runtime secret
# env vars. This file exists to satisfy the stack-doctor
# "must-have-secrets-env" gate + the LOCKET_MODE=watch header.
# To add a secret: append `KEY=infisical://dev-baile/marimo/KEY` and
# register the value in the dev-baile Infisical project (path `/marimo`).
# =============================================================================

LOCKET_MODE=watch
