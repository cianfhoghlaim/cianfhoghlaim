# Marimo dev secrets (dev mode only — NEVER commit anything other than dev values)
#
# The marimo container hosts the 11 marimo notebooks in
# cianfhoghlaim/notebooks/dashboards/. Of these, 4 (in duckdb/) directly
# query the lakehouse DuckLake via DuckDB-ATTACH. The 8 stage/cross-domain
# notebooks query Cognee datasets + LanceDB tables.
#
# These env vars are what the marimo CONTAINER needs to reach the
# lakehouse services (ducklake_explorer.py, lakehouse_inspector.py etc.).

# DuckDB → DuckLake ATTACH path (via lakehouse-postgres + lakehouse-garage)
DUCKLAKE_POSTGRES_HOST=lakehouse-postgres
DUCKLAKE_POSTGRES_PORT=5432
DUCKLAKE_POSTGRES_USER=lakekeeper
DUCKLAKE_POSTGRES_PASSWORD=devpassword
DLT_ENVIRONMENT=development
USE_DUCKLAKE=true

# Garage S3 (for DuckDB's S3 extension)
AWS_ACCESS_KEY_ID=GK1601dev
AWS_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
AWS_ENDPOINT_URL=http://lakehouse-garage:3900
AWS_REGION=garage

# LanceDB (the lakehouse-lance-namespace REST adapter)
LANCEDB_URI=rest://lakehouse-lance-namespace:8182

# Cognee
COGNEE_BASE=http://cognee:8000

# Dagster webserver (for cross-notebook pipeline-status queries)
DAGSTER_URL=http://dagster:3000

# OpenTelemetry (for the marimo notebook itself emitting spans)
OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire:4317
