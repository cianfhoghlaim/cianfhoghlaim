# =============================================================================
# MLFLOW - Locket Secrets Template (dev-baile vault) — canonical URI form
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# Updated for the 2026-08-15-lakehouse-memory-stack change (Phase B):
# - Migrated from the legacy Jinja `{{ infisical:///key?path=/mlflow }}` form
#   to the canonical `infisical://dev-baile/mlflow/<key>` form (per the
#   `agent-memory-systems` spec delta R "Memory-stack secret contract is
#   uniform across all 5 backends"). Both the ghcr.io/cianfhoghlaim/locket-shim
#   and the upstream bpbradley/locket image parse this canonical form.
# - Added PlanetScale DATABASE_URL override (per the umbrella
#   `planetscale-postgres-data-strategy` R7)
# - Added MLFLOW_S3_ENDPOINT_URL (the canonical Garage S3 backend)
# =============================================================================

# Tracking server URI (consumed by LiteLLM via MLFLOW_TRACKING_URI)
MLFLOW_TRACKING_URI=infisical://dev-baile/mlflow/tracking_uri

# Postgres backend store (consumed by mlflow container)
MLFLOW_POSTGRES_USER=infisical://dev-baile/mlflow/postgres_user
MLFLOW_POSTGRES_PASSWORD=infisical://dev-baile/mlflow/postgres_password

# Observability (OTEL → logfire-otel:4317 fan-out → logfire cloud + langfuse)
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/logfire/otel_endpoint

# Langfuse observability (host + project keys; resolved at runtime by the
# ghcr.io/cianfhoghlaim/locket-shim sidecar against dev-baile vault).
# MUST stay in Jinja form to be parseable by the mlflow sidecar (the shim
# only parses `infisical://dev-baile/X/KEY`; the upstream bpbradley/locket
# image used by other stacks also parses this form).
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key

# =============================================================================
# PlanetScale PG override (added 2026-08-15-lakehouse-memory-stack Phase B
# per the umbrella `planetscale-postgres-data-strategy` R7)
# =============================================================================
MLFLOW_PLANETSCALE_DATABASE_URL=infisical://dev-baile/mlflow/planetscale_database_url

# =============================================================================
# Garage S3 endpoint (added 2026-08-15-lakehouse-memory-stack Phase B so
# MLflow can write artifacts to the canonical lakehouse Garage S3 backend)
# =============================================================================
MLFLOW_S3_ENDPOINT_URL=infisical://dev-baile/mlflow/s3_endpoint
# ADDED 2026-08-22 (lakehouse-observability-stacks-modernization-v1):
# MLflow v3.5.0+ security middleware env vars (canonical form, supersedes CLI flags).
# MLFLOW_SERVER_ALLOWED_HOSTS=infisical://dev-baile/mlflow/allowed_hosts
# MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=infisical://dev-baile/mlflow/cors_allowed_origins

# MLflow v3.15+ tracing tunables
MLFLOW_TRACE_SAMPLING_RATIO=1.0
MLFLOW_ENABLE_ASYNC_TRACE_LOGGING=true
MLFLOW_USE_DEFAULT_TRACER_PROVIDER=false
MLFLOW_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317/v1/traces

# ADDED 2026-08-22 (lakehouse-observability-stacks-modernization-v1):
# MLflow v3.15.1 security middleware env vars (canonical form, not CLI flags).
# These are loaded into the mlflow container's env to enable the v3.5.0+
# DNS-rebinding protection + CORS allow-list.
# MLFLOW_SERVER_ALLOWED_HOSTS=infisical://dev-baile/mlflow/allowed_hosts
# MLFLOW_SERVER_CORS_ALLOWED_ORIGINS=infisical://dev-baile/mlflow/cors_allowed_origins
