# =============================================================================
# MLFLOW - Locket Secrets Template (dev-baile vault) — ghcr.io/cianfhoghlaim/locket-shim format
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the ghcr.io/cianfhoghlaim/locket-shim:infisical-0.2.0
# sidecar against the dev-baile Infisical project (workspace UUID
# d900f50a-acbf-446b-b4f6-e439710253e4).
#
# The shim REQUIRES the open-brace OPEN key question path equals slash X
# close-brace template form (the legacy infisical://dev-baile/... form
# is not parsed). See bonneagar/scripts/cianfhoghlaim-locket-shim.py for the regex.
#
# The local Infisical vault (/mlflow folder) currently has 3 secrets
# (seeded by scripts/seed-bunchloch-litellm-langfuse-fallback.sh):
#   postgres_user       = "lakekeeper"
#   postgres_password   = real lakehouse PG password
#   tracking_uri        = "http://mlflow:5000"
#
# Lakehouse Garage S3 credentials are NOT in /mlflow -- they live in
# /lakehouse and are sourced from .env.local.deploy (resolved values
# snapshot).
# =============================================================================

# Tracking server URI (consumed by LiteLLM via MLFLOW_TRACKING_URI)
MLFLOW_TRACKING_URI={{ infisical:///tracking_uri?path=/mlflow }}

# Postgres backend store (consumed by mlflow container)
MLFLOW_POSTGRES_USER={{ infisical:///postgres_user?path=/mlflow }}
MLFLOW_POSTGRES_PASSWORD={{ infisical:///postgres_password?path=/mlflow }}