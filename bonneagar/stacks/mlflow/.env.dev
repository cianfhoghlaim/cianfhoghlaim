# MLflow dev secrets (dev mode only — NEVER commit anything other than dev values)
#
# MLflow uses the lakehouse-postgres (db=mlflow) for backend store
# + lakehouse-garage (bucket=mlflow-artifacts) for artifact store.

# Lakehouse Postgres backend
MLFLOW_BACKEND_STORE_URI=postgresql://lakekeeper:devpassword@lakehouse-postgres:5432/mlflow

# Lakehouse Garage S3
MLFLOW_S3_ENDPOINT_URL=http://lakehouse-garage:3900
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow-artifacts/
AWS_ACCESS_KEY_ID=GK1601dev
AWS_SECRET_ACCESS_KEY=dev-secret-key-not-for-prod
AWS_DEFAULT_REGION=garage
MLFLOW_S3_IGNORE_TLS=true

# Lakehouse Postgres user (for the backend store URL)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=devpassword
