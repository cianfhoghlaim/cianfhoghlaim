# =============================================================================
# MLFLOW - Local Deploy Env File (resolved values snapshot)
# =============================================================================
# Mirror of stacks/langfuse/.env.local.deploy -- provides docker compose
# the resolved values for ${VAR} interpolations in compose.yaml at parse
# time. The bons-locker-shim additionally resolves stack-specific Infisical
# refs from secrets.env at runtime, writing them to /run/secrets/locket.
#
# Sources:
#   INFISICAL_*       -- local Infisical fallback (host.docker.internal:8081)
#   POSTGRES_*        -- lakehouse stack (lakehouse/* vault + verified live)
#   AWS_* / GARAGE_*  -- lakehouse-garage stack (verified live 2026-07-28)
#
# Loaded via:
#   docker compose --env-file .env.local.deploy \
#     -f compose.yaml -f sidecar.yaml up -d
# =============================================================================

# Local Infisical fallback (bons-locker-shim endpoint)
INFISICAL_URL=http://host.docker.internal:8081
INFISICAL_PROJECT_ID=d900f50a-acbf-446b-b4f6-e439710253e4
INFISICAL_ENV=dev
INFISICAL_CLIENT_ID=7177c4ef-2688-4afa-982b-cc749d3ea3ad
INFISICAL_SECRET_FILE=/Users/cianmacandeisigh/.locket/infisical_secret
LOCKET_MODE=watch

# Lakehouse Postgres (db=mlflow -- created 2026-07-28)
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=805c7a4565f7ddf9bea11b6ffbd9a11f536cfe3beaaee7f9
MLFLOW_BACKEND_STORE_URI=postgresql://lakekeeper:805c7a4565f7ddf9bea11b6ffbd9a11f536cfe3beaaee7f9@lakehouse-postgres:5432/mlflow

# Lakehouse Garage (bucket=mlflow-artifacts -- auto-created by lakehouse stack)
# NOTE: these keys are verified live against the running lakehouse-garage
# container on this MacBook (2026-07-28). Earlier seed scripts
# (seed-bunchloch-litellm-langfuse-fallback.sh) reference the older
# GK3b427f19ad3fd54647e9a1ac key, which is still valid but secondary --
# the current primary lakehouse-key-final is GK6bf583493eeca31d6e0af566.
AWS_ACCESS_KEY_ID=GK6bf583493eeca31d6e0af566
AWS_SECRET_ACCESS_KEY=8bf1f9a97926efcd644f05e4e59240627cc3fddd38e230c98ecaa6c063596bea
GARAGE_ACCESS_KEY_ID=GK6bf583493eeca31d6e0af566
GARAGE_SECRET_ACCESS_KEY=8bf1f9a97926efcd644f05e4e59240627cc3fddd38e230c98ecaa6c063596bea
MLFLOW_S3_ENDPOINT_URL=http://lakehouse-garage:3900
MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://mlflow-artifacts/
AWS_DEFAULT_REGION=garage
MLFLOW_S3_IGNORE_TLS=true

# v3.5.0+ security middleware (mandatory when binding 0.0.0.0)
MLFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,mlflow.cianfhoghlaim.ie
MLFLOW_CORS_ALLOWED_ORIGINS=https://cianfhoghlaim.cianfhoghlaim.ie,http://localhost:3335

# Port mapping (5050 to dodge macOS AirPlay Receiver on 5000)
MLFLOW_PORT=5050