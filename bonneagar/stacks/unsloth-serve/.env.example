# Unsloth Serve — Local development environment file
# Copy this file to `.env` and fill in the values.

# Infisical defaults (auto-resolved by mise + locket in production)
INFISICAL_URL=http://132.145.27.89:8080
INFISICAL_CLIENT_ID=local-dev
INFISICAL_PROJECT_ID=local-dev
INFISICAL_ENV=dev-baile
INFISICAL_SECRET_FILE=/Users/cianmacandeisigh/.locket/infisical_secret

# Locket mode (watch = keep secrets in sync + clean shutdown)
LOCKET_MODE=watch

# OCR Router port (for the marimo 10-way comparison notebook)
OCR_ROUTER_PORT=8090

# Override the Unsloth image (defaults to `unsloth/unsloth:latest`)
# Use `unsloth/unsloth:cuda-latest` on arm1-oci (GPU)
# Use `unsloth/unsloth:latest` on bunchloch (CPU/MPS)
# UNSLOTH_IMAGE=unsloth/unsloth:latest
