# Unsloth Serve — Local Development .env
# =============================================================================
# This file is gitignored. It's the local-dev secret file used by the
# unsloth-serve stack when Infisical is unavailable. Operators run:
#
#   cp .env.example .env
#   # edit .env to set UNSLOTH_API_KEY
#   docker compose \
#     -f compose.yaml \
#     -f compose.m4-max.yaml \
#     -f compose.local-dev.yaml \
#     --env-file .env \
#     up -d
#
# Per the 2026-08-21-unsloth-v5-integration-v1 change (corrected in
# the 2026-08-21 hotfix commit). The upstream `unsloth run` mints an
# ephemeral key per launch; this is a STABLE vault key for the
# long-running daemon. For real production deploys, replace this with
# the Infisical-backed Locket sidecar (see sidecar.yaml).
# =============================================================================

# The Unsloth Studio API key. Required.
# Boot Unsloth Studio locally once to mint a key (Settings → API),
# or use the upstream CLI's ephemeral key.
UNSLOTH_API_KEY=sk-unsloth-dev-local-only-replace-in-prod

# The default model ID to serve. Can be overridden by env at deploy time.
# Options: unsloth/Qwen3.8-27B-GGUF, unsloth/DeepSeek-V4-Pro-0813-GGUF,
# unsloth/Kimi-K2.7-Code-GGUF, etc. (see MODEL_REGISTRY.filter(backend="unsloth"))
UNSLOTH_MODEL_ID=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL

# OpenTelemetry endpoint (optional; falls back to disabled if unreachable).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://logfire-otel:4317
