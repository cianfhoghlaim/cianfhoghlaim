# syntax=docker/dockerfile:1.4
# =============================================================================
# UNSLOTH-SERVE — Local-Dev Image (miniconda3 + unsloth Python package)
# =============================================================================
# Built locally for arm64 hosts (e.g., bunchloch M4 Max). The upstream
# `unsloth/unsloth:latest` image is x86_64-only. This image is built
# once locally and tagged as `unsloth-serve-local:latest`.
#
# Build:
#   docker build -t unsloth-serve-local:latest \
#     -f bonneagar/stacks/unsloth-serve/Dockerfile.local \
#     bonneagar/stacks/unsloth-serve/
#
# Then deploy via compose.local-dev.yaml.
# =============================================================================

FROM continuumio/miniconda3:latest

# Install unsloth + dependencies via pip
# The `unsloth` Python package provides the `unsloth` CLI
# (entry point: unsloth/unsloth.py:main)
RUN pip install --no-cache-dir \
    'unsloth[colab-new]==2026.8.19' \
    'litellm>=1.50.0' \
    'openai>=1.50.0' \
    'httpx>=0.27.0'

# Verify unsloth CLI is installed
RUN which unsloth && unsloth --version 2>&1 | head -3

# Create a non-root user (per the Locket shim pattern)
RUN useradd -m unsloth_user
USER unsloth_user

WORKDIR /home/unsloth
EXPOSE 8888 8889
