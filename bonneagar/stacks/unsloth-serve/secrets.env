# =============================================================================
# UNSLOTH-SERVE — Locket Secrets Template
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile/unsloth/ (2 total):
#   api_key    — the Unsloth Studio API key (starts with `sk-unsloth-`)
#   model_id   — the default model ID served (unsloth/Qwen3.8-27B-GGUF)
#
# This is a SINGLE SHARED key, not per-agent. The 5 agent stacks
# (hermes, openclaw, openchamber, cianfhoghlaim, openclaw-arm1-oci)
# all read the same key via Locket.
# =============================================================================

# Unsloth Studio API key (long-running daemon key; the upstream
# `unsloth run` mints an ephemeral key per launch but we use a
# stable vault key for the long-running daemon)
UNSLOTH_API_KEY=infisical://dev-baile/unsloth/api_key

# Default model ID (the `unsloth run` `--model` flag)
UNSLOTH_MODEL_ID=infisical://dev-baile/unsloth/model_id

# Observability — Langfuse OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/unsloth/otel_exporter_otlp_endpoint
