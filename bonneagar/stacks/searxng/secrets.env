# =============================================================================
# SEARXNG - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# SEARXNG_REDIS_URL is configuration (the redis socket inside the compose
# stack network), not a secret, but the canonical v4 contract pins every
# runtime env var to an `infisical://dev-baile/searxng/...` reference so
# Locket can hot-reload on vault updates. The literal redis URL is mirrored
# in compose.yaml.
#
# To add a secret: append `KEY=infisical://dev-baile/searxng/KEY` and
# register the value in the dev-baile Infisical project (path `/searxng`).
# =============================================================================

LOCKET_MODE=watch
SEARXNG_REDIS_URL=infisical://dev-baile/searxng/redis_url
