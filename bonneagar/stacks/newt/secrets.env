# =============================================================================
# NEWT - Locket-secret references (Infisical dev-baile vault)
# =============================================================================
# All 3 secrets are resolved at runtime by Locket from the dev-baile vault
# at the `pangolin/newt-bunchloch` path:
#   - newt_id           (random 32-char hex)
#   - newt_secret       (random 32-char hex)
#   - onboarding_key    (PEM-encoded public key for komodo-periphery)
#
# The `infisical_secret` file is the machine identity for the
# `infisical-machine-identity-newt` client (used by Locket).
# =============================================================================

# Newt WireGuard tunnel credentials (Pangolin-side)
NEWT_ID={{ infisical:///newt_id }}
NEWT_SECRET={{ infisical:///newt_secret }}

# Komodo-periphery onboarding key (the per-host passkey for registering
# the bunchloch-periphery container with the komodo-core on arm1-oci)
PERIPHERY_ONBOARDING_KEY={{ infisical:///onboarding_key }}

# The infisical_secret file path (Locket reads from this)
INFISICAL_SECRET_FILE=/etc/komodo/secrets/infisical_secret
