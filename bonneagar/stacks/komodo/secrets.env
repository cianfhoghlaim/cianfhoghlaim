# =============================================================================
# KOMODO - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# For local development, the `LOCKET_MODE=exec` one-shot can hydrate these
# values from the local `.env` (see scripts/bootstrap-pocket-id.sh for the
# sibling flow). Production deployments rely exclusively on the sidecar
# injection — never ship plaintext secrets to arm1-oci.
#
# To add a secret: append `KEY=infisical://dev-baile/komodo/KEY` and
# register the value in the dev-baile Infisical project (path `/komodo`).
# =============================================================================

LOCKET_MODE=watch
KOMODO_DATABASE_USERNAME=infisical://dev-baile/komodo/database_username
KOMODO_DATABASE_PASSWORD=infisical://dev-baile/komodo/database_password
