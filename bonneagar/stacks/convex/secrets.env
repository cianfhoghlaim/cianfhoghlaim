# =============================================================================
# CONVEX - Locket Secrets Template (PlanetScale PG migration)
# =============================================================================
# Per openspec/changes/2026-07-19-planetscale-postgres-migration-phase-b0-v1/
#
# Phase B.0 hard-switch: local SQLite volume removed; Convex connects
# directly to PlanetScale PG via Locket.
# All values are Locket-canonical `infisical://dev-baile/convex/...` URIs.
#
# Pre-requisites (operator creates these via the Infisical dashboard):
#   1. dev-baile/convex/database_url    → "postgresql://<user>:<pwd>@eu-west-3.pg.psdb.cloud/convex_production?sslmode=verify-full"
#   2. dev-baile/convex/instance_secret → a random string (Convex instance isolation)
# =============================================================================

# PlanetScale PG — Locket-injected from Infisical
CONVEX_DATABASE_URL=infisical://dev-baile/convex/database_url
CONVEX_INSTANCE_SECRET=infisical://dev-baile/convex/instance_secret

# Operational ports (UNCHANGED)
CONVEX_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211
CONVEX_INSTANCE_NAME=convex
DOCUMENT_RETENTION_DELAY=172800
RUST_LOG=info