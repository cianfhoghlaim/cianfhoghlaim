CALCOM_DB_PASSWORD=infisical://dev-baile/calcom/db_password
CALCOM_NEXTAUTH_SECRET=infisical://dev-baile/calcom/nextauth_secret
CALCOM_ENCRYPTION_KEY=infisical://dev-baile/calcom/encryption_key
CALCOM_WEBHOOK_SECRET=infisical://dev-baile/calcom/webhook_secret
# OIDC / SSO (configured via cal.com admin UI: /settings/organizations/sso)
# Callback URL: https://calcom.cianfhoghlaim.ie/api/auth/oidc
POCKETID_TEAM_WORKFLOW_CLIENT_SECRET=infisical://dev-baile/pocketid-team-workflow/client_secret
# NOTE: the DATABASE_URL + FALLBACK_DATABASE_URL lines below contain
# embedded-substring secrets. The bons-locket-shim's REF_RE only matches
# the Jinja form `{{ infisical:///KEY?path=/X }}` — it does NOT match the
# canonical `infisical://dev-baile/...` form for substring substitution.
# Therefore these lines MUST stay in the Jinja form so Locket can
# resolve the username/password at container start. The 2026-08-15
# normalize-script pass intentionally skipped them.
DATABASE_URL=postgresql://{{ infisical:///username?path=/planetscale }}:{{ infisical:///password?path=/planetscale }}@eu-west-3.pg.psdb.cloud:5432/bunchloch?sslmode=require&options=-c%20search_path%3Dcalcom
FALLBACK_DATABASE_URL=postgresql://calcom:{{ infisical:///db_password?path=/calcom }}@infisical-db:5432/calcom
