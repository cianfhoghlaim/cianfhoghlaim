# =============================================================================
# GRAPHITI - Locket Secrets Template (dev-baile vault)
# =============================================================================
# COMMITTED: yes. PLAINTEXT: NEVER.
# Resolved at container runtime by the Locket sidecar.
#
# Updated for the `centralise-data-plane` rewrite (2026-07-30):
# - The Neo4j backend was removed (no Neo4j stack in Cianfhoghlaim).
# - FALKORDB_PASSWORD is resolved from the shared falkordb vault.
# - OPENAI_API_KEY stays (graphiti uses it for entity extraction via
#   the LLM provider; canonical backbone is Bolmo / Molmo2 / Qwen3-VL
#   via LiteLLM).
# =============================================================================

# FalkorDB (shared with the falkordb stack)
FALKORDB_PASSWORD=infisical://dev-baile/falkordb/password

# Graphiti-specific
OPENAI_API_KEY=infisical://dev-baile/graphiti/openai_api_key
FALKORDB_GRAPHITI_DB=infisical://dev-baile/graphiti/falkordb_database

# =============================================================================
# Optional — override the LLM base URL (point at the LiteLLM gateway so all
# LLM calls flow through the unified routing layer). When unset, Graphiti
# uses its default OpenAI endpoint.
# Per the 2026-08-15-lakehouse-memory-stack change (Phase B).
# =============================================================================
OPENAI_BASE_URL=infisical://dev-baile/graphiti/openai_base_url

# =============================================================================
# Vector companion — FalkorDB hybrid queries (the `db.idx.vector.queryNodes`
# procedure). The `falkordb_vector_index` is created at startup via the
# `falkordb/compose.yaml` `vector.so` loadmodule flag (closes the open
# production drift alert).
# Per the 2026-08-15-lakehouse-memory-stack change (Phase B).
# =============================================================================
FALKORDB_VECTOR_INDEX=infisical://dev-baile/graphiti/falkordb_vector_index

# =============================================================================
# LanceDB vector companion — for the per-jurisdiction Lance tables
# that mirror the temporal graph for hybrid retrieval.
# Per the 2026-08-15-lakehouse-memory-stack change (Phase B).
# =============================================================================
LANCEDB_API_KEY=infisical://dev-baile/lancedb/api_key

# Observability (OTEL → logfire-otel:4317 fan-out → logfire cloud + langfuse)
OTEL_EXPORTER_OTLP_ENDPOINT=infisical://dev-baile/logfire/otel_endpoint
LANGFUSE_HOST=infisical://dev-baile/langfuse/host
LANGFUSE_PUBLIC_KEY=infisical://dev-baile/langfuse/public_key
LANGFUSE_SECRET_KEY=infisical://dev-baile/langfuse/secret_key
