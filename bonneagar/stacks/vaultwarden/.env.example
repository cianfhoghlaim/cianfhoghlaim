# =============================================================================
# VAULTWARDEN - Environment Variable Catalogue
# =============================================================================
# Generated by scripts/generate-stack-env-example.ts on 2026-07-08T17:46:34.719Z
#
# Documents every ${VAR} reference in vaultwarden/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     docker compose -f compose.yaml -f sidecar.yaml up -d
#   For production: rely on Locket (no .env needed).
#
# The real values are stored in the dev-baile Infisical vault;
# the Locket sidecar injects them at container runtime.
# =============================================================================

# =============================================================================
# VAULTWARDEN secrets (Locket resolves these at container runtime)
# =============================================================================

# VAULTWARDEN_ADMIN_TOKEN=<dev-baile value>
VAULTWARDEN_ADMIN_TOKEN=

# VAULTWARDEN_SMTP_PASSWORD=<dev-baile value>
VAULTWARDEN_SMTP_PASSWORD=

# SSO_OIDC_CLIENT_ID=<dev-baile value>
SSO_OIDC_CLIENT_ID=

# SSO_OIDC_CLIENT_SECRET=<dev-baile value>
SSO_OIDC_CLIENT_SECRET=

# SSO_OIDC_AUTHORITY=<dev-baile value>
SSO_OIDC_AUTHORITY=

# SSO_OIDC_SCOPES=<dev-baile value>
SSO_OIDC_SCOPES=

# SSO_OIDC_REDIRECT=<dev-baile value>
SSO_OIDC_REDIRECT=

# =============================================================================
# Infisical + Locket (canonical)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
