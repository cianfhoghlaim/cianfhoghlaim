# Locket-managed secrets for Tuatha — referenced by sidecar.yaml
#
# Format: {{ infisical:///<path>?environment=dev-baile }}
# Each value is resolved at container startup by the bons-locket-shim.
#
# Naming convention: <SERVICE>_<VARIABLE> (matches the compose.yaml env block)

# --- API server LLM keys ------------------------------------------------------
TUATH_OPENAI_API_KEY={{ infisical:///openai_api_key?environment=dev-baile }}
TUATH_ANTHROPIC_API_KEY={{ infisical:///anthropic_api_key?environment=dev-baile }}

# --- Langfuse observability ---------------------------------------------------
TUATH_LANGFUSE_PUBLIC_KEY={{ infisical:///langfuse_public_key?path=/tuatha }}
TUATH_LANGFUSE_SECRET_KEY={{ infisical:///langfuse_secret_key?path=/tuatha }}

# --- x402 in-game payments (optional, only if monetisation is enabled) -------
TUATH_X402_PAYMENT_URL={{ infisical:///x402_payment_url?path=/tuatha }}

# --- Internal signing key for SpacetimeDB JWT validation -----------------------
TUATH_JWT_SIGNING_KEY={{ infisical:///jwt_signing_key?path=/tuatha }}
