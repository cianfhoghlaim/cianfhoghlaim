# Locket-managed secrets for Tuatha — referenced by sidecar.yaml
#
# Format: infisical://dev-baile/tuatha/<path>
# Each value is resolved at container startup by the bons-locket-shim.
#
# Naming convention: <SERVICE>_<VARIABLE> (matches the compose.yaml env block)

# --- API server LLM keys ------------------------------------------------------
TUATH_OPENAI_API_KEY=infisical://dev-baile/tuatha/openai_api_key
TUATH_ANTHROPIC_API_KEY=infisical://dev-baile/tuatha/anthropic_api_key

# --- Langfuse observability ---------------------------------------------------
TUATH_LANGFUSE_PUBLIC_KEY=infisical://dev-baile/tuatha/langfuse_public_key
TUATH_LANGFUSE_SECRET_KEY=infisical://dev-baile/tuatha/langfuse_secret_key

# --- x402 in-game payments (optional, only if monetisation is enabled) -------
TUATH_X402_PAYMENT_URL=infisical://dev-baile/tuatha/x402_payment_url

# --- Internal signing key for SpacetimeDB JWT validation -----------------------
TUATH_JWT_SIGNING_KEY=infisical://dev-baile/tuatha/jwt_signing_key
