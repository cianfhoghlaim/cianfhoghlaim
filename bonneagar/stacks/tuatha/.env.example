# =============================================================================
# TUATHA - Local Development Environment
# =============================================================================
# Copy this file to .env.local and edit values as needed.
# For production, secrets come from Locket/Infisical via sidecar.yaml.
#
# Usage: cp .env.example .env.local
#
# The stack is split into a tuath-network (api + ui + game + spacetimedb +
# dragonfly + dagster + langfuse + lance-viewer + tileserver) and a
# bonneagar-network (external bridge to the Infisical + Locket + Pocket ID
# services on arm1-oci).
# =============================================================================

# =============================================================================
# Tuatha API / UI / Game
# =============================================================================
# Required for the LLM-driven in-game NPC (curator / tutor).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional x402 micro-payment endpoint (in-game currency / premium items)
X402_PAYMENT_URL=

# =============================================================================
# Langfuse observability stack (LLM tracing for the in-game tutor NPC)
# =============================================================================
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me-locally
LANGFUSE_SALT=change-me-locally

# =============================================================================
# Locket sidecar (production only — pod env via Komodo)
# =============================================================================
# Uncomment locally only if you want to test the Locket sidecar pattern.
# LOCKET_MODE=watch
# INFISICAL_CLIENT_ID=
# INFISICAL_PROJECT_ID=f3cff583-b74b-4804-b9d3-db8b68885236
# INFISICAL_SECRET_FILE=../../infisical_secret

# =============================================================================
# MapLibre / game rendering
# =============================================================================
MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json
