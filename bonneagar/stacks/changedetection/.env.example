# =============================================================================
# CHANGEDETECTION secrets (Locket resolves these at container runtime)
# =============================================================================

# CHANGEDETECTION_ADMIN_PASSWORD=<dev-baile value>
CHANGEDETECTION_ADMIN_PASSWORD=

# OIDC_CLIENT_ID=<dev-baile value>
OIDC_CLIENT_ID=

# OIDC_CLIENT_SECRET=<dev-baile value>
OIDC_CLIENT_SECRET=

# OIDC_ISSUER=<dev-baile value>
OIDC_ISSUER=

# OIDC_SCOPES=<dev-baile value>
OIDC_SCOPES=

# OIDC_REDIRECT_URL=<dev-baile value>
OIDC_REDIRECT_URL=

# DATABASE_URL=<dev-baile value>
DATABASE_URL=

# FALLBACK_DATABASE_URL=<dev-baile value>
FALLBACK_DATABASE_URL=

# =============================================================================
# Infisical + Locket (canonical)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
