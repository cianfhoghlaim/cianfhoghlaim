# =============================================================================
# GCP-GEMINI-VERTEX - Locket Secrets Template
# =============================================================================
# 2026-08-31: GCP mirror stack per the v5 model priority change.
# These infisical:// references are resolved by Locket at runtime.
# Vault: dev-baile. Project: GCP project ID hosting the Vertex AI client.
# Service account via Workload Identity Federation (no JSON key needed).

# Google Application Default Credentials — for Workload Identity Federation
GOOGLE_APPLICATION_CREDENTIALS_JSON={{ infisical:///google_application_credentials_json }}

# Vertex AI region + project
GOOGLE_CLOUD_PROJECT={{ infisical:///google_cloud_project }}
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# AI Studio fallback (only used when Vertex creds are missing)
GEMINI_API_KEY={{ infisical:///gemini_api_key }}