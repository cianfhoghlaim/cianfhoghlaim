# Local-dev defaults for gcp-gemini-vertex
# Per the v5 model priority change (2026-08-31).
# Production secrets are loaded by Locket via sidecar.yaml; these defaults
# are for local dev only.

COMPOSE_PROJECT_NAME=gcp-gemini-vertex

# Vertex AI defaults
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3.5-flash

# Locket
INFISICAL_CLIENT_ID=
INFISICAL_SECRET_FILE=../../infisical_secret
LOCKET_MODE=watch

# OTLP exporter (Stackdriver AI Agent ADK)
OTEL_SERVICE_NAME=gcp-gemini-vertex-client
OTEL_PYTHON_LOGGING_AUTO_INSTRUMENTATION_ENABLED=true
OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=EVENT_ONLY
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true