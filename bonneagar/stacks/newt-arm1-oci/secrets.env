# =============================================================================
# NEWT (arm1-oci) — Locket-secret references (Infisical dev-baile vault)
# =============================================================================
# Both secrets are resolved at runtime by the bons-locket-shim from the
# dev-baile vault at /pangolin/newt-arm1-oci/.
#
# The `infisical_secret` file is the machine identity used by Locket to
# authenticate to the Infisical REST API.
#
# These secrets are minted by:
#   bun run iac:bootstrap-pangolin-client --host=arm1-oci --type=machine
# (per the 2026-08-15-bonneagar-infra-remediation-v2 openspec change)
#
# UPDATED 2026-08-15: renamed from PANGOLIN_CLIENT_* to NEWT_* to match
# the existing convention (NEWT_ARM1_ID + NEWT_ARM1_SECRET in .env).
# =============================================================================

# Newt WireGuard tunnel credentials (machine client for arm1-oci)
NEWT_ARM1_ID={{ infisical:///NEWT_ARM1_ID }}
NEWT_ARM1_SECRET={{ infisical:///NEWT_ARM1_SECRET }}