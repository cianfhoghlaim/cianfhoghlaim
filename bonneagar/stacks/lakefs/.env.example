# =============================================================================
# LAKEFS - Environment Variable Catalogue
# =============================================================================
# Generated by scripts/generate-stack-env-example.ts on 2026-07-08T17:46:34.717Z
#
# Documents every ${VAR} reference in lakefs/compose.yaml.
#
# USAGE:
#   For local dev: cp .env.example .env, edit, then
#     docker compose -f compose.yaml -f sidecar.yaml up -d
#   For production: rely on Locket (no .env needed).
#
# The real values are stored in the dev-baile Infisical vault;
# the Locket sidecar injects them at container runtime.
# =============================================================================

# =============================================================================
# LAKEFS secrets (Locket resolves these at container runtime)
# =============================================================================

# LAKEFS_DB_USERNAME=<dev-baile value>
LAKEFS_DB_USERNAME=

# LAKEFS_DB_PASSWORD=<dev-baile value>
LAKEFS_DB_PASSWORD=

# LAKEFS_AUTH_ENCRYPT_SECRET_KEY=<dev-baile value>
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=

# MINIO_ROOT_USER=<dev-baile value>
MINIO_ROOT_USER=

# MINIO_ROOT_PASSWORD=<dev-baile value>
MINIO_ROOT_PASSWORD=

# =============================================================================
# Infisical + Locket (canonical)
# =============================================================================
INFISICAL_URL=http://infisical-backend:8080
# INFISICAL_CLIENT_ID=<machine identity>
# INFISICAL_SECRET_FILE=./infisical_secret
LOCKET_MODE=watch
