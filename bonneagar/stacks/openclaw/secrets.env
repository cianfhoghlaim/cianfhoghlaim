# =============================================================================
# OPENCLAW — Locket Secrets Template
# =============================================================================
# Resolved at runtime by Locket against the dev-baile Infisical project.
#
# INFISICAL ITEMS TO CREATE UNDER dev-baile/openclaw/ (10 total):
#   gateway_token              — admin API token (random 32-char hex)
#   openai_api_key             — LITELLM_MASTER_KEY (re-keyed at the Infisical layer)
#   telegram_bot_token         — Telegram BotFather bot token
#   slack_bot_token            — Slack bot OAuth token (xoxb-...)
#   slack_app_token            — Slack app-level token (xapp-...)
#   discord_bot_token          — Discord bot token
#   whatsapp_access_token      — WhatsApp Business API access token
#   whatsapp_phone_number_id   — WhatsApp Business phone-number ID
#   teams_bot_token            — Microsoft Teams bot token
#   otel_exporter_otlp_endpoint — Langfuse OTLP/HTTP endpoint
#
# Locket v0.17+ format (Infisical v0.161+ folder model):
#   The folder path is a query param, NOT part of the secret name.
#   See https://bons.ai/docs/locket/references/infisical for details.
# =============================================================================

# Gateway admin API token (used to call /api/pairing/* and /api/channels/*)
OPENCLAW_GATEWAY_TOKEN={{ infisical:///gateway_token?path=/openclaw }}

# LLM provider — LiteLLM chokepoint (M3 plan, the new minimax-coding-plan)
OPENAI_API_KEY={{ infisical:///openai_api_key?path=/openclaw }}
OPENAI_BASE_URL=http://litellm:4000/v1

# Channel credentials (resolved at startup; missing values just disable the channel)
TELEGRAM_BOT_TOKEN={{ infisical:///telegram_bot_token?path=/openclaw }}
SLACK_BOT_TOKEN={{ infisical:///slack_bot_token?path=/openclaw }}
SLACK_APP_TOKEN={{ infisical:///slack_app_token?path=/openclaw }}
DISCORD_BOT_TOKEN={{ infisical:///discord_bot_token?path=/openclaw }}
WHATSAPP_ACCESS_TOKEN={{ infisical:///whatsapp_access_token?path=/openclaw }}
WHATSAPP_PHONE_NUMBER_ID={{ infisical:///whatsapp_phone_number_id?path=/openclaw }}
TEAMS_BOT_TOKEN={{ infisical:///teams_bot_token?path=/openclaw }}

# Observability — Langfuse OTLP/HTTP
OTEL_EXPORTER_OTLP_ENDPOINT={{ infisical:///otel_exporter_otlp_endpoint?path=/openclaw }}