# =============================================================================
# OpenClaw — synthetic Dockerfile (matches the upstream openclaw/openclaw
# image shape: Node 24 + Bun 1.3.13, builds the openclaw.mjs gateway)
# =============================================================================
# Build:
#   docker buildx build --platform linux/arm64 \
#     -t openclaw:local-2026.6 -f Dockerfile.openclaw .
#
# Build context must include the openclaw source tree under `app/`:
#   app/
#     package.json
#     bun.lock
#     openclaw.mjs
#     server/
#     lib/
#     packages/
#     extensions/  (optional)
#
# Output: ghcr.io/cianfhoghlaim/openclaw:2026.6-arm1
# =============================================================================

# Stage 1: install + build (Bun)
FROM oven/bun:1.3.13 AS builder

WORKDIR /app

# Copy package manifests first for layer caching
COPY app/package.json app/bun.lock* ./
RUN bun install --frozen-lockfile

# Copy the rest of the source
COPY app/ ./
RUN bun run build:prod 2>/dev/null || bun build ./openclaw.mjs --target=bun --outdir=/app/dist 2>/dev/null || true

# Stage 2: minimal runtime (Node 24 + tini for signal handling)
FROM node:24-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates tini && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -r -u 1000 -g 1000 -m -d /home/node -s /bin/bash openclaw 2>/dev/null || true

USER 1000:1000
ENV HOME=/home/node
ENV OPENCLAW_STATE_DIR=/home/node/.openclaw/state
ENV OPENCLAW_CONFIG=/home/node/.openclaw/config/openclaw.json
ENV PATH=/home/node/.openclaw/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /home/node/.openclaw

COPY --from=builder --chown=1000:1000 /app/ /home/node/.openclaw/

# Pre-create state dir for openclaw to write
RUN mkdir -p /home/node/.openclaw/state /home/node/.openclaw/config && \
    chown -R 1000:1000 /home/node/.openclaw

ENV OPENCLAW_PORT=18789
ENV OPENCLAW_BRIDGE_PORT=18790
ENV OPENCLAW_LOG_LEVEL=info
ENV OPENCLAW_DM_POLICY=pairing
ENV NODE_ENV=production

EXPOSE 18789 18790

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=30s \
    CMD node -e "fetch('http://127.0.0.1:18789/healthz').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["tini", "-s", "--"]
CMD ["node", "openclaw.mjs", "gateway"]
