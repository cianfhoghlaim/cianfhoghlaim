{
  "name": "@bonneagar/iac",
  "version": "0.3.0",
  "module": "./cli.ts",
  "type": "module",
  "private": true,
  "description": "The IaC sub-package for bonneagar — the Komodo + Pangolin + Infisical TypeScript orchestrator. Replaces the 5 v0 iac/komodo/*.ts scripts + the 3 bash scripts at scripts/ + the 2 vault scripts at the repo root. Boots a fresh arm1-oci + bunchloch topology from empty via `bun run iac:bootstrap`.",
  "bin": {
    "bonsai": "./cli.ts"
  },
  "scripts": {
    "bootstrap": "bun run cli.ts bootstrap",
    "bootstrap-pocketid-admin": "bun run cli.ts bootstrap-pocketid-admin",
    "bootstrap-pangolin-client": "bun run cli.ts bootstrap-pangolin-client",
    "bootstrap-infisical": "bun run cli.ts bootstrap-infisical",
    "bootstrap-locket-binary": "bun run cli.ts bootstrap-locket-binary",
    "bootstrap-control-plane": "bun run cli.ts bootstrap-control-plane",
    "bootstrap-control-plane-bunchloch": "bun run cli.ts bootstrap-control-plane --target=bunchloch",
    "bootstrap-control-plane-arm1-oci": "bun run cli.ts bootstrap-control-plane --target=arm1-oci",
    "wire-pocketid-as-oidc": "bun run cli.ts wire-pocketid-as-oidc",
    "deploy-periphery": "bun run cli.ts deploy-periphery",
    "deploy-newt": "bun run cli.ts deploy-newt",
    "plan": "bun run cli.ts plan",
    "deploy": "bun run cli.ts deploy",
    "health": "bun run cli.ts health",
    "rotate-auth": "bun run cli.ts rotate-auth",
    "teardown": "bun run cli.ts teardown --force",
    "teardown-stack": "bun run cli.ts teardown-stack ${@:-}",
    "sync:secrets": "bun run cli.ts sync:secrets",
    "sync:resources": "bun run cli.ts sync:resources",
    "sync:procedures": "bun run cli.ts sync:procedures",
    "sync:resource-syncs": "bun run cli.ts sync:resource-syncs",
    "sync:clients": "bun run cli.ts sync:clients"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@infisical/sdk": "^5.0.2",
    "komodo_client": "^2.1.1"
  }
}
