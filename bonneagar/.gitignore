# =============================================================================
# bonneagar/ submodule .gitignore — secret-template files
# =============================================================================
# Per the v5 drift refactor (see openspec/changes/archive/2026-07-07-finalize-v4-landing/absorbed/2026-07-01-bonneagar-v5-drift-refactor-and-komodo-gitops/tasks.md
# Phase 6 "deployment"), the following secret-template files MUST NOT be committed.
# The parent .gitignore has the full per-path list; this is the per-submodule
# fallback for when the submodule is used standalone (e.g. as github.com/cianfhoghlaim/bonneagar).

# All stack secrets.env files are reference templates; the actual
# secrets live in Infisical and are injected by Locket at runtime.
# We commit them so the IaC can discover them, but we ignore any
# resolved .env files (the runtime hydrated output).
.env
.env.local
.env.*.local
**/.env
**/.env.local
**/.env.*.local
!.env.example
!.env.template

# 1Password credentials (never commit)
op_token
connect_token
1password-credentials.json
.env.op

# SSH keys
*.pem
*.key
id_*
!id_*.pub

# Stack runtime data (regenerated by compose)
/stacks/*/data/
/stacks/*/logs/

# Komodo auto-backup snapshots
/komodo/backups/

# Pangolin plaintext/regenerated files (Phase 0 of the v5 drift refactor)
/pangolin/api_key
/pangolin/secrets.env
/pangolin/secrets.env.resolved
/pangolin/config/infisical_secret
/pangolin/config/db/db.sqlite
/pangolin/config/openapi.yaml
/pangolin/config/tinyauth/users
/pangolin/config/secrets/templates/
/pangolin/config/traefik/rules/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
*.orig
*.tmp

# Node
node_modules/
.bun/
*.tsbuildinfo
.turbo/

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.mypy_cache/

# Dagger
.dagger/

# DLT / Data
.dlt/secrets.toml
*.duckdb
*.duckdb.wal
.dagster/
