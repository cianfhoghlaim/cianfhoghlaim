      "id": "pendle_mainnet_subgraph",
      "name": "Pendle — PT/YT markets subgraph (mainnet)",
      "category": ["pendle", "fixed_yield", "floating_yield"],
      "resource_type": "graphql",
      "url": "The Graph (Pendle mainnet subgraph; discover via explorer/docs)",
      "access": {
        "method": "POST",
        "query_template": "markets{ id maturity underlying{ symbol } pt{ price } }",
        "notes": "Compute PT implied fixed APY = (redeemValue/ptPrice - 1) / time_to_maturity."
      },
      "parser": {
        "format": "graphql_json",
        "transform": [
          {"op": "calc", "field": "implied_fixed_apy", "expr": "(1/pt_price - 1)/(days_to_maturity/365)"},
          {"op": "set", "fields": {"metric": "PT_implied_APY", "units": "percent"}}
        ]
      },
      "fields_emitted": ["timestamp", "asset", "metric", "value", "units", "protocol", "maturity"],
      "cadence": {"backfill": "available history", "incremental": "30m"},
      "primary_keys": ["timestamp", "asset", "maturity", "metric", "protocol"]
    },
