      "id": "aave_v3_mainnet_subgraph",
      "name": "Aave v3 — mainnet subgraph (reserves & rates)",
      "category": ["aave", "rates", "utilization"],
      "resource_type": "graphql",
      "url": "The Graph (discover current deployment via explorer: 'Aave v3 mainnet')",
      "access": {
        "method": "POST",
        "query_template": "reserves{ symbol liquidityRate variableBorrowRate totalATokenSupply totalCurrentVariableDebt }",
        "notes": "Store subgraph deployment ID and refresh periodically."
      },
      "parser": {
        "format": "graphql_json",
        "transform": [
          {"op": "map_fields", "mapping": {
            "supplyAPR": "liquidityRate/1e27",
            "borrowAPR": "variableBorrowRate/1e27",
            "totalSupply": "totalATokenSupply",
            "totalBorrow": "totalCurrentVariableDebt"
          }},
          {"op": "calc", "field": "utilization_pct", "expr": "totalBorrow/totalSupply"},
          {"op": "emit_multi", "metrics": ["supplyAPR","borrowAPR","utilization_pct"], "units": {"supplyAPR":"decimal","borrowAPR":"decimal","utilization_pct":"ratio"}}
        ]
      },
      "fields_emitted": ["timestamp", "asset", "metric", "value", "units", "protocol", "chain"],
      "cadence": {"backfill": "query historical snapshots if available", "incremental": "5m"},
      "primary_keys": ["timestamp", "asset", "metric", "protocol", "chain"]
