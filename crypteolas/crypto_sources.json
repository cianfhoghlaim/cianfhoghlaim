      "url": "https://api.coingecko.com/api/v3/coins/ethena-usde/market_chart",
      "access": {
        "method": "GET",
        "params": {"vs_currency": "usd", "days": "max"},
        "rate_limit_notes": "Free tier; aggregate rate limits apply."
      },
      "parser": {
        "format": "json",
        "json_paths": {"prices": "$.prices[*]"},
        "transform": [
          {"op": "explode", "field": "prices", "to": "rows"},
          {"op": "map", "from": "rows", "to_fields": {"timestamp": "[0]", "value": "[1]"}},
          {"op": "to_datetime", "field": "timestamp", "unit": "ms"},
          {"op": "set", "fields": {"metric": "price", "asset": "USDe", "protocol": "Ethena", "units": "USD"}}
        ]
      },
      "fields_emitted": ["timestamp", "source", "protocol", "asset", "metric", "value", "units"],
      "cadence": {"backfill": "once", "incremental": "5m"},
      "primary_keys": ["timestamp", "asset", "metric", "source"]
