{
  "version": "2.0",
  "generated_at": "2025-12-11",
  "description": "Registry of sources to index metrics and documents for Ethena, Aave, Ethereum yield and related components (funding, staking, Pendle, events). Includes knowledge graph schema definitions for entity extraction and relationship mapping. Respect each site's ToS and robots.txt.",
  "global_schema": {
    "fields_common": [
      "timestamp",
      "source",
      "category",
      "chain",
      "protocol",
      "asset",
      "metric",
      "value",
      "units",
      "notes"
    ],
    "primary_keys": ["timestamp", "source", "protocol", "asset", "metric"],
    "quality_fields": ["confidence", "provenance_url"],
    "derived_metrics_examples": [
      "net_carry_spread = sUSDe_APY - Aave_borrow_APR(stablecoin)",
      "fixed_vs_float_spread = Pendle_PT_implied_APY - sUSDe_APY",
      "peg_deviation = abs(USDe_price - 1.00)",
      "utilization_pct = totalBorrowed / totalSupply"
    ]
  },
  "knowledge_graph_schema": {
    "description": "Entity and relationship definitions for building crypto knowledge graphs with Graphiti (temporal) and Cognee (static)",
    "entity_types": {
      "Token": {
        "properties": {
          "symbol": {"type": "string", "required": true},
          "name": {"type": "string", "required": true},
          "contract_address": {"type": "string"},
          "blockchain": {"type": "enum", "values": ["Ethereum", "Solana", "Polygon", "Arbitrum", "Base", "Bitcoin"]},
          "decimals": {"type": "integer"},
          "total_supply": {"type": "decimal"},
          "token_type": {"type": "enum", "values": ["native", "erc20", "stablecoin", "governance", "wrapped", "lp_token"]}
        },
        "temporal_properties": ["price_usd", "market_cap", "holder_count", "daily_volume"],
        "source_mapping": ["coingecko_*", "defillama_*"]
      },
      "Protocol": {
        "properties": {
          "name": {"type": "string", "required": true},
          "category": {"type": "enum", "values": ["defi", "lending", "dex", "derivatives", "stablecoin", "bridge", "oracle"]},
          "chains": {"type": "array", "items": "Blockchain"},
          "governance_token": {"type": "reference", "to": "Token"},
          "website": {"type": "url"},
          "documentation_url": {"type": "url"}
        },
        "temporal_properties": ["tvl_usd", "daily_active_users", "daily_transactions", "revenue_24h"],
        "source_mapping": ["defillama_protocol_*", "*_subgraph"]
      },
      "Exchange": {
        "properties": {
          "name": {"type": "string", "required": true},
          "type": {"type": "enum", "values": ["cex", "dex", "aggregator"]},
          "chains": {"type": "array", "items": "Blockchain"}
        },
        "temporal_properties": ["daily_volume_usd", "open_interest_usd", "listed_pairs"],
        "source_mapping": ["binance_*", "bybit_*", "okx_*"]
      },
      "LiquidityPool": {
        "properties": {
          "address": {"type": "string", "required": true},
          "protocol": {"type": "reference", "to": "Protocol"},
          "tokens": {"type": "array", "items": "Token"},
          "fee_tier": {"type": "decimal"},
          "pool_type": {"type": "enum", "values": ["constant_product", "stable", "concentrated", "weighted"]}
        },
        "temporal_properties": ["tvl_usd", "volume_24h", "fees_24h", "apy"],
        "source_mapping": ["aave_v3_*_subgraph", "pendle_*_subgraph", "defillama_yields_*"]
      },
      "Document": {
        "properties": {
          "title": {"type": "string", "required": true},
          "doc_type": {"type": "enum", "values": ["whitepaper", "audit", "research", "governance_proposal", "risk_report"]},
          "url": {"type": "url"},
          "published_date": {"type": "datetime"},
          "protocol": {"type": "reference", "to": "Protocol"}
        },
        "content_fields": ["sections", "extracted_entities", "risk_factors"],
        "source_mapping": ["*_pdf", "*_docs_*"]
      },
      "Risk": {
        "properties": {
          "category": {"type": "enum", "values": ["smart_contract", "market", "regulatory", "custody", "oracle", "governance", "economic"]},
          "severity": {"type": "enum", "values": ["critical", "high", "medium", "low"]},
          "title": {"type": "string", "required": true},
          "description": {"type": "string"},
          "mitigation": {"type": "string"}
        },
        "source_mapping": ["*_audit*", "*_risk*", "chaoslabs_*"]
      },
      "MarketEvent": {
        "properties": {
          "event_type": {"type": "enum", "values": ["depeg", "exploit", "governance", "listing", "delisting", "regulatory"]},
          "title": {"type": "string", "required": true},
          "description": {"type": "string"},
          "impact": {"type": "string"},
          "affected_protocols": {"type": "array", "items": "Protocol"}
        },
        "temporal": true,
        "source_mapping": ["*_event_*", "coindesk_*", "bloomberg_*"]
      }
    },
    "relationship_types": {
      "DEPLOYED_ON": {
        "from": "Token",
        "to": "Blockchain",
        "properties": ["deploy_block", "deploy_tx", "deploy_date"]
      },
      "TRADES_ON": {
        "from": "Token",
        "to": "Exchange",
        "properties": ["listing_date", "trading_pair", "volume_24h"]
      },
      "GOVERNANCE_FOR": {
        "from": "Token",
        "to": "Protocol",
        "properties": ["voting_power_formula"]
      },
      "WRAPPED_AS": {
        "from": "Token",
        "to": "Token",
        "properties": ["wrapper_contract", "bridge_protocol"]
      },
      "IN_POOL": {
        "from": "Token",
        "to": "LiquidityPool",
        "properties": ["weight", "reserve_amount"]
      },
      "HOSTED_ON": {
        "from": "LiquidityPool",
        "to": "Exchange",
        "properties": []
      },
      "INTEGRATES": {
        "from": "Protocol",
        "to": "Protocol",
        "properties": ["integration_type", "dependency_level"]
      },
      "AUDITED_BY": {
        "from": "Protocol",
        "to": "Document",
        "properties": ["audit_date", "scope"]
      },
      "DESCRIBES": {
        "from": "Document",
        "to": "Protocol",
        "properties": ["coverage_depth"]
      },
      "IDENTIFIES_RISK": {
        "from": "Document",
        "to": "Risk",
        "properties": ["finding_id", "page"]
      },
      "AFFECTS": {
        "from": "MarketEvent",
        "to": "Protocol",
        "properties": ["impact_severity", "duration"]
      },
      "HAS_TVL": {
        "from": "Protocol",
        "to": "TVLSnapshot",
        "properties": [],
        "temporal": true
      }
    },
    "graph_backends": {
      "temporal_memory": {
        "engine": "FalkorDB",
        "port": 6379,
        "purpose": "Agent memory, real-time events, session context",
        "integration": "Graphiti"
      },
      "static_knowledge": {
        "engine": "Memgraph",
        "port": 7687,
        "purpose": "Protocol knowledge, document insights, MAGE algorithms",
        "integration": "Cognee"
      },
      "vector_store": {
        "engine": "LanceDB",
        "port": 8080,
        "purpose": "Semantic embeddings for hybrid search",
        "integration": "Cognee"
      }
    }
  },
  "source_to_entity_mapping": {
    "coingecko_*": ["Token"],
    "defillama_protocol_*": ["Protocol"],
    "defillama_yields_*": ["LiquidityPool"],
    "defillama_stablecoin_*": ["Token"],
    "binance_*": ["Exchange", "Token"],
    "bybit_*": ["Exchange"],
    "okx_*": ["Exchange"],
    "aave_v3_*_subgraph": ["Protocol", "LiquidityPool"],
    "pendle_*_subgraph": ["Protocol", "LiquidityPool"],
    "*_pdf": ["Document"],
    "*_audit*": ["Document", "Risk"],
    "coindesk_*": ["MarketEvent"],
    "bloomberg_*": ["MarketEvent"]
  },
