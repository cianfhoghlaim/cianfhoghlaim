# GitHub API Configuration
GITHUB_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Configuration (for Cognee and entity extraction)
LLM_API_KEY=sk-your-openai-api-key
LLM_MODEL=openai/gpt-4o-mini
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-large

# Memgraph Configuration
GRAPH_DATABASE_PROVIDER=memgraph
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=
GRAPH_DATABASE_PASSWORD=

# CocoIndex Database (internal metadata)
COCOINDEX_DATABASE_URL=postgres://cocoindex:cocoindex@localhost/cocoindex

# LanceDB Configuration
LANCEDB_URI=./data/github_intelligence.lancedb

# DuckDB Configuration
DUCKDB_PATH=./data/github_intelligence.duckdb

# Optional: Motherduck for cloud deployment
MOTHERDUCK_TOKEN=your-motherduck-token
