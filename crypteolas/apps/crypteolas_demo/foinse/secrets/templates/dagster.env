# ==============================================================================
# CRYPTEOLAS SECRETS TEMPLATE
# ==============================================================================
# Processed by Locket to inject secrets from 1Password Connect
# Vault: dev-baile/crypteolas
#
# Syntax: {{ op://vault/item/field }}
# ==============================================================================

# ==============================================================================
# LLM PROVIDERS
# ==============================================================================
OPENAI_API_KEY={{ op://dev-baile/crypteolas/openai/api_key }}
ANTHROPIC_API_KEY={{ op://dev-baile/crypteolas/anthropic/api_key }}
GOOGLE_API_KEY={{ op://dev-baile/crypteolas/google_ai/api_key }}
GROQ_API_KEY={{ op://dev-baile/crypteolas/groq/api_key }}

# ==============================================================================
# DATABASE CREDENTIALS
# ==============================================================================
# PostgreSQL (Control Plane / BetterAuth)
POSTGRES_PASSWORD={{ op://dev-baile/crypteolas/postgresql/password }}

# Dagster PostgreSQL
DAGSTER_POSTGRES_PASSWORD={{ op://dev-baile/crypteolas/dagster_postgresql/password }}

# FalkorDB (Dynamic Graph Memory)
FALKORDB_PASSWORD={{ op://dev-baile/crypteolas/falkordb/password }}

# Memgraph (Static Knowledge Graph)
MEMGRAPH_PASSWORD={{ op://dev-baile/crypteolas/memgraph/password }}

# ==============================================================================
# CLOUDFLARE (R2 / Workers)
# ==============================================================================
# Cloudflare Account
CLOUDFLARE_ACCOUNT_ID={{ op://dev-baile/crypteolas/cloudflare/account_id }}
CLOUDFLARE_API_TOKEN={{ op://dev-baile/crypteolas/cloudflare/api_token }}

# R2 Storage (S3-compatible)
AWS_ACCESS_KEY_ID={{ op://dev-baile/crypteolas/cloudflare_r2/access_key_id }}
AWS_SECRET_ACCESS_KEY={{ op://dev-baile/crypteolas/cloudflare_r2/secret_access_key }}

# ==============================================================================
# DATA SOURCE APIs
# ==============================================================================
# CoinGecko (price data)
COINGECKO_API_KEY={{ op://dev-baile/crypteolas/coingecko/api_key }}

# Etherscan (on-chain data)
ETHERSCAN_API_KEY={{ op://dev-baile/crypteolas/etherscan/api_key }}

# Firecrawl (documentation scraping)
FIRECRAWL_API_KEY={{ op://dev-baile/crypteolas/firecrawl/api_key }}

# Crawl4AI (document scraping alternative)
CRAWL4AI_API_TOKEN={{ op://dev-baile/crypteolas/crawl4ai/api_token }}

# ==============================================================================
# AUTHENTICATION (BetterAuth / SIWE)
# ==============================================================================
BETTER_AUTH_SECRET={{ op://dev-baile/crypteolas/better_auth/secret }}
AUTH_SECRET={{ op://dev-baile/crypteolas/better_auth/secret }}

# GitHub OAuth (optional)
GITHUB_CLIENT_ID={{ op://dev-baile/crypteolas/github_oauth/client_id }}
GITHUB_CLIENT_SECRET={{ op://dev-baile/crypteolas/github_oauth/client_secret }}

# ==============================================================================
# WEB3 / BLOCKCHAIN
# ==============================================================================
# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID={{ op://dev-baile/crypteolas/walletconnect/project_id }}

# ==============================================================================
# X402 PAYMENT PROTOCOL
# ==============================================================================
# Payment recipient wallet address
PAYMENT_RECIPIENT={{ op://dev-baile/crypteolas/payment_wallet/address }}
NEXT_PUBLIC_PAYMENT_RECIPIENT={{ op://dev-baile/crypteolas/payment_wallet/address }}
